@using System.Web;
@{
    var gpCacheVersion = "20260603-tajrish-v36-about-local-video-optimized";
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpCanonicalUrl = gpBaseUrl + Request.Path;

    ViewBag.Title = "درباره ما | کلینیک شنوایی و سمعک شکوه تجریش";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Metas{
