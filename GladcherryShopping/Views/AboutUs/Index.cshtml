    <style id="gp-v32-about-modern-seo">
        :root {
            --gp-v32-purple: #4b1684;
            --gp-v32-violet: #920ab6;
            --gp-v32-pink: #e10b79;
            --gp-v32-cyan: #0ba6b8;
            --gp-v32-lime: #d8f512;
            --gp-v32-ink: #20142d;
            --gp-v32-muted: rgba(32,20,45,.68);
            --gp-v32-card: rgba(255,255,255,.92);
            --gp-v32-border: rgba(75,22,132,.10);
            --gp-v32-shadow: 0 24px 60px rgba(74,18,107,.10);
        }

        .gp-about-page {
            direction: rtl;
            overflow: hidden;
        }

        .gp-about-hero {
            position: relative;
            margin: 22px auto 28px;
            padding: clamp(28px, 4vw, 58px);
            border-radius: 42px;
            background:
                radial-gradient(circle at 14% 10%, rgba(216,245,18,.25), transparent 24%),
                radial-gradient(circle at 88% 24%, rgba(255,255,255,.15), transparent 22%),
                linear-gradient(135deg, #4b1684 0%, #920ab6 54%, #e10b79 100%);
            color: #fff;
            box-shadow: 0 32px 80px rgba(74,18,107,.20);
            isolation: isolate;
            overflow: hidden;
        }

        .gp-about-hero::before,
        .gp-about-hero::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            pointer-events: none;
            z-index: -1;
        }

        .gp-about-hero::before {
            width: 270px;
            height: 270px;
            left: -96px;
            top: -92px;
            background: rgba(255,255,255,.13);
            animation: gpV32Blob 10s ease-in-out infinite alternate;
        }

        .gp-about-hero::after {
            width: 340px;
            height: 340px;
            right: -130px;
            bottom: -172px;
            background: rgba(11,166,184,.22);
            animation: gpV32Blob 12s ease-in-out infinite alternate-reverse;
        }

        @@keyframes gpV32Blob {
            to { transform: translate3d(24px, 18px, 0) scale(1.06); }
        }

        .gp-about-hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(260px, .38fr);
            gap: clamp(20px, 4vw, 46px);
            align-items: center;
        }

        .gp-about-kicker {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            color: #fff !important;
            font-weight: 950;
            backdrop-filter: blur(14px);
        }

        .gp-about-hero h1 {
            margin: 16px 0 12px;
            color: #fff !important;
            font-size: clamp(32px, 5vw, 66px);
            font-weight: 1000;
            line-height: 1.34 !important;
            letter-spacing: -.02em;
        }

        .gp-about-hero p {
            max-width: 780px;
            margin: 0;
            color: rgba(255,255,255,.90) !important;
            font-size: clamp(14px, 1.2vw, 18px);
            font-weight: 850;
            line-height: 2.1;
            text-align: right !important;
        }

        .gp-about-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 24px;
        }

        .gp-about-actions a {
            min-height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 18px;
            border-radius: 999px;
            text-decoration: none !important;
            font-weight: 950;
        }

        .gp-about-actions a:first-child {
            background: #fff;
            color: #4b1684 !important;
            box-shadow: 0 18px 38px rgba(0,0,0,.14);
        }

        .gp-about-actions a:nth-child(2) {
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.24);
            color: #fff !important;
        }

        .gp-about-stats {
            display: grid;
            gap: 12px;
        }

        .gp-about-stat {
            min-height: 92px;
            padding: 18px;
            border-radius: 28px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            backdrop-filter: blur(14px);
        }

        .gp-about-stat strong {
            display: block;
            color: #fff !important;
            font-size: 28px;
            font-weight: 1000;
            line-height: 1;
        }

        .gp-about-stat span {
            display: block;
            margin-top: 8px;
            color: rgba(255,255,255,.82) !important;
            font-weight: 850;
        }

        .gp-about-story-card,
        .gp-about-video-card,
        .gp-about-values-card {
            border-radius: 34px;
            background: var(--gp-v32-card);
            border: 1px solid var(--gp-v32-border);
            box-shadow: var(--gp-v32-shadow);
            backdrop-filter: blur(18px);
        }

        .gp-about-story-card {
            padding: clamp(20px, 3vw, 38px);
            margin-bottom: 24px;
        }

        .gp-about-section-head {
            max-width: 780px;
            margin: 0 auto 22px;
            text-align: center;
        }

        .gp-about-section-head span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 0 13px;
            border-radius: 999px;
            background: rgba(146,10,182,.08);
            color: #6420a0 !important;
            font-size: 13px;
            font-weight: 950;
        }

        .gp-about-section-head h2 {
            margin: 12px 0 8px;
            color: var(--gp-v32-ink) !important;
            font-size: clamp(24px, 3.2vw, 44px);
            font-weight: 1000;
            line-height: 1.45 !important;
        }

        .gp-about-section-head p {
            margin: 0;
            color: var(--gp-v32-muted) !important;
            font-weight: 850;
            line-height: 2;
            text-align: center !important;
        }

        .gp-about-story-text {
            max-width: 980px;
            margin: 0 auto;
            color: var(--gp-v32-muted) !important;
            font-size: 16px;
            font-weight: 750;
            line-height: 2.35;
            text-align: justify !important;
        }

        .gp-about-story-text p {
            color: var(--gp-v32-muted) !important;
            text-align: justify !important;
            line-height: 2.35 !important;
        }


        .gp-about-clinic-gallery {
            margin: 0 0 26px;
            padding: clamp(18px, 2.6vw, 30px);
            border-radius: 34px;
            background:
                radial-gradient(circle at 12% 12%, rgba(216,245,18,.13), transparent 24%),
                linear-gradient(135deg, rgba(255,255,255,.94), rgba(252,248,255,.82));
            border: 1px solid var(--gp-v32-border);
            box-shadow: var(--gp-v32-shadow);
            backdrop-filter: blur(18px);
        }

        .gp-about-gallery-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
            align-items: stretch;
        }

        .gp-about-gallery-card {
            position: relative;
            min-height: 430px;
            border-radius: 30px;
            overflow: hidden;
            background: #fff;
            border: 1px solid rgba(75,22,132,.08);
            box-shadow: 0 18px 42px rgba(74,18,107,.08);
            isolation: isolate;
            transition: transform .24s ease, box-shadow .24s ease;
        }

        .gp-about-gallery-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 30px 70px rgba(74,18,107,.15);
        }

        .gp-about-gallery-card img {
            width: 100%;
            height: 100%;
            min-height: 430px;
            object-fit: cover;
            display: block;
            transition: transform .35s ease, filter .35s ease;
        }

        .gp-about-gallery-card:hover img {
            transform: scale(1.045);
            filter: saturate(1.06);
        }

        .gp-about-gallery-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 36%, rgba(18,12,30,.78));
            z-index: 1;
        }

        .gp-about-gallery-caption {
            position: absolute;
            right: 18px;
            left: 18px;
            bottom: 18px;
            z-index: 2;
            padding: 16px;
            border-radius: 24px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.22);
            backdrop-filter: blur(14px);
            color: #fff;
        }

        .gp-about-gallery-caption span {
            display: inline-flex;
            min-height: 28px;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            margin-bottom: 8px;
            border-radius: 999px;
            background: rgba(216,245,18,.88);
            color: #20142d !important;
            font-size: 12px;
            font-weight: 1000;
        }

        .gp-about-gallery-caption h3 {
            margin: 0 0 6px;
            color: #fff !important;
            font-size: 20px;
            font-weight: 1000;
            line-height: 1.7 !important;
        }

        .gp-about-gallery-caption p {
            margin: 0;
            color: rgba(255,255,255,.86) !important;
            font-size: 13px;
            font-weight: 850;
            line-height: 2;
            text-align: right !important;
        }

        html.gp-dark-mode .gp-about-clinic-gallery {
            background: rgba(24,24,40,.90) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

        html.gp-dark-mode .gp-about-gallery-card {
            background: rgba(255,255,255,.07) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

        @@media(max-width: 991px) {
            .gp-about-gallery-card,
            .gp-about-gallery-card img {
                min-height: 360px;
            }
        }

        @@media(max-width: 768px) {
            .gp-about-clinic-gallery {
                border-radius: 28px;
                padding: 14px;
            }

            .gp-about-gallery-grid {
                grid-template-columns: 1fr;
            }

            .gp-about-gallery-card,
            .gp-about-gallery-card img {
                min-height: 340px;
                border-radius: 26px;
            }

            .gp-about-gallery-caption {
                right: 12px;
                left: 12px;
                bottom: 12px;
                padding: 14px;
                border-radius: 22px;
            }
        }



        /* V34: clinic folder gallery */
        .gp-about-clinic-gallery {
            position: relative;
            overflow: hidden;
        }

        .gp-about-clinic-gallery::before {
            content: "";
            position: absolute;
