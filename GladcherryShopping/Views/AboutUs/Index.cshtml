    <link rel="canonical" href="@gpCanonicalUrl" />
    <meta name="Keywords" content="درباره کلینیک شنوایی شکوه تجریش، کلینیک سمعک تجریش، تست شنوایی، تجویز سمعک، تنظیم سمعک، ادیولوژیست تجریش" />

    <meta property="og:title" content="درباره ما | کلینیک شنوایی و سمعک شکوه تجریش" />
    <meta property="og:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@gpCanonicalUrl" />
    <meta property="og:description" content="آشنایی با مسیر، ارزش‌ها و خدمات کلینیک شنوایی و سمعک شکوه تجریش." />

    <meta name="twitter:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta name="twitter:description" content="درباره کلینیک شنوایی و سمعک شکوه تجریش؛ دقت، احترام و مشاوره تخصصی در مسیر انتخاب سمعک." />
}

@section Styles{
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "صفحه اصلی",
              "item": "https://tajrish-samak.ir/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "درباره ما",
              "item": "@gpCanonicalUrl"
            }
          ]
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "AboutPage",
          "name": "درباره کلینیک شنوایی و سمعک شکوه تجریش",
          "url": "@gpCanonicalUrl",
          "description": "آشنایی با کلینیک شنوایی و سمعک شکوه تجریش، مسیر شکل‌گیری مرکز و ارزش‌های اصلی آن در ارائه خدمات شنوایی و سمعک.",
          "inLanguage": "fa-IR",
          "mainEntity": {
            "@@type": "MedicalBusiness",
            "name": "کلینیک شنوایی و سمعک شکوه تجریش",
            "url": "https://tajrish-samak.ir/",
            "logo": "https://tajrish-samak.ir/images/logo_purple.webp",
            "image": "https://tajrish-samak.ir/images/logo_purple.webp",
            "telephone": "+982122735588",
            "address": {
              "@@type": "PostalAddress",
              "addressCountry": "IR",
              "addressRegion": "تهران",
              "addressLocality": "تجریش",
              "streetAddress": "میدان تجریش، خیابان شهرداری، روبه‌روی سینما آستارا، پلاک ۲۲۴، ساختمان ۱۱۰"
            },
            "sameAs": [
              "https://www.instagram.com/tajrishsamak/",
              "https://www.telegram.me/tajrish_samak/"
            ]
          }
        }
