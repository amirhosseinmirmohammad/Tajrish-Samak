                    <div class="gp-related-list">
                        <a class="gp-related-service" href="/niavaran/hearing-test" title="تست شنوایی نیاوران">
                            <img src="@Url.Content("~/images/logo_purple.webp")" alt="تست شنوایی نیاوران" title="تست شنوایی نیاوران" loading="lazy" decoding="async" />
                            <span>
                                <strong>تست شنوایی نیاوران</strong>
                                <span>نزدیک تجریش و شمیرانات</span>
                            </span>
                        </a>
                        <a class="gp-related-service" href="/qeytarieh/hearing-test" title="تست شنوایی قیطریه">
                            <img src="@Url.Content("~/images/logo_purple.webp")" alt="تست شنوایی قیطریه" title="تست شنوایی قیطریه" loading="lazy" decoding="async" />
                            <span>
                                <strong>تست شنوایی قیطریه</strong>
                                <span>ارزیابی شنوایی شمال تهران</span>
                            </span>
                        </a>
                    </div>
                </div>

                <div class="gp-service-side-card gp-service-toc-card" id="gpServiceTocCard">
                    <h3>فهرست سریع</h3>
                    <div class="gp-service-toc-list" id="gpServiceTocList"></div>
                </div>

                <div class="gp-service-side-card">
                    <h3>عضویت در خبرنامه</h3>
                    <p>تازه‌ترین مطالب و نکات شنوایی را دریافت کنید.</p>
                    <form class="gp-newsletter-form gp-newsletter-form-v31" action="javascript:void(0);" method="post" novalidate>
                        <input id="gpNewsEmail" class="gp-news-email-v31" name="email" type="email" placeholder="ایمیل معتبر" autocomplete="email" required />
                        <button id="gpNewsSubmit" class="gp-news-submit-v31" type="button">
                            ثبت
                        </button>
                    </form>
                    <div class="text-center gp-newsletter-message-wrap-v45">
                        <h6 class="newsletter gp-news-msg-v31 gp-newsletter-message-v45"><i id="gpNewsMsg"></i></h6>
                    </div>
                </div>

                @if (gpRelatedServices.Count() > 0)
                {
                    <div class="gp-service-side-card">
                        <h3>خدمات مرتبط</h3>
                        <div class="gp-related-list">
                            @foreach (var item in gpRelatedServices)
                            {
                                var relatedImage = item.Images != null && item.Images.FirstOrDefault() != null
                                    ? item.Images.FirstOrDefault().FullPath
                                    : Url.Content("~/images/logo_purple.webp");

                                <a class="gp-related-service" title="@item.Title" href="/service/@item.Id/@item.SefUrl">
                                    <img src="@relatedImage" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" />
                                    <span>
                                        <strong>@item.Title</strong>
                                        <span>بررسی خدمت</span>
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                }

                <div class="gp-service-side-card">
                    <h3>شبکه‌های اجتماعی</h3>
                    <div class="gp-social-links">
                        <a class="whatsapp" href="https://wa.me/+989393388985">واتساپ</a>
                        <a target="_blank" rel="noreferrer" class="instagram" href="https://www.instagram.com/tajrishsamak/">اینستاگرام</a>
                        <a target="_blank" rel="noreferrer" class="telegram" href="https://www.telegram.me/sthc/">تلگرام</a>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <button type="button" class="gp-back-to-top" id="gpBackToTop" aria-label="بازگشت به بالا">↑</button>
    <div class="gp-service-toast" id="gpServiceToast" aria-live="polite">به علاقه‌مندی اضافه شد</div>
</section>

@section Scripts{
    <script>
        (function () {
            var storageKey = "gpTajrishFavoriteServices";
            var button = document.getElementById("gpServiceFavoriteBtn");
            var toast = document.getElementById("gpServiceToast");




            function setupCompactServiceReading() {
                var content = document.getElementById("gpServiceContent");
                var wrap = document.getElementById("gpServiceContentWrap");
                var readMoreBox = document.getElementById("gpReadMoreBox");
                var readMoreBtn = document.getElementById("gpReadMoreBtn");
                var expandTop = document.getElementById("gpExpandServiceTop");
                var copyBtn = document.getElementById("gpCopyServiceLink");
                var progress = document.getElementById("gpServiceReadingProgress");
                var backTop = document.getElementById("gpBackToTop");
                var tocCard = document.getElementById("gpServiceTocCard");
                var tocList = document.getElementById("gpServiceTocList");

                function expandContent() {
                    if (content) {
                        content.classList.remove("is-collapsed");
                    }

                    if (wrap) {
                        wrap.classList.remove("is-collapsed");
                    }

                    if (readMoreBox) {
                        readMoreBox.classList.remove("is-visible");
                    }

                    if (expandTop) {
                        expandTop.textContent = "متن کامل باز است";
                    }
                }

                if (readMoreBtn) {
                    readMoreBtn.addEventListener("click", expandContent);
                }

                if (expandTop) {
                    expandTop.addEventListener("click", expandContent);
                }

                if (copyBtn) {
                    copyBtn.addEventListener("click", function () {
                        var url = window.location.href;

                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(url).then(function () {
                                copyBtn.textContent = "لینک کپی شد";
                                window.setTimeout(function () {
                                    copyBtn.textContent = "کپی لینک";
                                }, 1600);
                            });
                        } else {
                            copyBtn.textContent = url;
                        }
                    });
                }

                function buildToc() {
                    if (!content || !tocCard || !tocList) {
                        return;
                    }

                    var headings = content.querySelectorAll("h2, h3");
                    if (!headings.length) {
                        return;
                    }

                    for (var i = 0; i < headings.length; i++) {
                        var heading = headings[i];
                        var text = (heading.textContent || "").trim();

                        if (!text) {
                            continue;
                        }

                        if (!heading.id) {
                            heading.id = "service-heading-" + (i + 1);
                        }

                        var link = document.createElement("a");
                        link.href = "#" + heading.id;
                        link.textContent = text.length > 72 ? text.substring(0, 72) + "..." : text;
                        tocList.appendChild(link);
                    }

                    if (tocList.children.length) {
                        tocCard.classList.add("is-visible");
                    }
                }

                function updateProgress() {
                    var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
                    var doc = document.documentElement;
                    var scrollable = Math.max(1, doc.scrollHeight - window.innerHeight);
                    var percent = Math.min(100, Math.max(0, (scrollTop / scrollable) * 100));

                    if (progress) {
                        progress.style.width = percent + "%";
                    }

                    if (backTop) {
                        backTop.classList.toggle("is-visible", scrollTop > 720);
                    }
                }

                if (backTop) {
                    backTop.addEventListener("click", function () {
                        window.scrollTo({ top: 0, behavior: "smooth" });
                    });
                }

                buildToc();
                updateProgress();
                window.addEventListener("scroll", updateProgress, { passive: true });
                window.addEventListener("resize", updateProgress);
            }


            function setupNewsletter() {
                var emailInput = document.getElementById("gpNewsEmail");
                var submitButton = document.getElementById("gpNewsSubmit");
                var msg = document.getElementById("gpNewsMsg");

                if (!emailInput || !submitButton) {
                    return;
                }

                function setMsg(text, isOk) {
                    if (!msg) {
                        return;
                    }

                    msg.textContent = text;
                    msg.style.color = isOk ? "#0ba66f" : "#e10b45";

                    var box = msg.closest(".gp-newsletter-message-v45");
                    if (box) {
                        box.classList.toggle("is-visible", !!text);
                        box.style.border = isOk ? "1px solid rgba(11,166,111,.16)" : "1px solid rgba(225,11,69,.16)";
                        box.style.background = isOk ? "rgba(11,166,111,.075)" : "rgba(225,11,69,.075)";
                    }
                }

                submitButton.addEventListener("click", function (event) {
                    event.preventDefault();

                    var email = (emailInput.value || "").trim();
                    if (!email) {
                        setMsg("لطفاً ایمیل را وارد کنید.", false);
                        return;
                    }

                    submitButton.disabled = true;
                    submitButton.textContent = "در حال ثبت...";

                    fetch("/Home/NewsLetter?text=" + encodeURIComponent(email), {
                        method: "GET",
                        credentials: "same-origin",
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    })
                        .then(function (response) {
                            return response.json();
                        })
                        .then(function (data) {
                            setMsg(data && data.text ? data.text : "درخواست ثبت شد.", data && data.status == 1);
                            if (data && data.status == 1) {
                                emailInput.value = "";
                            }
                        })
                        .catch(function () {
                            setMsg("خطا در ثبت ایمیل. دوباره تلاش کنید.", false);
                        })
                        .finally(function () {
                            submitButton.disabled = false;
                            submitButton.textContent = "ثبت";
                        });
                });
            }

            setupNewsletter();


            function wrapContentTables() {
                var content = document.querySelector(".gp-service-content");
                if (!content) {
                    return;
                }

                var tables = content.querySelectorAll("table");
                for (var i = 0; i < tables.length; i++) {
                    var table = tables[i];

                    if (table.parentElement && table.parentElement.classList.contains("gp-table-scroll")) {
                        continue;
                    }

                    var wrapper = document.createElement("div");
                    wrapper.className = "gp-table-scroll";
                    table.parentNode.insertBefore(wrapper, table);
                    wrapper.appendChild(table);
                }
            }

            wrapContentTables();
            setupCompactServiceReading();


            if (!button) {
                return;
            }

            function readSaved() {
                try {
                    var raw = window.localStorage.getItem(storageKey);
                    var data = raw ? JSON.parse(raw) : [];
                    return Array.isArray(data) ? data : [];
                } catch (e) {
                    return [];
                }
            }

            function writeSaved(items) {
                try {
                    window.localStorage.setItem(storageKey, JSON.stringify(items));
                } catch (e) { }
            }

            function showToast(text) {
                if (!toast) {
                    return;
                }
                toast.textContent = text;
                toast.classList.add("is-visible");
                window.clearTimeout(showToast._timer);
                showToast._timer = window.setTimeout(function () {
                    toast.classList.remove("is-visible");
                }, 1700);
            }

            function updateUI() {
                var id = button.getAttribute("data-gp-save-service");
                var saved = readSaved();
                var isSaved = saved.some(function (item) {
                    return String(item.id) === String(id);
                });

                button.classList.toggle("is-saved", isSaved);
                button.innerHTML = isSaved
                    ? '<span class="gp-heart-icon" aria-hidden="true">♥</span> علاقه‌مندی'
                    : '<span class="gp-heart-icon" aria-hidden="true">♡</span> علاقه‌مندی';
            }

            button.addEventListener("click", function () {
                var id = button.getAttribute("data-gp-save-service");
                var title = button.getAttribute("data-gp-save-title") || "خدمت";
                var saved = readSaved();
                var exists = saved.some(function (item) {
                    return String(item.id) === String(id);
                });

                if (exists) {
                    saved = saved.filter(function (item) {
                        return String(item.id) !== String(id);
                    });
                    writeSaved(saved);
                    showToast("از علاقه‌مندی حذف شد");
                } else {
                    saved.push({
                        id: id,
                        title: title,
                        savedAt: new Date().toISOString()
                    });
                    writeSaved(saved);
                    showToast("به علاقه‌مندی اضافه شد");
                }

                updateUI();
            });

            updateUI();
        })();
    </script>
}
