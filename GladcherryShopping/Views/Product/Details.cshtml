        }

        html.gp-dark-mode .gp-product-content .gp-table-hint::before {
            color: #fff !important;
        }

        html.gp-dark-mode .gp-product-content .gp-table-hint::after {
            color: rgba(246,247,251,.62) !important;
        }

        html.gp-dark-mode .gp-product-content table th,
        html.gp-dark-mode .gp-product-content table thead td {
