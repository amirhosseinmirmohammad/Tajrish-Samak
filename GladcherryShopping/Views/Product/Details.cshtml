    </style>
}

@if (TempData["Success"] != null)
{
    <div class="container text-center" style="direction:rtl !important;">
        <div class="alert alert-success">@TempData["Success"]</div>
    </div>
}

@if (TempData["error"] != null)
{
    <div class="container text-center" style="direction:rtl !important;">
        <div class="alert alert-danger">@TempData["error"]</div>
    </div>
}

<div class="gp-product-progress" id="gpProductProgress" aria-hidden="true"></div>

<section class="gp-product-page-v47" aria-label="@gpTitle">
    <div class="container">
        <section class="gp-pdp-shell" aria-label="معرفی محصول">
            <div class="gp-pdp-card gp-pdp-gallery-card">
                <div class="gp-gallery-actions">
                    <button type="button" class="gp-gallery-action gp-save-mini" id="gpProductSaveMiniBtn" aria-label="ذخیره محصول">
                        <span class="gp-heart-icon" aria-hidden="true">♡</span>
                    </button>
                    <button type="button" class="gp-gallery-action" id="gpCopyProductLinkMini" aria-label="کپی لینک">↗</button>
                    <a class="gp-gallery-action" href="tel:02122735588" aria-label="تماس">☎</a>
                </div>

                <div class="gp-main-product-image">
                    <img id="gpProductMainImage" src="@gpGallery.FirstOrDefault()" alt="@gpTitle" title="@gpTitle" loading="eager" decoding="async" />
                </div>

                @if (gpGallery.Count() > 1)
                {
                    <div class="gp-product-thumbs" aria-label="تصاویر محصول">
                        @{
                            var gpImageIndex = 0;
                        }
                        @foreach (var image in gpGallery)
                        {
                            <button type="button" class="gp-product-thumb @(gpImageIndex == 0 ? "is-active" : "")" data-gp-product-image="@image" aria-label="تصویر @(gpImageIndex + 1)">
                                <img src="@image" alt="@gpTitle" title="@gpTitle" loading="lazy" decoding="async" />
                            </button>
                            gpImageIndex++;
                        }
                    </div>
                }
            </div>

            <div class="gp-pdp-card gp-pdp-info-card">
                <div class="gp-pdp-breadcrumb">
                    <a href="/">دیجی‌کالا؟ نه، شکوه تجریش</a>
                    <span>/</span>
                    <a href="/Product/All">محصولات</a>
                    <span>/</span>
                    <span>@gpTitle</span>
                </div>

                <div class="gp-product-tag-row">
                    <span class="gp-product-tag is-red">پیشنهاد شکوه تجریش</span>
                    <span class="gp-product-tag">انتخاب تخصصی</span>
                    <span class="gp-product-tag">مشاوره قبل از خرید</span>
                </div>

                <h1 class="gp-pdp-title">@gpTitle</h1>
                <h2 class="gp-pdp-english">@gpEnglishTitle</h2>
                <p class="gp-pdp-summary">@gpMetaDesc</p>

                <div class="gp-color-choice">
                    <strong>رنگ/مدل قابل بررسی:</strong>
                    <span class="gp-color-dot" aria-hidden="true"></span>
                    <span class="gp-product-tag">طبق موجودی کلینیک</span>
                </div>

                <div class="gp-feature-mini-grid">
                    <div class="gp-feature-mini">
                        <span>نوع انتخاب</span>
                        <strong>پس از ارزیابی شنوایی</strong>
                    </div>
                    <div class="gp-feature-mini">
                        <span>خدمات همراه</span>
                        <strong>تنظیم و آموزش استفاده</strong>
                    </div>
                    <div class="gp-feature-mini">
                        <span>پشتیبانی</span>
                        <strong>پیگیری بعد از تجویز</strong>
                    </div>
                </div>
            </div>

            <aside class="gp-pdp-buy-card" aria-label="کارت اقدام محصول">
                <div class="gp-buy-inner">
                    <div class="gp-special-label">
                        <span>پیشنهاد شکوه تجریش</span>
                        <small>مشاوره فوری</small>
                    </div>

                    <div class="gp-seller-box">
                        <strong>فروشنده و مشاور</strong>
                        <span>کلینیک شنوایی و سمعک شکوه تجریش</span>
                    </div>

                    <div class="gp-seller-box">
                        <strong>گارانتی و خدمات</strong>
                        <span>بسته به نوع محصول و شرایط شرکت ارائه‌دهنده بررسی می‌شود.</span>
                    </div>

                    <div class="gp-consult-note">
                        این صفحه برای بررسی اولیه محصول است. انتخاب نهایی سمعک باید بر اساس تست شنوایی، نیاز فردی و تنظیم تخصصی انجام شود.
                    </div>

                    <div class="gp-buy-actions">
                        <a class="gp-buy-btn primary" href="tel:02122735588">تماس برای مشاوره</a>
                        <a class="gp-buy-btn secondary" href="https://wa.me/+989393388985">واتساپ</a>
                        <button type="button" class="gp-buy-btn secondary gp-product-save-btn" id="gpProductSaveBtn" data-gp-save-product="@Model.product.Id" data-gp-save-title="@gpTitle">
                            <span class="gp-heart-icon" aria-hidden="true">♡</span>
                            علاقه‌مندی
                        </button>
                    </div>
                </div>
            </aside>
        </section>

        <section class="gp-service-perks" aria-label="مزیت‌های کلینیک">
            <div class="gp-service-perk"><i>✓</i><span>مشاوره تخصصی</span></div>
            <div class="gp-service-perk"><i>⌁</i><span>ارزیابی شنوایی</span></div>
            <div class="gp-service-perk"><i>⚙</i><span>تنظیم سمعک</span></div>
            <div class="gp-service-perk"><i>☎</i><span>پشتیبانی واقعی</span></div>
            <div class="gp-service-perk"><i>♡</i><span>انتخاب مناسب</span></div>
        </section>

        <div class="gp-sticky-tabs-wrap">
            <nav class="gp-sticky-tabs" aria-label="ناوبری محصول">
                <a class="gp-tab-link is-active" href="#gp-overview">معرفی</a>
                <a class="gp-tab-link" href="#gp-review">بررسی تخصصی</a>
                @if (gpRelatedFromProduct.Count() > 0 || gpRelatedByCategory.Count() > 0)
                {
                    <a class="gp-tab-link" href="#gp-related">محصولات مرتبط</a>
                }
                <a class="gp-tab-link" href="#gp-comments">دیدگاه‌ها</a>
            </nav>
        </div>

        <section class="gp-pdp-section-card" id="gp-overview" aria-label="معرفی کوتاه">
            <div class="gp-section-title">
                <h2>معرفی محصول</h2>
                <a href="#gp-review">مشاهده بررسی بیشتر</a>
            </div>
            <p class="gp-pdp-summary">@gpMetaDesc</p>
        </section>

        <section class="gp-pdp-section-card" id="gp-review" aria-label="بررسی تخصصی محصول">
            <div class="gp-section-title">
                <h2>بررسی تخصصی</h2>
                <a href="tel:02122735588">نیاز به مشاوره دارید؟</a>
            </div>

            <div class="gp-product-reading-tools" aria-label="ابزار مطالعه محصول">
                <button type="button" class="gp-product-tool-btn" id="gpExpandProductTop">مطالعه کامل</button>
                <button type="button" class="gp-product-tool-btn" id="gpCopyProductLink">کپی لینک</button>
            </div>

            <div class="gp-product-content-wrap is-collapsed" id="gpProductContentWrap">
                <article class="gp-product-content is-collapsed" id="gpProductContent">
                    @Html.Raw(Model.product.Description)
                </article>
            </div>

            <div class="gp-read-more-box is-visible" id="gpReadMoreBox">
                <strong>بقیه مقاله</strong>
                <span>در ادامه</span>
                <button type="button" class="gp-read-more-btn" id="gpReadMoreBtn">ادامه مطالعه</button>
            </div>
        </section>

        @if (gpRelatedFromProduct.Count() > 0 || gpRelatedByCategory.Count() > 0)
        {
            <section class="gp-pdp-section-card" id="gp-related" aria-label="محصولات مرتبط">
                <div class="gp-section-title">
                    <h2>کالاهای مشابه و متعلقات</h2>
                    <a href="/Product/All">مشاهده همه</a>
                </div>

                @if (gpRelatedFromProduct.Count() > 0)
                {
                    <div class="gp-related-mini-title">متعلقات پیشنهادی</div>
                    <div class="gp-related-showcase" aria-label="متعلقات پیشنهادی">
                        <div class="gp-related-track">
                            @for (var round = 0; round < 8; round++)
                            {
                                foreach (var rel in gpRelatedFromProduct)
                                {
                                    var relText = !string.IsNullOrWhiteSpace(rel.Description)
                                        ? CleanPlainText(rel.Description)
                                        : "برای بررسی دقیق‌تر این محصول و سازگاری آن با نیاز شنوایی شما، مشاوره تخصصی انجام می‌شود.";

                                    <a class="gp-marquee-product" href="/Product/Details/@rel.Id" title="@rel.PersianName">
                                        <span class="gp-marquee-product-media">
                                            <img src="@rel.SiteFirstImage" alt="@rel.PersianName" title="@rel.PersianName" loading="lazy" decoding="async" />
                                        </span>
                                        <span class="gp-marquee-product-body">
                                            <span class="gp-marquee-product-badge">بررسی</span>
                                            <strong>@GladCherryShopping.Helpers.FunctionsHelper.Truncate(rel.PersianName, 44)</strong>
                                        </span>
                                        <span class="gp-marquee-product-desc">@GladCherryShopping.Helpers.FunctionsHelper.Truncate(relText, 92)</span>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                }

                @if (gpRelatedByCategory.Count() > 0)
                {
                    <div class="gp-related-mini-title">کالاهای مشابه</div>
                    <div class="gp-related-showcase" aria-label="محصولات مشابه">
                        <div class="gp-related-track">
                            @for (var round = 0; round < 8; round++)
                            {
                                foreach (var item in gpRelatedByCategory)
                                {
                                    var itemText = !string.IsNullOrWhiteSpace(item.Description)
                                        ? CleanPlainText(item.Description)
                                        : "برای انتخاب مطمئن‌تر، این محصول را با مشاوره تخصصی و تست شنوایی بررسی کنید.";

                                    <a class="gp-marquee-product" href="/Product/Details/@item.Id" title="@item.PersianName">
                                        <span class="gp-marquee-product-media">
                                            <img src="@item.SiteFirstImage" alt="@item.PersianName" title="@item.PersianName" loading="lazy" decoding="async" />
                                        </span>
                                        <span class="gp-marquee-product-body">
                                            <span class="gp-marquee-product-badge">مشابه</span>
                                            <strong>@GladCherryShopping.Helpers.FunctionsHelper.Truncate(item.PersianName, 44)</strong>
                                        </span>
                                        <span class="gp-marquee-product-desc">@GladCherryShopping.Helpers.FunctionsHelper.Truncate(itemText, 92)</span>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                }
            </section>
        }

        <section class="gp-pdp-section-card" id="gp-comments" aria-label="دیدگاه‌های محصول">
            <div class="gp-section-title">
                <h2>دیدگاه‌ها و پرسش‌ها</h2>
                <a href="#gp-comment-form">ثبت دیدگاه</a>
            </div>

            @if (gpApprovedComments.Count() > 0)
            {
                <div class="gp-comment-list">
                    @foreach (var item in gpApprovedComments)
                    {
                        <article class="gp-comment-item">
                            <img src="@Url.Content("~/images/user_chat.webp")" alt="کاربر کلینیک شنوایی و سمعک شکوه تجریش" title="کاربر کلینیک شنوایی و سمعک شکوه تجریش" loading="lazy" decoding="async" />
                            <div>
                                <strong>@item.Fullname</strong>
                                <small>@GladCherryShopping.Helpers.FunctionsHelper.GetPersianDateTime(item.DateTime, false, false)</small>
                                <p>@item.Text</p>
                            </div>
                        </article>
                    }
                </div>
            }

            <form id="gp-comment-form" class="gp-comment-form" method="post" action="/Product/InsertComment">
                @Html.AntiForgeryToken()
                @Html.EditorFor(model => model.comment.Fullname, new { htmlAttributes = new { required = "required", Name = "Fullname", placeholder = "نام و نام خانوادگی" } })
                @Html.ValidationMessageFor(model => model.comment.Fullname, "", new { @class = "text-danger" })

                @Html.EditorFor(model => model.comment.Email, new { htmlAttributes = new { required = "required", Name = "Email", placeholder = "ایمیل" } })
                @Html.ValidationMessageFor(model => model.comment.Email, "", new { @class = "text-danger" })

                <textarea name="comment.Text" required placeholder="متن نظر"></textarea>
                <input type="hidden" value="@Model.product.Id" name="ProductId" />
                <button type="submit">ارسال دیدگاه</button>
            </form>
        </section>
    </div>

    <button type="button" class="gp-back-to-top" id="gpBackToTop" aria-label="بازگشت به بالا">↑</button>
    <div class="gp-product-toast" id="gpProductToast" aria-live="polite">به علاقه‌مندی اضافه شد</div>
</section>

@if (TempData["Success"] != null || TempData["error"] != null)
{
    <div class="modal fade" id="myModal" role="dialog" style="margin-top:80px">
        <div class="modal-dialog">
            <div class="modal-content" style="direction:rtl;text-align:right;">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">وضعیت دیدگاه</h4>
                </div>
                <div class="modal-body" style="text-align:center;direction:rtl;">
                    @if (TempData["Success"] != null)
                    {
                        <p class="text-success">@TempData["Success"]</p>
                    }
                    @if (TempData["error"] != null)
                    {
                        <p class="text-danger">@TempData["error"]</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            $("#myModal").modal();
        });
    </script>

    <script>
        (function () {
            var storageKey = "gpTajrishFavoriteProducts";
            var saveButton = document.getElementById("gpProductSaveBtn");
            var saveMiniButton = document.getElementById("gpProductSaveMiniBtn");
            var toast = document.getElementById("gpProductToast");

            function showToast(text) {
                if (!toast) {
                    return;
                }

                toast.textContent = text;
                toast.classList.add("is-visible");
                window.clearTimeout(showToast._timer);
                showToast._timer = window.setTimeout(function () {
                    toast.classList.remove("is-visible");
                }, 1700);
            }

            function readSaved() {
                try {
                    var raw = window.localStorage.getItem(storageKey);
                    var data = raw ? JSON.parse(raw) : [];
                    return Array.isArray(data) ? data : [];
                } catch (e) {
                    return [];
                }
            }

            function writeSaved(items) {
                try {
                    window.localStorage.setItem(storageKey, JSON.stringify(items));
                } catch (e) { }
            }

            function currentProductId() {
                return saveButton ? saveButton.getAttribute("data-gp-save-product") : "@Model.product.Id";
            }

            function currentProductTitle() {
                return saveButton ? saveButton.getAttribute("data-gp-save-title") || "محصول" : "@gpTitle";
            }

            function isSavedProduct() {
                var id = currentProductId();
                return readSaved().some(function (item) {
                    return String(item.id) === String(id);
                });
            }

            function updateSaveUI() {
                var isSaved = isSavedProduct();

                if (saveButton) {
                    saveButton.classList.toggle("is-saved", isSaved);
                    saveButton.innerHTML = isSaved
                        ? '<span class="gp-heart-icon" aria-hidden="true">♥</span> علاقه‌مندی'
                        : '<span class="gp-heart-icon" aria-hidden="true">♡</span> علاقه‌مندی';
                }

                if (saveMiniButton) {
                    saveMiniButton.classList.toggle("is-saved", isSaved);
                    saveMiniButton.innerHTML = isSaved
                        ? '<span class="gp-heart-icon" aria-hidden="true">♥</span>'
                        : '<span class="gp-heart-icon" aria-hidden="true">♡</span>';
                }
            }

            function toggleSave() {
                var id = currentProductId();
                var title = currentProductTitle();
                var saved = readSaved();
                var exists = saved.some(function (item) {
                    return String(item.id) === String(id);
                });

                if (exists) {
                    saved = saved.filter(function (item) {
                        return String(item.id) !== String(id);
                    });
                    writeSaved(saved);
                    showToast("از علاقه‌مندی حذف شد");
                } else {
                    saved.push({
                        id: id,
                        title: title,
                        savedAt: new Date().toISOString()
                    });
                    writeSaved(saved);
                    showToast("به علاقه‌مندی اضافه شد");
                }

                updateSaveUI();
            }

            function setupSave() {
                if (saveButton) {
                    saveButton.addEventListener("click", toggleSave);
                }

                if (saveMiniButton) {
                    saveMiniButton.addEventListener("click", toggleSave);
                }

                updateSaveUI();
            }

            function setupGallery() {
                var mainImage = document.getElementById("gpProductMainImage");
                var thumbs = document.querySelectorAll(".gp-product-thumb");

                if (!mainImage || !thumbs.length) {
                    return;
                }

                for (var i = 0; i < thumbs.length; i++) {
                    thumbs[i].addEventListener("click", function () {
                        var image = this.getAttribute("data-gp-product-image");
                        if (!image) {
                            return;
                        }

                        mainImage.src = image;

                        for (var j = 0; j < thumbs.length; j++) {
                            thumbs[j].classList.remove("is-active");
                        }

                        this.classList.add("is-active");
                    });
                }
            }

            function wrapContentTables() {
                var content = document.querySelector(".gp-product-content");
                if (!content) {
                    return;
                }

                var tables = content.querySelectorAll("table");
                for (var i = 0; i < tables.length; i++) {
                    var table = tables[i];

                    table.removeAttribute("width");
                    table.removeAttribute("height");
                    table.style.width = "";
                    table.style.maxWidth = "";

                    var cells = table.querySelectorAll("th, td");
                    for (var c = 0; c < cells.length; c++) {
                        cells[c].removeAttribute("width");
                        cells[c].style.width = "";
                        cells[c].style.maxWidth = "";
                    }

                    if (table.parentElement && table.parentElement.classList.contains("gp-table-scroll")) {
                        if (!table.parentElement.querySelector(".gp-table-hint")) {
                            var existingHint = document.createElement("div");
                            existingHint.className = "gp-table-hint";
                            table.parentElement.insertBefore(existingHint, table);
                        }
                        continue;
                    }

                    var wrapper = document.createElement("div");
                    wrapper.className = "gp-table-scroll";
                    var hint = document.createElement("div");
                    hint.className = "gp-table-hint";
                    table.parentNode.insertBefore(wrapper, table);
                    wrapper.appendChild(hint);
                    wrapper.appendChild(table);
                }
            }

            function setupCompactReading() {
                var content = document.getElementById("gpProductContent");
                var wrap = document.getElementById("gpProductContentWrap");
                var readMoreBox = document.getElementById("gpReadMoreBox");
                var readMoreBtn = document.getElementById("gpReadMoreBtn");
                var expandTop = document.getElementById("gpExpandProductTop");
                var copyBtn = document.getElementById("gpCopyProductLink");
                var copyMini = document.getElementById("gpCopyProductLinkMini");
                var progress = document.getElementById("gpProductProgress");
                var backTop = document.getElementById("gpBackToTop");
                var tabs = document.querySelectorAll(".gp-tab-link");

                function expandContent() {
                    if (content) {
                        content.classList.remove("is-collapsed");
                    }

                    if (wrap) {
                        wrap.classList.remove("is-collapsed");
                    }

                    if (readMoreBox) {
                        readMoreBox.classList.remove("is-visible");
                    }

                    if (expandTop) {
                        expandTop.textContent = "متن کامل باز است";
                    }
                }

                if (readMoreBtn) {
                    readMoreBtn.addEventListener("click", expandContent);
                }

                if (expandTop) {
                    expandTop.addEventListener("click", expandContent);
                }

                function copyCurrentLink(button) {
                    var url = window.location.href;

                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(url).then(function () {
                            if (button) {
                                var isMini = button.id === "gpCopyProductLinkMini";
                                var old = button.textContent;

                                if (isMini) {
                                    button.textContent = "✓";
                                    button.classList.add("is-mini-copied");
                                } else {
                                    button.textContent = "کپی شد";
                                }

                                window.setTimeout(function () {
                                    button.textContent = isMini ? "↗" : (old || "کپی لینک");
                                    button.classList.remove("is-mini-copied");
                                }, 1500);
                            }
                            showToast("لینک کپی شد");
                        });
                    } else {
                        showToast(url);
                    }
                }

                if (copyBtn) {
                    copyBtn.addEventListener("click", function () {
                        copyCurrentLink(copyBtn);
                    });
                }

                if (copyMini) {
                    copyMini.addEventListener("click", function () {
                        copyCurrentLink(copyMini);
                    });
                }

                function updateProgress() {
                    var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
                    var doc = document.documentElement;
                    var scrollable = Math.max(1, doc.scrollHeight - window.innerHeight);
                    var percent = Math.min(100, Math.max(0, (scrollTop / scrollable) * 100));

                    if (progress) {
                        progress.style.width = percent + "%";
                    }

                    if (backTop) {
                        backTop.classList.toggle("is-visible", scrollTop > 720);
                    }

                    var activeId = "";
                    for (var i = 0; i < tabs.length; i++) {
                        var id = tabs[i].getAttribute("href");
                        if (!id || id.charAt(0) !== "#") {
                            continue;
                        }

                        var section = document.querySelector(id);
                        if (section && section.getBoundingClientRect().top < 160) {
                            activeId = id;
                        }
                    }

                    if (activeId) {
                        for (var j = 0; j < tabs.length; j++) {
                            tabs[j].classList.toggle("is-active", tabs[j].getAttribute("href") === activeId);
                        }
                    }
                }

                if (backTop) {
                    backTop.addEventListener("click", function () {
                        window.scrollTo({ top: 0, behavior: "smooth" });
                    });
                }

                updateProgress();
                window.addEventListener("scroll", updateProgress, { passive: true });
                window.addEventListener("resize", updateProgress);
            }

            setupSave();
            setupGallery();
            wrapContentTables();
            setupCompactReading();
        })();
    </script>
}
