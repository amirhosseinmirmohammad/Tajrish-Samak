                font-size: 13.5px !important;
                line-height: 2.05 !important;
            }

            .gp-read-more-box {
                margin-top: -78px;
                border-radius: 24px;
            }

            .gp-comment-item {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .gp-comment-item img {
                margin: 0 auto;
            }

            .gp-product-toast {
                left: 14px;
                right: 14px;
                bottom: 86px;
            }

            .gp-back-to-top {
                left: 14px;
                bottom: 86px;
            }
        }

        /* V51: legacy related grid/scroll right alignment fallback */
        .gp-related-scroll {
            direction: rtl !important;
            justify-content: flex-start !important;
            margin-right: 0 !important;
            margin-left: auto !important;
