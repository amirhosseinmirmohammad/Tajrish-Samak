@model DataLayer.ViewModels.ProductDetailViewModel
@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Web;
@using System.Data.Entity;
@using System.Text.RegularExpressions;
@using Microsoft.Ajax.Utilities;
@{
    GladcherryShopping.Models.ApplicationDbContext content = new GladcherryShopping.Models.ApplicationDbContext();

    var gpCacheVersion = "20260603-tajrish-v51-related-align-routes";
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpCanonicalUrl = gpBaseUrl + Request.Path;

    string gpRawDesc = Model != null && Model.product != null && Model.product.Description != null
        ? Model.product.Description
        : "";

    var gpPlainDesc = CleanPlainText(gpRawDesc);

    var gpTitle = Model != null && Model.product != null && !string.IsNullOrWhiteSpace(Model.product.PersianName)
        ? Model.product.PersianName
        : "محصول سمعک";

    var gpEnglishTitle = Model != null && Model.product != null && !string.IsNullOrWhiteSpace(Model.product.EnglishName)
        ? Model.product.EnglishName
        : gpTitle;

    var gpMetaDesc = GladCherryShopping.Helpers.FunctionsHelper.Truncate(gpPlainDesc, 160);
    if (string.IsNullOrWhiteSpace(gpMetaDesc))
    {
        gpMetaDesc = "بررسی مشخصات، توضیحات و جزئیات محصول در کلینیک شنوایی و سمعک شکوه تجریش همراه با مشاوره تخصصی انتخاب و تنظیم سمعک.";
    }

    var gpImageUrl = Model.product.SiteFirstImage != null
        ? gpBaseUrl + Model.product.SiteFirstImage
        : gpBaseUrl + "/images/logo_purple.webp";

    var gpGallery = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.product.SiteFirstImage)) { gpGallery.Add(Model.product.SiteFirstImage); }
    if (!string.IsNullOrWhiteSpace(Model.product.SiteSecondImage)) { gpGallery.Add(Model.product.SiteSecondImage); }
    if (!string.IsNullOrWhiteSpace(Model.product.SiteThirdImage)) { gpGallery.Add(Model.product.SiteThirdImage); }

    if (!gpGallery.Any())
    {
        gpGallery.Add(Url.Content("~/images/logo_purple.webp"));
    }

    var gpApprovedComments = content.Comments
        .AsNoTracking()
        .Where(current => current.IsApprove == true && current.ProductId == Model.product.Id)
        .OrderByDescending(current => current.DateTime)
        .ToList();

    var gpRelatedFromProduct = Model.product.RelatedProducts != null
        ? Model.product.RelatedProducts.DistinctBy(current => current.Id).Take(6).ToList()
        : new List<DataLayer.Models.Product>();

    var gpRelatedByCategory = content.Products
        .AsNoTracking()
        .Where(current => current.Id != Model.product.Id && current.CategoryId == Model.product.CategoryId)
        .OrderByDescending(current => current.Id)
        .Take(8)
        .ToList();

    ViewBag.Title = gpTitle + " | کلینیک شنوایی و سمعک شکوه تجریش";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    public string StripForJson(string value)
    {
        return HttpUtility.JavaScriptStringEncode(value ?? "");
    }

    public string CleanPlainText(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        var text = value;

        // Some old product descriptions are saved as encoded HTML, so decode more than once.
        for (var i = 0; i < 3; i++)
        {
            text = HttpUtility.HtmlDecode(text);
        }

        text = Regex.Replace(text, @"<script[\\s\\S]*?</script>", " ", RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"<style[\\s\\S]*?</style>", " ", RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"<br\\s*/?>", " ", RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"</p\\s*>", " ", RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"<[^>]+>", " ");

        text = text.Replace("\u200c", " ");
        text = text.Replace("&zwnj;", " ");
        text = text.Replace("&nbsp;", " ");

        text = Regex.Replace(text, @"\\s+", " ").Trim();

        return text;
    }
}

@section Metas{
    <meta name="description" content="@gpMetaDesc" />
    <link rel="canonical" href="@gpCanonicalUrl" />
    <meta name="Keywords" content="@gpTitle, @gpEnglishTitle, سمعک, خرید سمعک, تجویز سمعک, تنظیم سمعک, کلینیک شنوایی تجریش" />

    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:image" content="@gpImageUrl" />
    <meta property="og:type" content="product" />
    <meta property="og:url" content="@gpCanonicalUrl" />
    <meta property="og:description" content="@gpMetaDesc" />
    <meta property="og:site_name" content="کلینیک شنوایی و سمعک شکوه تجریش" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:title" content="@ViewBag.Title" />
    <meta name="twitter:image" content="@gpImageUrl" />
    <meta name="twitter:description" content="@gpMetaDesc" />
}

