        @@media(max-width: 1200px) {
            .gp-pdp-shell {
                grid-template-columns: minmax(280px, 390px) minmax(0, 1fr);
            }

            .gp-pdp-buy-card {
                grid-column: 1 / -1;
                position: relative;
                top: auto;
            }
        }

        @@media(max-width: 992px) {
            .gp-pdp-shell {
                grid-template-columns: 1fr;
