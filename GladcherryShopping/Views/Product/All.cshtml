                max-height: 152px;
                object-fit: contain;
                transition: transform .22s ease;
            }

        .gp-category-product-card:hover .gp-category-product-media img,
        .gp-subcategory-card:hover .gp-subcategory-media img {
            transform: scale(1.05);
        }

        .gp-product-new-badge,
