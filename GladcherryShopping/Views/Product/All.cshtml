@model DataLayer.ViewModels.PagerViewModel.PagerViewModels<DataLayer.Models.Product>
@using MvcPager
@using System.Data.Entity;
@{
    GladcherryShopping.Models.ApplicationDbContext content = new GladcherryShopping.Models.ApplicationDbContext();

    var gpCacheVersion = "20260603-tajrish-v25-favorites-6-controller";
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpCanonicalUrl = gpBaseUrl + Request.Path;
    var gpCurrentProducts = Model.data
        .Where(current => current.SiteFirstImage != null)
        .OrderByDescending(current => current.CreateDate)
        .Take(6)
        .ToList();

    var gpCategories = content.Categories
        .Include(current => current.Products)
        .Where(current => current.Products.Count() > 0 && current.IsBlog == false)
        .OrderByDescending(current => current.PersianName)
        .ToList();

    var gpPopularProducts = content.Products
        .Where(current => current.SiteFirstImage != null)
        .OrderByDescending(current => current.CreateDate)
        .Take(6)
        .ToList();

    ViewBag.Title = "جدیدترین سمعک‌ها | کلینیک شنوایی و سمعک شکوه تجریش";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Metas{
    <meta name="description" content="مشاهده جدیدترین سمعک‌ها در کلینیک شنوایی و سمعک شکوه تجریش؛ بررسی مدل‌ها، افزودن گزینه‌های مناسب به علاقه‌مندی، دریافت مشاوره و انتخاب سمعک بر اساس تست شنوایی." />
    <link rel="canonical" href="@gpCanonicalUrl" />
    <meta name="Keywords" content="جدیدترین سمعک، خرید سمعک، تجویز سمعک، سمعک دیجیتال، سمعک نامرئی، سمعک پشت گوشی، کلینیک شنوایی تجریش" />
    <meta property="og:title" content="جدیدترین سمعک‌ها | کلینیک شنوایی و سمعک شکوه تجریش" />
    <meta property="og:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@gpCanonicalUrl" />
    <meta property="og:description" content="جدیدترین سمعک‌ها را ببینید، گزینه‌های مناسب را به علاقه‌مندی اضافه کنید و برای انتخاب دقیق‌تر مشاوره بگیرید." />
    <meta name="twitter:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta name="twitter:description" content="جدیدترین سمعک‌ها، فیلتر بر اساس دسته‌بندی، علاقه‌مندی محصول و مشاوره تخصصی انتخاب سمعک." />
}

@section Styles{
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "صفحه اصلی",
              "item": "https://tajrish-samak.ir/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "جدیدترین سمعک‌ها",
              "item": "@gpCanonicalUrl"
            }
          ]
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "ItemList",
          "name": "جدیدترین سمعک‌های کلینیک شکوه تجریش",
          "url": "@gpCanonicalUrl",
          "numberOfItems": "@gpCurrentProducts.Count()",
          "itemListElement": [
            @{
                var gpSchemaIndex = 1;
                var gpSchemaItems = gpCurrentProducts.Take(6).ToList();
            }
            @foreach (var item in gpSchemaItems)
            {
                <text>{
                  "@@type": "ListItem",
                  "position": @gpSchemaIndex,
                  "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(item.PersianName))",
                  "url": "https://tajrish-samak.ir/Product/Details/@item.Id"
                }</text>
                if (gpSchemaIndex < gpSchemaItems.Count())
                {
                    <text>,</text>
                }
                gpSchemaIndex++;
            }
          ]
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "چطور سمعک مناسب را انتخاب کنیم؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "انتخاب سمعک باید بر اساس نتیجه تست شنوایی، سبک زندگی، نیاز شنیداری، بودجه و نظر متخصص شنوایی انجام شود."
              }
            },
            {
              "@@type": "Question",
              "name": "آیا می‌توان چند مدل سمعک را برای بررسی بعدی ذخیره کرد؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "در این صفحه می‌توانید گزینه‌های مناسب را به علاقه‌مندی اضافه کنید و بعد برای مشاوره یا مقایسه دوباره به آن‌ها برگردید."
              }
            },
            {
              "@@type": "Question",
              "name": "آیا مشاوره انتخاب سمعک ضروری است؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "بله، مشاوره تخصصی کمک می‌کند مدل سمعک با نوع کم‌شنوایی، راحتی استفاده و نیاز روزمره فرد هماهنگ شود."
              }
            }
          ]
        }
    </script>

    <style id="gp-v24-save-seo-products-page">
        :root {
            --gp-v24-purple: #4b1684;
            --gp-v24-violet: #920ab6;
            --gp-v24-pink: #e10b79;
            --gp-v24-cyan: #0ba6b8;
            --gp-v24-ink: #20142d;
            --gp-v24-muted: rgba(32, 20, 45, .66);
            --gp-v24-card: rgba(255,255,255,.88);
            --gp-v24-border: rgba(75,22,132,.10);
            --gp-v24-shadow: 0 24px 60px rgba(74,18,107,.10);
        }

        .gp-products-page {
            direction: rtl;
            overflow: hidden;
        }

        .gp-products-hero {
            position: relative;
            margin: 22px auto 28px;
            padding: clamp(28px, 4vw, 56px);
            border-radius: 42px;
            background:
                radial-gradient(circle at 12% 12%, rgba(216,245,18,.26), transparent 24%),
                radial-gradient(circle at 88% 24%, rgba(255,255,255,.16), transparent 22%),
                linear-gradient(135deg, #4b1684 0%, #920ab6 52%, #e10b79 100%);
            color: #fff;
            box-shadow: 0 32px 80px rgba(74,18,107,.20);
            isolation: isolate;
        }

        .gp-products-hero::before,
        .gp-products-hero::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            pointer-events: none;
            z-index: -1;
        }

        .gp-products-hero::before {
            width: 260px;
            height: 260px;
            left: -92px;
            top: -88px;
            background: rgba(255,255,255,.13);
            animation: gpV24Blob 10s ease-in-out infinite alternate;
        }

        .gp-products-hero::after {
            width: 320px;
            height: 320px;
            right: -120px;
            bottom: -170px;
            background: rgba(11,166,184,.22);
            animation: gpV24Blob 12s ease-in-out infinite alternate-reverse;
        }

        @@keyframes gpV24Blob {
            to { transform: translate3d(24px, 18px, 0) scale(1.06); }
        }

        .gp-products-hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(260px, .42fr);
            gap: clamp(20px, 4vw, 46px);
            align-items: center;
        }

        .gp-products-kicker {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            color: #fff !important;
            font-weight: 950;
            backdrop-filter: blur(14px);
        }

        .gp-products-hero h1 {
            margin: 16px 0 12px;
            color: #fff !important;
            font-size: clamp(30px, 4.8vw, 64px);
            font-weight: 1000;
            line-height: 1.32 !important;
            letter-spacing: -.02em;
        }

        .gp-products-hero p {
            max-width: 780px;
            margin: 0;
            color: rgba(255,255,255,.90) !important;
            font-size: clamp(14px, 1.2vw, 18px);
            font-weight: 850;
            line-height: 2.1;
        }

        .gp-products-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 24px;
        }

        .gp-products-hero-actions a,
        .gp-saved-counter-chip {
            min-height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0 18px;
            border-radius: 999px;
            text-decoration: none !important;
            font-weight: 950;
        }

        .gp-products-hero-actions a:first-child {
            background: #fff;
            color: #4b1684 !important;
            box-shadow: 0 18px 38px rgba(0,0,0,.14);
        }

        .gp-products-hero-actions a:nth-child(2),
        .gp-saved-counter-chip {
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.24);
            color: #fff !important;
        }

        .gp-products-stats {
            display: grid;
            gap: 12px;
        }

        .gp-products-stat-card {
            min-height: 92px;
            padding: 18px;
            border-radius: 28px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            backdrop-filter: blur(14px);
        }

        .gp-products-stat-card strong {
            display: block;
            color: #fff !important;
            font-size: 28px;
            font-weight: 1000;
            line-height: 1;
        }

        .gp-products-stat-card span {
            display: block;
            margin-top: 8px;
            color: rgba(255,255,255,.82) !important;
            font-weight: 850;
        }

        .gp-products-shell {
            display: grid;
            grid-template-columns: minmax(250px, 300px) minmax(0, 1fr);
            gap: 22px;
            align-items: start;
            margin-bottom: 40px;
        }

        .gp-products-sidebar,
        .gp-products-list-card {
            border-radius: 34px;
            background: var(--gp-v24-card);
            border: 1px solid var(--gp-v24-border);
            box-shadow: var(--gp-v24-shadow);
            backdrop-filter: blur(18px);
        }

        .gp-products-sidebar {
            position: sticky;
            top: 16px;
            padding: 18px;
        }

        .gp-filter-card {
            padding: 16px;
            border-radius: 26px;
            background: rgba(255,255,255,.62);
            border: 1px solid rgba(75,22,132,.08);
            margin-bottom: 14px;
        }

        .gp-filter-card h2,
        .gp-filter-card h3 {
            margin: 0 0 12px;
            color: var(--gp-v24-ink) !important;
            font-size: 16px;
            font-weight: 1000;
            line-height: 1.7 !important;
        }

        .gp-filter-search {
            position: relative;
            display: flex;
            align-items: center;
            min-height: 48px;
            border-radius: 18px;
            overflow: hidden;
            background: #fff;
            border: 1px solid rgba(75,22,132,.10);
        }

        .gp-filter-search input[type="search"] {
            flex: 1;
            min-width: 0;
            height: 48px;
            border: 0 !important;
            outline: 0 !important;
            padding: 0 14px;
            background: transparent;
            color: var(--gp-v24-ink);
            font-weight: 850;
        }

        .gp-filter-search button {
            width: 48px;
            height: 48px;
            border: 0;
            background: linear-gradient(135deg, var(--gp-v24-purple), var(--gp-v24-violet));
            color: #fff;
            font-weight: 1000;
        }

        .gp-category-list {
            max-height: 330px;
            overflow: auto;
            padding: 0;
            margin: 0;
            list-style: none;
        }

        .gp-category-list li {
            margin-bottom: 8px;
        }

        .gp-category-list label {
            width: 100%;
            min-height: 42px;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 16px;
            background: rgba(255,255,255,.62);
            border: 1px solid rgba(75,22,132,.08);
            color: rgba(32,20,45,.78);
            font-weight: 850;
            cursor: pointer;
            transition: transform .18s ease, border-color .18s ease, background .18s ease;
        }

        .gp-category-list label:hover {
            transform: translateY(-2px);
            border-color: rgba(146,10,182,.22);
            background: #fff;
        }

        .gp-category-list input {
            accent-color: var(--gp-v24-violet);
        }

        .gp-filter-submit {
            width: 100%;
            min-height: 48px;
            border: 0;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--gp-v24-purple), var(--gp-v24-violet), var(--gp-v24-pink));
            color: #fff;
            font-weight: 1000;
            box-shadow: 0 16px 32px rgba(146,10,182,.18);
        }

        .gp-side-popular {
            display: grid;
            gap: 10px;
        }

        .gp-side-product {
            display: grid;
            grid-template-columns: 62px minmax(0, 1fr);
            gap: 10px;
            align-items: center;
            padding: 9px;
            border-radius: 18px;
            background: rgba(255,255,255,.65);
            border: 1px solid rgba(75,22,132,.08);
            text-decoration: none !important;
            transition: transform .18s ease, background .18s ease;
        }

        .gp-side-product:hover {
            transform: translateY(-2px);
            background: #fff;
        }

        .gp-side-product img {
            width: 62px;
            height: 62px;
            border-radius: 16px;
            object-fit: contain;
            background: #fff;
        }

        .gp-side-product strong {
            display: block;
            color: var(--gp-v24-ink) !important;
            font-size: 13px;
            font-weight: 950;
            line-height: 1.8;
        }

        .gp-side-product span {
            display: block;
            color: var(--gp-v24-muted) !important;
            font-size: 12px;
            font-weight: 850;
        }

        .gp-products-list-card {
            padding: clamp(16px, 2.2vw, 26px);
        }

        .gp-products-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .gp-products-toolbar h2 {
            margin: 0;
            color: var(--gp-v24-ink) !important;
            font-size: clamp(22px, 2.4vw, 34px);
            font-weight: 1000;
            line-height: 1.5 !important;
        }

        .gp-products-toolbar p {
            margin: 4px 0 0;
            color: var(--gp-v24-muted) !important;
            font-weight: 850;
            line-height: 1.9;
        }

        .gp-view-hints {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .gp-view-hints span {
            min-height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 11px;
            border-radius: 999px;
            background: rgba(146,10,182,.08);
            color: #6420a0 !important;
            font-weight: 900;
            font-size: 12px;
        }

        .gp-products-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .gp-seo-product-card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-height: 390px;
            border-radius: 30px;
            background: #fff;
            border: 1px solid rgba(75,22,132,.08);
            box-shadow: 0 18px 42px rgba(74,18,107,.08);
            overflow: hidden;
            transition: transform .22s cubic-bezier(.2,.8,.2,1), box-shadow .22s ease;
        }

        .gp-seo-product-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 30px 72px rgba(74,18,107,.15);
        }

        .gp-seo-product-media {
            position: relative;
            height: 190px;
            display: grid;
            place-items: center;
            padding: 18px;
            background:
                radial-gradient(circle at 20% 10%, rgba(146,10,182,.12), transparent 30%),
                linear-gradient(135deg, #fff, #fbf7ff);
            text-decoration: none !important;
        }

        .gp-seo-product-media img {
            max-width: 100%;
            max-height: 152px;
            object-fit: contain;
            transition: transform .22s ease;
        }

        .gp-seo-product-card:hover .gp-seo-product-media img {
            transform: scale(1.05);
        }

        .gp-product-new-badge {
            position: absolute;
            top: 14px;
            right: 14px;
            min-height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            border-radius: 999px;
            background: #d8f512;
            color: #1d1430 !important;
            font-size: 12px;
            font-weight: 1000;
            box-shadow: 0 12px 24px rgba(216,245,18,.22);
        }

        .gp-product-card-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 17px;
        }

        .gp-product-card-body h2 {
            margin: 0 0 8px;
            font-size: 17px;
            font-weight: 1000;
            line-height: 1.8 !important;
        }

        .gp-product-card-body h2 a {
            color: var(--gp-v24-ink) !important;
            text-decoration: none !important;
        }

        .gp-product-card-body p {
            margin: 0 0 14px;
            color: var(--gp-v24-muted) !important;
            font-size: 13px;
            font-weight: 850;
            line-height: 2;
        }

        .gp-product-card-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin: auto 0 14px;
        }

        .gp-product-card-meta span {
            min-height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            border-radius: 999px;
            background: rgba(146,10,182,.08);
            color: #6420a0 !important;
            font-size: 12px;
            font-weight: 900;
        }

        .gp-product-actions {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 8px;
        }

        .gp-product-details,
        .gp-product-save {
            min-height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 17px;
            text-decoration: none !important;
            font-weight: 1000;
            transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
        }

        .gp-product-details {
            background: linear-gradient(135deg, var(--gp-v24-purple), var(--gp-v24-violet));
            color: #fff !important;
            box-shadow: 0 16px 32px rgba(146,10,182,.17);
        }

        .gp-product-save {
            min-width: 92px;
            border: 1px solid rgba(146,10,182,.18);
            background: #fff;
            color: #6420a0 !important;
            cursor: pointer;
        }

        .gp-product-save.is-saved {
            background: #d8f512;
            border-color: transparent;
            color: #1d1430 !important;
        }

        .gp-product-details:hover,
        .gp-product-save:hover {
            transform: translateY(-2px);
        }

        .gp-empty-products {
            padding: 38px;
            border-radius: 28px;
            text-align: center;
            background: rgba(146,10,182,.06);
            color: var(--gp-v24-ink);
            font-weight: 950;
        }

        .gp-product-pagination {
            margin-top: 24px;
            padding: 18px;
            border-radius: 28px;
            background: rgba(255,255,255,.70);
            border: 1px solid rgba(75,22,132,.08);
        }

        .gp-product-pagination .pagination {
            margin: 0;
        }

        .gp-save-toast {
            position: fixed;
            right: 18px;
            bottom: 92px;
            z-index: 9999;
            min-height: 48px;
            max-width: min(330px, calc(100vw - 36px));
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 18px;
            border-radius: 999px;
            background: rgba(29, 20, 48, .92);
            color: #fff;
            font-weight: 950;
            box-shadow: 0 18px 42px rgba(0,0,0,.22);
            transform: translateY(24px);
            opacity: 0;
            pointer-events: none;
            transition: transform .22s ease, opacity .22s ease;
        }

        .gp-save-toast.is-visible {
            opacity: 1;
            transform: translateY(0);
        }


        /* V25: 6 items, cleaner review button, red favorite heart */
        .gp-products-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        }

        .gp-product-actions {
            grid-template-columns: 1fr 1fr !important;
            align-items: stretch;
        }

        .gp-product-details {
            min-width: 0 !important;
            white-space: nowrap !important;
        }

        .gp-product-save {
            min-width: 0 !important;
            white-space: nowrap !important;
            color: #d7194f !important;
            border-color: rgba(215, 25, 79, .28) !important;
            background: rgba(255, 255, 255, .96) !important;
        }

        .gp-product-save .gp-heart-icon,
        .gp-saved-counter-chip > span:first-child {
            color: #e10b45 !important;
            font-family: Tahoma, Arial, sans-serif !important;
            font-size: 18px !important;
            line-height: 1 !important;
            text-shadow: 0 6px 16px rgba(225, 11, 69, .20);
        }

        .gp-product-save.is-saved {
            background: rgba(225, 11, 69, .10) !important;
            border-color: rgba(225, 11, 69, .28) !important;
            color: #d7194f !important;
        }

        .gp-product-save.is-saved .gp-heart-icon {
            color: #e10b45 !important;
        }

        .gp-product-save:hover {
            background: rgba(225, 11, 69, .08) !important;
            box-shadow: 0 14px 28px rgba(225, 11, 69, .10);
        }

        html.gp-dark-mode .gp-product-save {
            background: rgba(225, 11, 69, .10) !important;
            color: #ff6b93 !important;
            border-color: rgba(255, 107, 147, .28) !important;
        }

        html.gp-dark-mode .gp-product-save .gp-heart-icon,
        html.gp-dark-mode .gp-saved-counter-chip > span:first-child {
            color: #ff4f7c !important;
        }

