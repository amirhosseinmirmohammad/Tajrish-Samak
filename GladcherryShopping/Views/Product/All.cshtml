@model DataLayer.ViewModels.PagerViewModel.PagerViewModels<DataLayer.Models.Product>
@using MvcPager
@using System.Collections.Generic;
@{
    var gpCacheVersion = "20260606-richresult-product-microdata-clean-v78";
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpCategoryName = ViewBag.CategoryName != null ? ViewBag.CategoryName.ToString() : "محصولات سمعک";
    bool gpHasSubCategories = ViewBag.ShowSubCategories != null && (bool)ViewBag.ShowSubCategories;
    int? gpCategoryId = ViewBag.CategoryId != null ? (int?)ViewBag.CategoryId : null;

    var gpCanonicalPath = gpHasSubCategories && gpCategoryId.HasValue
        ? "/Product/All/" + gpCategoryId.Value
        : "/Product/All";

    var gpCanonicalUrl = gpBaseUrl + gpCanonicalPath;

    var gpCurrentProducts = Model != null && Model.data != null
        ? Model.data
            .Where(current => current.SiteFirstImage != null)
            .OrderByDescending(current => current.CreateDate)
            .Take(6)
            .ToList()
        : new List<DataLayer.Models.Product>();

    var gpCategories = ViewBag.Categories as IEnumerable<DataLayer.Models.Category>;
    var gpCategoriesList = gpCategories != null
        ? gpCategories.ToList()
        : new List<DataLayer.Models.Category>();

    var gpPopularProducts = ViewBag.PopularProducts as IEnumerable<DataLayer.Models.Product>;
    var gpPopularProductsList = gpPopularProducts != null
        ? gpPopularProducts.ToList()
        : gpCurrentProducts.Take(6).ToList();

    var gpSubCategories = ViewBag.SubCategories as IEnumerable<DataLayer.Models.Category>;
    var gpSubCategoriesList = gpSubCategories != null
        ? gpSubCategories.ToList()
        : new List<DataLayer.Models.Category>();

    var gpMetaDescription = "مشاهده " + gpCategoryName + " در کلینیک شنوایی و سمعک شکوه تجریش؛ بررسی مدل‌ها، افزودن به علاقه‌مندی، مشاوره تخصصی و انتخاب سمعک متناسب با تست شنوایی در تهران و تجریش.";
    var gpMetaKeywords = "سمعک، " + gpCategoryName + "، خرید سمعک، تجویز سمعک، تنظیم سمعک، سمعک دیجیتال، سمعک نامرئی، کلینیک شنوایی تجریش، تست شنوایی تهران";

    ViewBag.Title = gpHasSubCategories
        ? "انواع " + gpCategoryName + " | کلینیک شنوایی و سمعک شکوه تجریش"
        : gpCategoryName + " | کلینیک شنوایی و سمعک شکوه تجریش";

    ViewBag.CanonicalUrl = gpCanonicalUrl;
    ViewBag.MetaDescription = gpMetaDescription;
    ViewBag.MetaKeywords = gpMetaKeywords;

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Metas{
    <meta name="description" content="@gpMetaDescription" />
    <link rel="canonical" href="@gpCanonicalUrl" />
    <meta name="Keywords" content="@gpMetaKeywords" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@gpCanonicalUrl" />
    <meta property="og:description" content="@gpMetaDescription" />
    <meta property="og:site_name" content="کلینیک شنوایی و سمعک شکوه تجریش" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewBag.Title" />
    <meta name="twitter:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta name="twitter:description" content="@gpMetaDescription" />
}

@section Styles{
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "صفحه اصلی",
              "item": "https://tajrish-samak.ir/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpCategoryName))",
              "item": "@gpCanonicalUrl"
            }
          ]
        }
    </script>

    @if (!gpHasSubCategories)
    {
        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "ItemList",
              "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpCategoryName))",
              "url": "@gpCanonicalUrl",
              "numberOfItems": @gpCurrentProducts.Count(),
              "itemListElement": [
                @{
                    var gpSchemaIndex = 1;
                    var gpSchemaItems = gpCurrentProducts.Take(6).ToList();
                }
                @foreach (var item in gpSchemaItems)
                {
                    <text>{
                      "@@type": "ListItem",
                      "position": @gpSchemaIndex,
                      "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(item.PersianName))",
                      "url": "https://tajrish-samak.ir/Product/Details/@item.Id"
                    }</text>
                    if (gpSchemaIndex < gpSchemaItems.Count())
                    {
                        <text>,</text>
                    }
                    gpSchemaIndex++;
                }
              ]
            }
        </script>
    }

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "برای انتخاب سمعک مناسب از کجا شروع کنیم؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "بهترین شروع، انجام تست شنوایی و بررسی نیاز شنیداری، سبک زندگی و شرایط استفاده توسط متخصص شنوایی است."
              }
            },
            {
              "@@type": "Question",
              "name": "آیا می‌توان چند مدل سمعک را برای بررسی بعدی نگه داشت؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "در این صفحه می‌توانید محصولات مناسب را به علاقه‌مندی اضافه کنید تا هنگام تماس یا مراجعه، مقایسه سریع‌تر انجام شود."
              }
            }
          ]
        }
    </script>


    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "CollectionPage",
          "@@id": "@gpCanonicalUrl#collection",
          "url": "@gpCanonicalUrl",
          "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.Title))",
          "description": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpMetaDescription))",
          "inLanguage": "fa-IR",
          "isPartOf": {
            "@@type": "WebSite",
            "@@id": "https://tajrish-samak.ir/#website",
            "name": "کلینیک شنوایی و سمعک شکوه تجریش",
            "url": "https://tajrish-samak.ir/"
          },
          "about": [
            { "@@type": "Thing", "name": "سمعک" },
            { "@@type": "Thing", "name": "خرید سمعک" },
            { "@@type": "Thing", "name": "تجویز سمعک" },
            { "@@type": "Thing", "name": "تنظیم سمعک" },
            { "@@type": "Place", "name": "تهران" },
            { "@@type": "Place", "name": "تجریش" }
          ]
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": ["LocalBusiness", "MedicalBusiness", "MedicalClinic"],
          "@@id": "https://tajrish-samak.ir/#tajrish-samak",
          "name": "کلینیک شنوایی و سمعک شکوه تجریش",
          "url": "https://tajrish-samak.ir/",
          "telephone": ["+982122735588", "+982122735599", "+989393388985"],
          "priceRange": "$$",
          "address": {
            "@@type": "PostalAddress",
            "addressCountry": "IR",
            "addressRegion": "تهران",
            "addressLocality": "تهران",
            "streetAddress": "میدان تجریش، خیابان شهرداری، روبه‌روی سینما آستارا، پلاک ۲۱۴، ساختمان ۱۱۰"
          },
          "areaServed": [
            { "@@type": "City", "name": "تهران" },
            { "@@type": "Place", "name": "تجریش" },
            { "@@type": "Place", "name": "شمیرانات" },
            { "@@type": "Place", "name": "نیاوران" },
            { "@@type": "Place", "name": "قیطریه" },
            { "@@type": "Place", "name": "زعفرانیه" },
            { "@@type": "Place", "name": "الهیه" },
