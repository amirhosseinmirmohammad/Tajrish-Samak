    <div class="gp-favorite-toast" id="gpSaveToast" aria-live="polite">به علاقه‌مندی اضافه شد</div>
</section>

@section Scripts{
    <script>
        (function () {
            var storageKey = "gpTajrishFavoriteProducts";
            var buttons = document.querySelectorAll("[data-gp-save-product]");
            var counter = document.getElementById("gpSavedCounter");
            var toast = document.getElementById("gpSaveToast");

            function toPersianNumber(value) {
                return String(value).replace(/[0-9]/g, function (digit) {
                    return "۰۱۲۳۴۵۶۷۸۹"[digit];
                });
            }

            function readSaved() {
                try {
                    var raw = window.localStorage.getItem(storageKey);
                    var data = raw ? JSON.parse(raw) : [];
                    return Array.isArray(data) ? data : [];
                } catch (e) {
                    return [];
                }
            }

            function writeSaved(items) {
                try {
                    window.localStorage.setItem(storageKey, JSON.stringify(items));
                } catch (e) { }
            }

            function showToast(text) {
                if (!toast) {
                    return;
                }
                toast.textContent = text;
                toast.classList.add("is-visible");
                window.clearTimeout(showToast._timer);
                showToast._timer = window.setTimeout(function () {
                    toast.classList.remove("is-visible");
                }, 1700);
            }

            function updateUI() {
                var saved = readSaved();

                if (counter) {
                    counter.textContent = toPersianNumber(saved.length);
                }

                for (var i = 0; i < buttons.length; i++) {
                    var id = buttons[i].getAttribute("data-gp-save-product");
                    var isSaved = saved.some(function (item) {
                        return String(item.id) === String(id);
                    });

                    buttons[i].classList.toggle("is-saved", isSaved);
                    buttons[i].innerHTML = isSaved
                        ? '<span class="gp-heart-icon" aria-hidden="true">♥</span> علاقه‌مندی'
                        : '<span class="gp-heart-icon" aria-hidden="true">♡</span> علاقه‌مندی';
                }
            }

            for (var i = 0; i < buttons.length; i++) {
                buttons[i].addEventListener("click", function () {
                    var id = this.getAttribute("data-gp-save-product");
                    var title = this.getAttribute("data-gp-save-title") || "محصول";
                    var saved = readSaved();
                    var exists = saved.some(function (item) {
                        return String(item.id) === String(id);
                    });

                    if (exists) {
                        saved = saved.filter(function (item) {
                            return String(item.id) !== String(id);
                        });
                        writeSaved(saved);
                        showToast("از علاقه‌مندی حذف شد");
                    } else {
                        saved.push({
                            id: id,
                            title: title,
                            savedAt: new Date().toISOString()
                        });
                        writeSaved(saved);
                        showToast("به علاقه‌مندی اضافه شد");
                    }

                    updateUI();
                });
            }

            updateUI();
        })();
    </script>
}
