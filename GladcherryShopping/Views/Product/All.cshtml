<section class="gp-products-page" aria-label="جدیدترین سمعک‌ها">
    <div class="container">
        <section class="gp-products-hero" aria-label="معرفی صفحه جدیدترین سمعک‌ها">
            <div class="gp-products-hero-grid">
                <div>
                    <span class="gp-products-kicker">جدیدترین سمعک‌ها</span>
                    <h1>انواع سمعک در کلینیک شنوایی شکوه تجریش</h1>
                    <p>
                        مدل‌های جدید را ببینید، گزینه‌های مناسب را به علاقه‌مندی اضافه کنید و بعد با مشاوره تخصصی کلینیک شکوه تجریش، انتخاب نهایی را بر اساس تست شنوایی انجام دهید.
                    </p>
                    <div class="gp-products-hero-actions">
                        <a href="tel:02122735588">
                            <span aria-hidden="true">☎</span>
                            مشاوره سریع
                        </a>
                        <a href="#gp-products-grid">
                            <span aria-hidden="true">⌄</span>
                            مشاهده سمعک‌ها
                        </a>
                        <span class="gp-saved-counter-chip" id="gpSavedCounterChip">
                            <span aria-hidden="true">♡</span>
                            <b id="gpSavedCounter">۰</b>
                            علاقه‌مندی
                        </span>
                    </div>
                </div>

                <div class="gp-products-stats" aria-label="مزیت‌های صفحه">
                    <div class="gp-products-stat-card">
                        <strong>@gpCurrentProducts.Count()</strong>
                        <span>گزینه قابل بررسی</span>
                    </div>
                    <div class="gp-products-stat-card">
                        <strong>۴</strong>
                        <span>مرحله انتخاب: تست، مقایسه، ذخیره، مشاوره</span>
                    </div>
                    <div class="gp-products-stat-card">
                        <strong>۲۵+</strong>
                        <span>سال تجربه کلینیک</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="gp-products-shell">
            <aside class="gp-products-sidebar" aria-label="فیلتر و پیشنهادها">
                <form action="/Product/Filter" method="get">
                    <div class="gp-filter-card">
                        <h2>جستجوی سریع</h2>
                        <div class="gp-filter-search">
                            <input type="search" placeholder="نام مدل یا برند سمعک..." name="Title" required />
                            <button type="submit" aria-label="جستجو">⌕</button>
                        </div>
                    </div>

                    <div class="gp-filter-card">
                        <h3>دسته‌بندی سمعک</h3>
                        <ul class="gp-category-list">
                            @foreach (var category in gpCategories)
                            {
                                <li>
                                    <label>
                                        <input name="Category" type="radio" value="@category.Id" />
                                        <span>@category.PersianName</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>

                    <button type="submit" class="gp-filter-submit">اعمال فیلترها</button>
                </form>

                <div class="gp-filter-card" style="margin-top:14px;">
                    <h3>پیشنهادهای پربازدید</h3>
                    <div class="gp-side-popular">
                        @foreach (var item in gpPopularProducts)
                        {
                            <a class="gp-side-product" title="@item.PersianName" href="/Product/Details/@item.Id">
                                <img src="@item.SiteFirstImage" alt="@item.PersianName" title="@item.PersianName" loading="lazy" decoding="async" />
                                <span>
                                    <strong>@item.PersianName</strong>
                                    <span>مشاهده و بررسی</span>
                                </span>
                            </a>
                        }
                    </div>
                </div>
            </aside>

            <main class="gp-products-list-card" aria-label="لیست جدیدترین سمعک‌ها">
                <div class="gp-products-toolbar">
                    <div>
                        <h2>جدیدترین گزینه‌های قابل بررسی</h2>
                        <p>هر محصولی که مناسب بود به علاقه‌مندی اضافه کنید تا موقع تماس یا مراجعه، سریع‌تر مقایسه شود.</p>
                    </div>
                    <div class="gp-view-hints">
                        <span>علاقه‌مندی سریع</span>
                        <span>مشاوره تخصصی</span>
                        <span>سازگار با موبایل</span>
                    </div>
                </div>

                @if (gpCurrentProducts.Count() > 0)
                {
                    <div class="gp-products-grid" id="gp-products-grid">
                        @foreach (var item in gpCurrentProducts)
                        {
                            <article class="gp-seo-product-card" itemscope itemtype="https://schema.org/Product">
                                <a class="gp-seo-product-media" title="@item.PersianName" href="/Product/Details/@item.Id" itemprop="url">
                                    <img src="@item.SiteFirstImage" alt="@item.PersianName" title="@item.PersianName" loading="lazy" decoding="async" itemprop="image" />
                                    <span class="gp-product-new-badge">جدید</span>
                                </a>

                                <div class="gp-product-card-body">
                                    <h2 itemprop="name">
                                        <a title="@item.PersianName" href="/Product/Details/@item.Id">@item.PersianName</a>
                                    </h2>
                                    <p itemprop="description">
                                        مناسب برای بررسی اولیه، ذخیره در لیست انتخاب‌ها و دریافت مشاوره بر اساس تست شنوایی.
                                    </p>

                                    <div class="gp-product-card-meta">
                                        <span>تجویز تخصصی</span>
                                        <span>تنظیم دقیق</span>
                                        <span>قابل مقایسه</span>
                                    </div>

                                    <div class="gp-product-actions">
                                        <a title="@item.PersianName" class="gp-product-details" href="/Product/Details/@item.Id">
                                            بررسی
                                        </a>
                                        <button type="button" class="gp-product-save" data-gp-save-product="@item.Id" data-gp-save-title="@item.PersianName">
                                            <span class="gp-heart-icon" aria-hidden="true">♡</span>
                                            علاقه‌مندی
                                        </button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="gp-empty-products">
                        در حال حاضر محصولی برای نمایش وجود ندارد. برای مشاوره مستقیم با کلینیک تماس بگیرید.
                    </div>
                }
            </main>
        </div>

        <div class="gp-product-pagination text-center">
            <nav aria-label="صفحه‌بندی محصولات">
                @{
                    string Search = Request.QueryString["Search"];
                    string Title = Request.QueryString["Title"];
                    string Min = Request.QueryString["Min"];
                    string Max = Request.QueryString["Max"];
                    string Category = Request.QueryString["Category"];
                    string Discount = Request.QueryString["Discount"];
                }
                <ul class="pagination pagination-sm">
                    <li>@Html.Pager(6, Model.CurrentPage, Model.TotalItemCount, new RouteValueDictionary { { "Search", Search }, { "Category", Category }, { "Discount", Discount }, { "Title", Title }, { "Min", Min }, { "Max", Max } })</li>
                </ul>
            </nav>
        </div>
    </div>

    <div class="gp-save-toast" id="gpSaveToast" aria-live="polite">به علاقه‌مندی اضافه شد</div>
</section>

@section Scripts{
    <script>
        (function () {
            var storageKey = "gpTajrishFavoriteProducts";
            var buttons = document.querySelectorAll("[data-gp-save-product]");
            var counter = document.getElementById("gpSavedCounter");
            var toast = document.getElementById("gpSaveToast");

            function toPersianNumber(value) {
                return String(value).replace(/[0-9]/g, function (digit) {
                    return "۰۱۲۳۴۵۶۷۸۹"[digit];
                });
            }

            function readSaved() {
                try {
                    var raw = window.localStorage.getItem(storageKey);
                    var data = raw ? JSON.parse(raw) : [];
                    return Array.isArray(data) ? data : [];
                } catch (e) {
                    return [];
                }
            }

            function writeSaved(items) {
                try {
                    window.localStorage.setItem(storageKey, JSON.stringify(items));
                } catch (e) { }
            }

            function showToast(text) {
                if (!toast) {
                    return;
                }
                toast.textContent = text;
                toast.classList.add("is-visible");
                window.clearTimeout(showToast._timer);
                showToast._timer = window.setTimeout(function () {
                    toast.classList.remove("is-visible");
                }, 1700);
            }

            function updateUI() {
                var saved = readSaved();
                if (counter) {
                    counter.textContent = toPersianNumber(saved.length);
                }

                for (var i = 0; i < buttons.length; i++) {
                    var id = buttons[i].getAttribute("data-gp-save-product");
                    var isSaved = saved.some(function (item) {
                        return String(item.id) === String(id);
                    });

                    buttons[i].classList.toggle("is-saved", isSaved);
                    buttons[i].innerHTML = isSaved
                        ? '<span class="gp-heart-icon" aria-hidden="true">♥</span> علاقه‌مندی'
                        : '<span class="gp-heart-icon" aria-hidden="true">♡</span> علاقه‌مندی';
                }
            }

            for (var i = 0; i < buttons.length; i++) {
                buttons[i].addEventListener("click", function () {
                    var id = this.getAttribute("data-gp-save-product");
                    var title = this.getAttribute("data-gp-save-title") || "محصول";
                    var saved = readSaved();
                    var exists = saved.some(function (item) {
                        return String(item.id) === String(id);
                    });

                    if (exists) {
                        saved = saved.filter(function (item) {
                            return String(item.id) !== String(id);
                        });
                        writeSaved(saved);
                        showToast("از علاقه‌مندی حذف شد");
                    } else {
                        saved.push({
                            id: id,
                            title: title,
                            savedAt: new Date().toISOString()
                        });
                        writeSaved(saved);
                        showToast("به علاقه‌مندی اضافه شد");
                    }

                    updateUI();
                });
            }

            updateUI();
        })();
    </script>

    <script src="~/Scripts/jquery.jscrollpane.min.js"></script>
    <script>
        $(function () {
            if ($('.scroll-pane').length && $.fn.jScrollPane) {
                $('.scroll-pane').jScrollPane();
            }
        });
    </script>
}
