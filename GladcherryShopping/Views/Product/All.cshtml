            position: absolute;
            top: 14px;
            right: 14px;
            min-height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            border-radius: 999px;
            background: #d8f512;
            color: #1d1430 !important;
            font-size: 12px;
            font-weight: 1000;
            box-shadow: 0 12px 24px rgba(216,245,18,.22);
        }

        .gp-product-card-body,
        .gp-subcategory-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 17px;
        }

            .gp-product-card-body h2,
            .gp-subcategory-body h2 {
                margin: 0 0 8px;
                font-size: 17px;
                font-weight: 1000;
                line-height: 1.8 !important;
            }

                .gp-product-card-body h2 a,
                .gp-subcategory-body h2 a {
                    color: var(--gp-v26-ink) !important;
                    text-decoration: none !important;
                }

            .gp-product-card-body p,
            .gp-subcategory-body p {
                margin: 0 0 14px;
                color: var(--gp-v26-muted) !important;
                font-size: 13px;
                font-weight: 850;
                line-height: 2;
            }

        .gp-product-card-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin: auto 0 14px;
        }

            .gp-product-card-meta span {
                min-height: 30px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 10px;
                border-radius: 999px;
                background: rgba(146,10,182,.08);
                color: #6420a0 !important;
                font-size: 12px;
                font-weight: 900;
            }

        .gp-product-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .gp-product-details,
        .gp-product-favorite,
        .gp-subcategory-link {
            min-height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 17px;
            text-decoration: none !important;
            font-weight: 1000;
            transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
            white-space: nowrap;
        }

        .gp-product-details,
        .gp-subcategory-link {
            background: linear-gradient(135deg, var(--gp-v26-purple), var(--gp-v26-violet));
            color: #fff !important;
            box-shadow: 0 16px 32px rgba(146,10,182,.17);
        }

        .gp-product-favorite {
            min-width: 0;
            border: 1px solid rgba(225,11,69,.26);
            background: #fff;
            color: #d7194f !important;
            cursor: pointer;
        }

        .gp-heart-icon {
            color: var(--gp-v26-heart) !important;
            font-family: Tahoma, Arial, sans-serif !important;
            font-size: 18px !important;
            line-height: 1 !important;
            text-shadow: 0 6px 16px rgba(225,11,69,.20);
        }

        .gp-product-favorite.is-saved {
            background: rgba(225,11,69,.10) !important;
            border-color: rgba(225,11,69,.30) !important;
            color: #d7194f !important;
        }

        .gp-product-details:hover,
        .gp-product-favorite:hover,
        .gp-subcategory-link:hover {
            transform: translateY(-2px);
        }

        .gp-empty-products {
            padding: 38px;
            border-radius: 28px;
            text-align: center;
            background: rgba(146,10,182,.06);
            color: var(--gp-v26-ink);
            font-weight: 950;
        }

        .gp-product-pagination {
            margin-top: 24px;
            padding: 18px;
            border-radius: 28px;
            background: rgba(255,255,255,.70);
            border: 1px solid rgba(75,22,132,.08);
        }

            .gp-product-pagination .pagination {
                margin: 0;
            }

        .gp-favorite-toast {
            position: fixed;
            right: 18px;
            bottom: 92px;
            z-index: 9999;
            min-height: 48px;
            max-width: min(330px, calc(100vw - 36px));
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 18px;
            border-radius: 999px;
            background: rgba(29,20,48,.92);
            color: #fff;
            font-weight: 950;
            box-shadow: 0 18px 42px rgba(0,0,0,.22);
            transform: translateY(24px);
            opacity: 0;
            pointer-events: none;
            transition: transform .22s ease, opacity .22s ease;
        }

            .gp-favorite-toast.is-visible {
                opacity: 1;
                transform: translateY(0);
            }



        /* V77: brand links for product category GEO */
        .gp-product-brand-links {
            margin: 26px 0 0;
            padding: 18px;
            border-radius: 30px;
            background: radial-gradient(circle at 10% 10%, rgba(216,245,18,.16), transparent 28%), linear-gradient(135deg, rgba(146,10,182,.075), rgba(225,11,121,.045));
            border: 1px solid rgba(75,22,132,.09);
            box-shadow: 0 18px 44px rgba(74,18,107,.08);
        }

            .gp-product-brand-links h2 {
                margin: 0 0 12px;
                color: var(--gp-v26-ink) !important;
                font-size: clamp(18px, 2vw, 26px);
                font-weight: 1000;
                line-height: 1.8 !important;
                text-align: center;
            }

        .gp-product-brand-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 9px;
        }

            .gp-product-brand-grid a {
                min-height: 52px;
                display: inline-flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 8px 12px;
                border-radius: 18px;
                background: rgba(255,255,255,.78);
                border: 1px solid rgba(75,22,132,.08);
                color: #6420a0 !important;
                font-size: 12px;
                font-weight: 1000;
                text-decoration: none !important;
                text-align: center;
                line-height: 1.6;
            }

                .gp-product-brand-grid a small {
                    color: rgba(32,20,45,.58) !important;
                    font-size: 11px;
                    font-weight: 900;
                }

        html.gp-dark-mode .gp-product-brand-links {
            background: rgba(255,255,255,.055) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

        html.gp-dark-mode .gp-product-brand-grid a {
            background: rgba(255,255,255,.075) !important;
            border-color: rgba(255,255,255,.10) !important;
            color: #fff !important;
        }

            html.gp-dark-mode .gp-product-brand-grid a small {
                color: rgba(246,247,251,.68) !important;
            }

        /* V73: product category GEO internal links */
        .gp-product-geo-links {
            margin: 26px 0 0;
            padding: 18px;
            border-radius: 30px;
            background: radial-gradient(circle at 10% 10%, rgba(216,245,18,.16), transparent 28%), linear-gradient(135deg, rgba(146,10,182,.075), rgba(225,11,121,.045));
            border: 1px solid rgba(75,22,132,.09);
            box-shadow: 0 18px 44px rgba(74,18,107,.08);
        }

            .gp-product-geo-links h2 {
                margin: 0 0 12px;
                color: var(--gp-v26-ink) !important;
                font-size: clamp(18px, 2vw, 26px);
                font-weight: 1000;
                line-height: 1.8 !important;
                text-align: center;
            }

        .gp-product-geo-link-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 9px;
        }

            .gp-product-geo-link-grid a {
                min-height: 44px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 13px;
                border-radius: 999px;
                background: rgba(255,255,255,.78);
                border: 1px solid rgba(75,22,132,.08);
                color: #6420a0 !important;
                font-size: 12px;
                font-weight: 1000;
                text-decoration: none !important;
                text-align: center;
                line-height: 1.8;
            }

        html.gp-dark-mode .gp-product-geo-links {
            background: rgba(255,255,255,.055) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

        html.gp-dark-mode .gp-product-geo-link-grid a {
            background: rgba(255,255,255,.075) !important;
            border-color: rgba(255,255,255,.10) !important;
            color: #fff !important;
        }

        /* Dark mode */
        html.gp-dark-mode .gp-category-page {
            --gp-v26-ink: #f7f7fb;
            --gp-v26-muted: rgba(246,247,251,.72);
            --gp-v26-card: rgba(24,24,40,.88);
            --gp-v26-border: rgba(255,255,255,.10);
            --gp-v26-shadow: 0 24px 60px rgba(0,0,0,.20);
        }

        html.gp-dark-mode .gp-category-sidebar,
        html.gp-dark-mode .gp-category-list-card,
        html.gp-dark-mode .gp-filter-card,
        html.gp-dark-mode .gp-product-pagination {
            background: rgba(24,24,40,.90) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

        html.gp-dark-mode .gp-filter-search,
        html.gp-dark-mode .gp-category-filter-list label,
        html.gp-dark-mode .gp-side-product,
        html.gp-dark-mode .gp-category-product-card,
        html.gp-dark-mode .gp-subcategory-card {
            background: rgba(255,255,255,.07) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

            html.gp-dark-mode .gp-filter-search input[type="search"] {
                color: #fff !important;
            }

                html.gp-dark-mode .gp-filter-search input[type="search"]::placeholder {
                    color: rgba(255,255,255,.55) !important;
                }

            html.gp-dark-mode .gp-category-filter-list label,
            html.gp-dark-mode .gp-side-product strong,
            html.gp-dark-mode .gp-product-card-body h2 a,
            html.gp-dark-mode .gp-subcategory-body h2 a,
            html.gp-dark-mode .gp-category-toolbar h2,
            html.gp-dark-mode .gp-filter-card h2,
            html.gp-dark-mode .gp-filter-card h3 {
                color: #f7f7fb !important;
            }

            html.gp-dark-mode .gp-side-product span,
            html.gp-dark-mode .gp-product-card-body p,
            html.gp-dark-mode .gp-subcategory-body p,
            html.gp-dark-mode .gp-category-toolbar p {
                color: rgba(246,247,251,.72) !important;
            }

        html.gp-dark-mode .gp-category-product-media,
        html.gp-dark-mode .gp-subcategory-media {
            background: rgba(255,255,255,.88) !important;
        }

        html.gp-dark-mode .gp-product-favorite {
            background: rgba(225,11,69,.10) !important;
            color: #ff6b93 !important;
            border-color: rgba(255,107,147,.28) !important;
        }

            html.gp-dark-mode .gp-product-favorite.is-saved {
                background: rgba(255,79,124,.16) !important;
                color: #ff7ba0 !important;
                border-color: rgba(255,79,124,.34) !important;
            }

        html.gp-dark-mode .gp-heart-icon {
            color: #ff4f7c !important;
        }

        html.gp-dark-mode .gp-product-card-meta span,
        html.gp-dark-mode .gp-view-hints span {
            background: rgba(255,255,255,.09) !important;
            color: rgba(246,247,251,.88) !important;
        }

        html.gp-dark-mode .gp-empty-products {
            background: rgba(255,255,255,.08) !important;
            color: #fff !important;
        }

        @@media(max-width: 1100px) {
            .gp-category-shell {
                grid-template-columns: 1fr;
            }

            .gp-category-sidebar {
                position: relative;
                top: auto;
                order: 2;
            }

            .gp-category-list-card {
                order: 1;
            }

            .gp-category-products-grid,
            .gp-subcategory-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .gp-category-hero-grid {
                grid-template-columns: 1fr;
            }

            .gp-category-stats {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media(max-width: 768px) {
            .gp-category-hero {
                border-radius: 30px;
                padding: 26px 20px;
                text-align: center;
            }

            .gp-category-hero-actions {
                justify-content: center;
            }

            .gp-category-stats {
                grid-template-columns: 1fr;
            }

            .gp-category-shell {
                gap: 16px;
            }

            .gp-category-products-grid,
            .gp-subcategory-grid {
                grid-template-columns: 1fr;
            }

            .gp-category-toolbar {
                text-align: center;
                justify-content: center;
            }

            .gp-view-hints {
                justify-content: center;
            }

            .gp-category-sidebar,
            .gp-category-list-card {
                padding: 14px;
                border-radius: 28px;
            }

            .gp-category-product-card,
            .gp-subcategory-card {
                min-height: auto;
            }

            .gp-product-actions {
                grid-template-columns: 1fr;
            }

            .gp-product-favorite {
                width: 100%;
            }

            .gp-favorite-toast {
                left: 14px;
                right: 14px;
                bottom: 86px;
            }
        }
    </style>
}

<section class="gp-category-page" aria-label="@gpCategoryName">
    <div class="container">
        <section class="gp-category-hero" aria-label="معرفی دسته محصولات">
            <div class="gp-category-hero-grid">
                <div>
                    <span class="gp-category-kicker">دسته‌بندی سمعک</span>
                    <h1>@(gpHasSubCategories ? "انواع " + gpCategoryName : gpCategoryName)</h1>
                    <p>
                        محصولات این دسته را بررسی کنید، مدل‌های مناسب را به علاقه‌مندی اضافه کنید و برای انتخاب دقیق‌تر بر اساس تست شنوایی از مشاوره کلینیک استفاده کنید.
                    </p>
                    <div class="gp-category-hero-actions">
                        <a href="tel:02122735588">
                            <span aria-hidden="true">☎</span>
                            مشاوره سریع
                        </a>
                        <a href="#gp-category-content">
                            <span aria-hidden="true">⌄</span>
                            مشاهده گزینه‌ها
                        </a>
                        <span class="gp-favorite-counter-chip" id="gpSavedCounterChip">
                            <span aria-hidden="true">♡</span>
                            <b id="gpSavedCounter">۰</b>
                            علاقه‌مندی
                        </span>
                    </div>
                </div>

                <div class="gp-category-stats" aria-label="خلاصه دسته">
                    <div class="gp-category-stat-card">
                        <strong>@(gpHasSubCategories ? "چند" : gpCurrentProducts.Count().ToString())</strong>
                        <span>@(gpHasSubCategories ? "زیرگروه قابل بررسی" : "گزینه در این صفحه")</span>
                    </div>
                    <div class="gp-category-stat-card">
                        <strong>۴</strong>
                        <span>مرحله انتخاب: تست، مقایسه، علاقه‌مندی، مشاوره</span>
                    </div>
                    <div class="gp-category-stat-card">
                        <strong>۲۵+</strong>
                        <span>سال تجربه کلینیک</span>
                    </div>
                </div>
            </div>
        </section>

        @if (!gpHasSubCategories)
        {
            <div class="gp-category-shell" id="gp-category-content">
                <aside class="gp-category-sidebar" aria-label="فیلتر و پیشنهادها">
                    <form action="/Product/Filter" method="get">
                        <div class="gp-filter-card">
                            <h2>جستجوی سریع</h2>
                            <div class="gp-filter-search">
                                <input type="search" placeholder="نام مدل یا برند سمعک..." name="Title" required />
                                <button type="submit" aria-label="جستجو">⌕</button>
                            </div>
                        </div>

                        <div class="gp-filter-card">
                            <h3>دسته‌بندی سمعک</h3>
                            <ul class="gp-category-filter-list">
                                @if (gpCategoriesList.Count() == 0)
                                {
                                    <li>
                                        <label>
                                            <span>دسته‌بندی برای نمایش وجود ندارد.</span>
                                        </label>
                                    </li>
                                }
                                @foreach (var category in gpCategoriesList)
                                {
                                    <li>
                                        <label>
                                            <input name="Category" type="radio" value="@category.Id" />
                                            <span>@category.PersianName</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                        </div>

                        <button type="submit" class="gp-filter-submit">اعمال فیلترها</button>
                    </form>

                    <div class="gp-filter-card" style="margin-top:14px;">
                        <h3>پیشنهادهای پربازدید</h3>
                        <div class="gp-side-popular">
                            @if (gpPopularProductsList.Count() == 0)
                            {
                                <div class="gp-empty-products" style="padding:18px;border-radius:18px;">محصول پیشنهادی برای نمایش وجود ندارد.</div>
                            }
                            @foreach (var item in gpPopularProductsList)
                            {
                                <a class="gp-side-product" title="@item.PersianName" href="/Product/Details/@item.Id">
                                    <img src="@item.SiteFirstImage" alt="@item.PersianName" title="@item.PersianName" loading="lazy" decoding="async" />
                                    <span>
                                        <strong>@item.PersianName</strong>
                                        <span>مشاهده و بررسی</span>
                                    </span>
                                </a>
                            }
                        </div>
                    </div>
                </aside>

                <main class="gp-category-list-card" aria-label="محصولات دسته">
                    <div class="gp-category-toolbar">
                        <div>
                            <h2>گزینه‌های قابل بررسی در @gpCategoryName</h2>
                            <p>هر محصولی که مناسب بود به علاقه‌مندی اضافه کنید تا موقع تماس یا مراجعه سریع‌تر مقایسه شود.</p>
                        </div>
                        <div class="gp-view-hints">
                            <span>علاقه‌مندی سریع</span>
                            <span>مشاوره تخصصی</span>
                            <span>ریسپانسیو</span>
                        </div>
                    </div>

                    @if (gpCurrentProducts.Count() > 0)
                    {
                        <div class="gp-category-products-grid">
                            @foreach (var item in gpCurrentProducts)
                            {
                                <article class="gp-category-product-card">
                                    <a class="gp-category-product-media" title="@item.PersianName" href="/Product/Details/@item.Id">
                                        <img src="@item.SiteFirstImage" alt="@item.PersianName" title="@item.PersianName" loading="lazy" decoding="async" />
                                        <span class="gp-product-new-badge">جدید</span>
                                    </a>

                                    <div class="gp-product-card-body">
                                        <h2>
                                            <a title="@item.PersianName" href="/Product/Details/@item.Id">@item.PersianName</a>
                                        </h2>
                                        <p>
                                            مناسب برای بررسی اولیه، افزودن به علاقه‌مندی و دریافت مشاوره بر اساس تست شنوایی.
                                        </p>

                                        <div class="gp-product-card-meta">
                                            <span>تجویز تخصصی</span>
                                            <span>تنظیم دقیق</span>
                                            <span>قابل مقایسه</span>
                                        </div>

                                        <div class="gp-product-actions">
                                            <a title="@item.PersianName" class="gp-product-details" href="/Product/Details/@item.Id">
                                                بررسی
                                            </a>
                                            <button type="button" class="gp-product-favorite" data-gp-save-product="@item.Id" data-gp-save-title="@item.PersianName">
                                                <span class="gp-heart-icon" aria-hidden="true">♡</span>
                                                علاقه‌مندی
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="gp-empty-products">
                            در حال حاضر محصولی برای این دسته وجود ندارد. برای مشاوره مستقیم با کلینیک تماس بگیرید.
                        </div>
                    }
                </main>
            </div>

            <div class="gp-product-pagination text-center">
                <nav aria-label="صفحه‌بندی محصولات">
                    <ul class="pagination pagination-sm">
                        <li>@Html.Pager(6, Model.CurrentPage, Model.TotalItemCount)</li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <main class="gp-category-list-card" id="gp-category-content" aria-label="زیرگروه‌های دسته">
                <div class="gp-category-toolbar">
                    <div>
                        <h2>انواع @gpCategoryName</h2>
                        <p>زیرگروه مورد نظر را انتخاب کنید تا مدل‌های مرتبط و گزینه‌های قابل بررسی را ببینید.</p>
                    </div>
                    <div class="gp-view-hints">
                        <span>دسته‌بندی مرتب</span>
                        <span>انتخاب سریع</span>
                        <span>موبایل‌پسند</span>
                    </div>
                </div>

                @if (gpSubCategoriesList.Count() > 0)
                {
                    <div class="gp-subcategory-grid">
                        @foreach (var cat in gpSubCategoriesList)
                        {
                            <article class="gp-subcategory-card">
                                <a class="gp-subcategory-media" href="/Product/All/@cat.Id" title="@cat.PersianName">
                                    @if (cat.SmallImage != null)
                                    {
                                        <img src="@cat.SmallImage" alt="@cat.PersianName" title="@cat.PersianName" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/images/pransa_logo_web.png")" alt="@cat.PersianName" title="@cat.PersianName" loading="lazy" decoding="async" />
                                    }
                                    <span class="gp-subcategory-badge">دسته</span>
                                </a>
                                <div class="gp-subcategory-body">
                                    <h2>
                                        <a href="/Product/All/@cat.Id" title="@cat.PersianName">@cat.PersianName</a>
                                    </h2>
                                    <p>مشاهده محصولات این زیرگروه و بررسی گزینه‌های مناسب برای مشاوره تخصصی.</p>
                                    <a class="gp-subcategory-link" href="/Product/All/@cat.Id" title="@cat.PersianName">مشاهده محصولات</a>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="gp-empty-products">
                        فعلاً زیرگروهی برای این دسته ثبت نشده است.
                    </div>
                }
            </main>
        }
    </div>


    <div class="container">
        <section class="gp-product-geo-links" aria-label="لینک‌های مرتبط شنوایی و سمعک">
            <h2>مسیرهای مرتبط برای انتخاب بهتر سمعک</h2>
            <div class="gp-product-geo-link-grid">
                <a href="/tehran/hearing-test">تست شنوایی در تهران</a>
                <a href="/tajrish/hearing-test">تست شنوایی در تجریش</a>
                <a href="/tehran/hearing-aid">خرید سمعک در تهران</a>
                <a href="/tajrish/hearing-aid">خرید سمعک در تجریش</a>
                <a href="/tehran/hearing-aid-adjustment">تنظیم سمعک در تهران</a>
                <a href="/tajrish/hearing-aid-adjustment">تنظیم سمعک در تجریش</a>
                <a href="/niavaran/hearing-test">تست شنوایی نیاوران</a>
                <a href="/qeytarieh/hearing-test">تست شنوایی قیطریه</a>
                <a href="/zaferanieh/hearing-test">تست شنوایی زعفرانیه</a>
                <a href="/elahiyeh/hearing-test">تست شنوایی الهیه</a>
                <a href="/farmanieh/hearing-test">تست شنوایی فرمانیه</a>
            </div>
        </section>
    </div>


    <div class="container">
        <section class="gp-product-brand-links" aria-label="برندهای سمعک">
            <h2>برندهای سمعک برای بررسی و مشاوره</h2>
            <div class="gp-product-brand-grid">
                <a href="/hearing-aid-brands/widex" title="سمعک ویدکس | Widex"><span>ویدکس</span><small>Widex</small></a>
                <a href="/hearing-aid-brands/signia" title="سمعک سیگنیا | Signia"><span>سیگنیا</span><small>Signia</small></a>
                <a href="/hearing-aid-brands/oticon" title="سمعک اتیکن | Oticon"><span>اتیکن</span><small>Oticon</small></a>
                <a href="/hearing-aid-brands/phonak" title="سمعک فوناک | Phonak"><span>فوناک</span><small>Phonak</small></a>
                <a href="/hearing-aid-brands/resound" title="سمعک ریساند | ReSound"><span>ریساند</span><small>ReSound</small></a>
