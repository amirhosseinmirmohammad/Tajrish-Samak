    <style id="gp-v77-product-brand-geo-links">
        :root {
            --gp-v26-purple: #4b1684;
            --gp-v26-violet: #920ab6;
            --gp-v26-pink: #e10b79;
            --gp-v26-cyan: #0ba6b8;
            --gp-v26-lime: #d8f512;
            --gp-v26-heart: #e10b45;
            --gp-v26-ink: #20142d;
            --gp-v26-muted: rgba(32, 20, 45, .66);
            --gp-v26-card: rgba(255,255,255,.90);
            --gp-v26-border: rgba(75,22,132,.10);
            --gp-v26-shadow: 0 24px 60px rgba(74,18,107,.10);
        }

        .gp-category-page {
            direction: rtl;
            overflow: hidden;
        }

        .gp-category-hero {
            position: relative;
            margin: 22px auto 28px;
            padding: clamp(28px, 4vw, 56px);
            border-radius: 42px;
            background: radial-gradient(circle at 14% 10%, rgba(216,245,18,.25), transparent 24%), radial-gradient(circle at 88% 24%, rgba(255,255,255,.15), transparent 22%), linear-gradient(135deg, #4b1684 0%, #920ab6 54%, #e10b79 100%);
            color: #fff;
            box-shadow: 0 32px 80px rgba(74,18,107,.20);
            isolation: isolate;
            overflow: hidden;
        }

            .gp-category-hero::before,
            .gp-category-hero::after {
                content: "";
                position: absolute;
                border-radius: 999px;
                pointer-events: none;
                z-index: -1;
            }

            .gp-category-hero::before {
                width: 260px;
                height: 260px;
                left: -92px;
                top: -88px;
                background: rgba(255,255,255,.13);
                animation: gpV26Blob 10s ease-in-out infinite alternate;
            }

            .gp-category-hero::after {
                width: 330px;
                height: 330px;
                right: -128px;
                bottom: -170px;
                background: rgba(11,166,184,.22);
                animation: gpV26Blob 12s ease-in-out infinite alternate-reverse;
            }

        @@keyframes gpV26Blob {
            to {
                transform: translate3d(24px, 18px, 0) scale(1.06);
            }
        }

        .gp-category-hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(250px, .40fr);
            gap: clamp(20px, 4vw, 46px);
            align-items: center;
        }

        .gp-category-kicker {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            color: #fff !important;
            font-weight: 950;
            backdrop-filter: blur(14px);
        }

        .gp-category-hero h1 {
            margin: 16px 0 12px;
            color: #fff !important;
            font-size: clamp(30px, 4.8vw, 62px);
            font-weight: 1000;
            line-height: 1.34 !important;
            letter-spacing: -.02em;
        }

        .gp-category-hero p {
            max-width: 780px;
            margin: 0;
            color: rgba(255,255,255,.90) !important;
            font-size: clamp(14px, 1.2vw, 18px);
            font-weight: 850;
            line-height: 2.1;
        }

        .gp-category-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 24px;
        }

            .gp-category-hero-actions a,
            .gp-favorite-counter-chip {
                min-height: 48px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 0 18px;
                border-radius: 999px;
                text-decoration: none !important;
                font-weight: 950;
            }

                .gp-category-hero-actions a:first-child {
                    background: #fff;
                    color: #4b1684 !important;
                    box-shadow: 0 18px 38px rgba(0,0,0,.14);
                }

                .gp-category-hero-actions a:nth-child(2),
                .gp-favorite-counter-chip {
                    background: rgba(255,255,255,.13);
                    border: 1px solid rgba(255,255,255,.24);
                    color: #fff !important;
                }

                    .gp-favorite-counter-chip > span:first-child {
                        color: #ff3f72 !important;
                        font-size: 18px;
                        text-shadow: 0 6px 18px rgba(255, 63, 114, .25);
                    }

        .gp-category-stats {
            display: grid;
            gap: 12px;
        }

        .gp-category-stat-card {
            min-height: 92px;
            padding: 18px;
            border-radius: 28px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            backdrop-filter: blur(14px);
        }

            .gp-category-stat-card strong {
                display: block;
                color: #fff !important;
                font-size: 28px;
                font-weight: 1000;
                line-height: 1;
            }

            .gp-category-stat-card span {
                display: block;
                margin-top: 8px;
                color: rgba(255,255,255,.82) !important;
                font-weight: 850;
            }

        .gp-category-shell {
            display: grid;
            grid-template-columns: minmax(250px, 300px) minmax(0, 1fr);
            gap: 22px;
            align-items: start;
            margin-bottom: 40px;
        }

        .gp-category-sidebar,
        .gp-category-list-card,
        .gp-subcategory-card {
            border-radius: 34px;
            background: var(--gp-v26-card);
            border: 1px solid var(--gp-v26-border);
            box-shadow: var(--gp-v26-shadow);
            backdrop-filter: blur(18px);
        }

        .gp-category-sidebar {
            position: sticky;
            top: 16px;
            padding: 18px;
        }

        .gp-filter-card {
            padding: 16px;
            border-radius: 26px;
            background: rgba(255,255,255,.62);
            border: 1px solid rgba(75,22,132,.08);
            margin-bottom: 14px;
        }

            .gp-filter-card h2,
            .gp-filter-card h3 {
                margin: 0 0 12px;
                color: var(--gp-v26-ink) !important;
                font-size: 16px;
                font-weight: 1000;
                line-height: 1.7 !important;
            }

        .gp-filter-search {
            display: flex;
            align-items: center;
            min-height: 48px;
            border-radius: 18px;
            overflow: hidden;
            background: #fff;
            border: 1px solid rgba(75,22,132,.10);
        }

            .gp-filter-search input[type="search"] {
                flex: 1;
                min-width: 0;
                height: 48px;
                border: 0 !important;
                outline: 0 !important;
                padding: 0 14px;
                background: transparent;
                color: var(--gp-v26-ink);
                font-weight: 850;
            }

            .gp-filter-search button {
                width: 48px;
                height: 48px;
                border: 0;
                background: linear-gradient(135deg, var(--gp-v26-purple), var(--gp-v26-violet));
                color: #fff;
                font-weight: 1000;
            }

        .gp-category-filter-list {
            max-height: 330px;
            overflow: auto;
            padding: 0;
            margin: 0;
            list-style: none;
        }

            .gp-category-filter-list li {
                margin-bottom: 8px;
            }

            .gp-category-filter-list label {
                width: 100%;
                min-height: 42px;
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 8px 10px;
                border-radius: 16px;
                background: rgba(255,255,255,.62);
                border: 1px solid rgba(75,22,132,.08);
                color: rgba(32,20,45,.78);
                font-weight: 850;
                cursor: pointer;
                transition: transform .18s ease, border-color .18s ease, background .18s ease;
            }

                .gp-category-filter-list label:hover {
                    transform: translateY(-2px);
                    border-color: rgba(146,10,182,.22);
                    background: #fff;
                }

            .gp-category-filter-list input {
                accent-color: var(--gp-v26-violet);
            }

        .gp-filter-submit {
            width: 100%;
            min-height: 48px;
            border: 0;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--gp-v26-purple), var(--gp-v26-violet), var(--gp-v26-pink));
            color: #fff;
            font-weight: 1000;
            box-shadow: 0 16px 32px rgba(146,10,182,.18);
        }

        .gp-side-popular {
            display: grid;
            gap: 10px;
        }

        .gp-side-product {
            display: grid;
            grid-template-columns: 62px minmax(0, 1fr);
            gap: 10px;
            align-items: center;
            padding: 9px;
            border-radius: 18px;
            background: rgba(255,255,255,.65);
            border: 1px solid rgba(75,22,132,.08);
            text-decoration: none !important;
            transition: transform .18s ease, background .18s ease;
        }

            .gp-side-product:hover {
                transform: translateY(-2px);
                background: #fff;
            }

            .gp-side-product img {
                width: 62px;
                height: 62px;
                border-radius: 16px;
                object-fit: contain;
                background: #fff;
            }

            .gp-side-product strong {
                display: block;
                color: var(--gp-v26-ink) !important;
                font-size: 13px;
                font-weight: 950;
                line-height: 1.8;
            }

            .gp-side-product span {
                display: block;
                color: var(--gp-v26-muted) !important;
                font-size: 12px;
                font-weight: 850;
            }

        .gp-category-list-card {
            padding: clamp(16px, 2.2vw, 26px);
        }

        .gp-category-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

            .gp-category-toolbar h2 {
                margin: 0;
                color: var(--gp-v26-ink) !important;
                font-size: clamp(22px, 2.4vw, 34px);
                font-weight: 1000;
                line-height: 1.5 !important;
            }

            .gp-category-toolbar p {
                margin: 4px 0 0;
                color: var(--gp-v26-muted) !important;
                font-weight: 850;
                line-height: 1.9;
            }

        .gp-view-hints {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

            .gp-view-hints span {
                min-height: 34px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 11px;
                border-radius: 999px;
                background: rgba(146,10,182,.08);
                color: #6420a0 !important;
                font-weight: 900;
                font-size: 12px;
            }

        .gp-category-products-grid,
        .gp-subcategory-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .gp-category-product-card,
        .gp-subcategory-card {
            position: relative;
            display: flex;
            flex-direction: column;
            min-height: 390px;
            border-radius: 30px;
            background: #fff;
            border: 1px solid rgba(75,22,132,.08);
            box-shadow: 0 18px 42px rgba(74,18,107,.08);
            overflow: hidden;
            transition: transform .22s cubic-bezier(.2,.8,.2,1), box-shadow .22s ease;
        }

            .gp-category-product-card:hover,
            .gp-subcategory-card:hover {
                transform: translateY(-7px);
                box-shadow: 0 30px 72px rgba(74,18,107,.15);
            }

        .gp-category-product-media,
