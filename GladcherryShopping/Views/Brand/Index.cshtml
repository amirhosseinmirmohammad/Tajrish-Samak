@model DataLayer.ViewModels.PagerViewModel.PagerViewModels<DataLayer.Models.Product>
@using MvcPager
@using System;
@using System.Linq;
@using System.Web;
@* richresult-brand-microdata-clean-v79: Product microdata removed from brand listing cards. *@
@{
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpIsBrandList = ViewBag.IsBrandList != null && (bool)ViewBag.IsBrandList;
    var gpBrandSlug = ViewBag.BrandSlug != null ? ViewBag.BrandSlug.ToString() : "";
    var gpBrandFa = ViewBag.BrandPersianName != null ? ViewBag.BrandPersianName.ToString() : "برندهای سمعک";
    var gpBrandEn = ViewBag.BrandEnglishName != null ? ViewBag.BrandEnglishName.ToString() : "Hearing Aid Brands";
    var gpCanonicalUrl = gpIsBrandList
        ? gpBaseUrl + "/hearing-aid-brands"
        : gpBaseUrl + "/hearing-aid-brands/" + gpBrandSlug;

    var gpTitle = gpIsBrandList
        ? "برندهای سمعک | بررسی برندها در کلینیک شکوه تجریش"
        : "سمعک " + gpBrandFa + " | بررسی " + gpBrandEn + " در تهران و تجریش";

    var gpMetaDesc = gpIsBrandList
        ? "بررسی برندهای سمعک، مقایسه اولیه گزینه‌ها و دریافت مشاوره تخصصی خرید و تنظیم سمعک در کلینیک شنوایی و سمعک شکوه تجریش."
        : "بررسی سمعک " + gpBrandFa + " (" + gpBrandEn + ")، مشاهده مدل‌های موجود، مشاوره خرید، تجویز و تنظیم سمعک در کلینیک شنوایی و سمعک شکوه تجریش در تهران و تجریش.";

    var gpProducts = Model != null && Model.data != null
        ? Model.data.ToList()
        : new List<DataLayer.Models.Product>();

    var gpBrandLinks = ViewBag.BrandLinks as IEnumerable<Tuple<string, string, string>>;
    var gpBrandLinksList = gpBrandLinks != null ? gpBrandLinks.ToList() : new List<Tuple<string, string, string>>();

    ViewBag.Title = gpTitle;
    ViewBag.CanonicalUrl = gpCanonicalUrl;
    ViewBag.MetaDescription = gpMetaDesc;
    ViewBag.MetaKeywords = gpIsBrandList
        ? "برندهای سمعک، خرید سمعک، سمعک دیجیتال، سمعک نامرئی، کلینیک شنوایی تجریش"
        : "سمعک " + gpBrandFa + "، " + gpBrandEn + "، خرید سمعک " + gpBrandFa + "، تنظیم سمعک، کلینیک شنوایی تجریش";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Metas{
    <meta name="description" content="@gpMetaDesc" />
    <link rel="canonical" href="@gpCanonicalUrl" />
    <meta name="Keywords" content="@ViewBag.MetaKeywords" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:title" content="@gpTitle" />
    <meta property="og:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@gpCanonicalUrl" />
    <meta property="og:description" content="@gpMetaDesc" />
    <meta property="og:site_name" content="کلینیک شنوایی و سمعک شکوه تجریش" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@gpTitle" />
    <meta name="twitter:image" content="https://tajrish-samak.ir/images/logo_purple.webp" />
    <meta name="twitter:description" content="@gpMetaDesc" />
}

@section Styles{
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "صفحه اصلی",
              "item": "https://tajrish-samak.ir/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "برندهای سمعک",
              "item": "https://tajrish-samak.ir/hearing-aid-brands"
            }
            @if (!gpIsBrandList)
            {
                <text>,
                {
                  "@@type": "ListItem",
                  "position": 3,
                  "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandFa))",
                  "item": "@gpCanonicalUrl"
                }</text>
            }
          ]
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "CollectionPage",
          "@@id": "@gpCanonicalUrl#brand-page",
          "url": "@gpCanonicalUrl",
          "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpTitle))",
          "description": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpMetaDesc))",
          "inLanguage": "fa-IR",
          "isPartOf": {
            "@@type": "WebSite",
            "@@id": "https://tajrish-samak.ir/#website",
            "name": "کلینیک شنوایی و سمعک شکوه تجریش",
            "url": "https://tajrish-samak.ir/"
          },
          "about": [
            { "@@type": "Thing", "name": "سمعک" },
            { "@@type": "Thing", "name": "خرید سمعک" },
            { "@@type": "Thing", "name": "تنظیم سمعک" },
            { "@@type": "Brand", "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandEn))", "alternateName": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandFa))" },
            { "@@type": "Place", "name": "تهران" },
            { "@@type": "Place", "name": "تجریش" }
          ]
        }
    </script>

    @if (!gpIsBrandList)
    {
        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "Brand",
              "@@id": "@gpCanonicalUrl#brand",
              "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandEn))",
              "alternateName": "@Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandFa))",
              "url": "@gpCanonicalUrl"
            }
        </script>

        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "ItemList",
              "name": "مدل‌های @Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandFa))",
              "url": "@gpCanonicalUrl",
              "numberOfItems": @gpProducts.Count(),
              "itemListElement": [
                @{
                    var gpIndex = 1;
                }
                @foreach (var item in gpProducts)
                {
                    <text>{
                      "@@type": "ListItem",
                      "position": @gpIndex,
                      "name": "@Html.Raw(HttpUtility.JavaScriptStringEncode(item.PersianName))",
                      "url": "https://tajrish-samak.ir/Product/Details/@item.Id"
                    }</text>
                    if (gpIndex < gpProducts.Count())
                    {
                        <text>,</text>
                    }
                    gpIndex++;
                }
              ]
            }
        </script>
    }

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": ["LocalBusiness", "MedicalBusiness", "MedicalClinic"],
          "@@id": "https://tajrish-samak.ir/#tajrish-samak",
          "name": "کلینیک شنوایی و سمعک شکوه تجریش",
          "url": "https://tajrish-samak.ir/",
          "telephone": ["+982122735588", "+982122735599", "+989393388985"],
          "priceRange": "$$",
          "address": {
            "@@type": "PostalAddress",
            "addressCountry": "IR",
            "addressRegion": "تهران",
            "addressLocality": "تهران",
            "streetAddress": "میدان تجریش، خیابان شهرداری، روبه‌روی سینما آستارا، پلاک ۲۱۴، ساختمان ۱۱۰"
          },
          "areaServed": [
            { "@@type": "City", "name": "تهران" },
            { "@@type": "Place", "name": "تجریش" },
            { "@@type": "Place", "name": "نیاوران" },
            { "@@type": "Place", "name": "قیطریه" },
            { "@@type": "Place", "name": "زعفرانیه" },
            { "@@type": "Place", "name": "الهیه" },
            { "@@type": "Place", "name": "فرمانیه" }
          ],
          "medicalSpecialty": ["Audiology", "Hearing Aid Fitting", "Hearing Test"]
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "برای انتخاب سمعک @Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandFa)) از کجا شروع کنیم؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "شروع درست، انجام تست شنوایی و بررسی نیاز فردی، شدت کم‌شنوایی، سبک زندگی و امکان تنظیم سمعک توسط متخصص شنوایی است."
              }
            },
            {
              "@@type": "Question",
              "name": "آیا همه مدل‌های @Html.Raw(HttpUtility.JavaScriptStringEncode(gpBrandFa)) برای همه افراد مناسب هستند؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "خیر. مناسب بودن مدل سمعک به نتیجه تست شنوایی، فرم گوش، نیاز شنیداری و شرایط استفاده روزمره بستگی دارد."
              }
            },
            {
              "@@type": "Question",
              "name": "آیا شکوه تجریش نمایندگی رسمی این برند است؟",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "این صفحه برای معرفی، بررسی و مشاوره انتخاب سمعک است و ادعای نمایندگی رسمی برندها فقط در صورت اعلام صریح و مستند در سایت معتبر است."
              }
            }
          ]
        }
    </script>

    <style id="gp-v77-brand-geo-seo">
        .gp-brand-page {
            direction: rtl;
            overflow: hidden;
        }

        .gp-brand-hero {
            margin: 24px auto 28px;
            padding: clamp(28px, 4vw, 56px);
            border-radius: 42px;
            background: radial-gradient(circle at 12% 10%, rgba(216,245,18,.22), transparent 25%), linear-gradient(135deg, #4b1684, #920ab6 56%, #e10b79);
            box-shadow: 0 32px 80px rgba(74,18,107,.20);
            color: #fff;
            text-align: right;
        }

        .gp-brand-kicker {
            display: inline-flex;
            min-height: 38px;
            align-items: center;
            justify-content: center;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.22);
            color: #fff !important;
            font-weight: 950;
        }

        .gp-brand-hero h1 {
            margin: 16px 0 12px;
            color: #fff !important;
            font-size: clamp(30px, 4.6vw, 60px);
            font-weight: 1000;
            line-height: 1.35 !important;
        }

        .gp-brand-hero p {
            max-width: 860px;
            margin: 0;
            color: rgba(255,255,255,.90) !important;
            font-size: 16px;
            font-weight: 850;
            line-height: 2.1;
        }

        .gp-brand-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 24px;
        }

            .gp-brand-actions a {
                min-height: 48px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 18px;
                border-radius: 999px;
                text-decoration: none !important;
                font-weight: 1000;
            }

                .gp-brand-actions a:first-child {
                    background: #fff;
                    color: #4b1684 !important;
                }

                .gp-brand-actions a:nth-child(2) {
                    background: rgba(255,255,255,.14);
                    color: #fff !important;
                    border: 1px solid rgba(255,255,255,.24);
                }

        .gp-brand-card {
            border-radius: 34px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(75,22,132,.10);
            box-shadow: 0 24px 60px rgba(74,18,107,.10);
            padding: clamp(16px, 2.2vw, 28px);
            margin-bottom: 26px;
        }

            .gp-brand-card h2 {
                margin: 0 0 12px;
                color: #20142d !important;
                font-size: clamp(22px, 2.3vw, 34px);
                font-weight: 1000;
                line-height: 1.6 !important;
            }

            .gp-brand-card p,
            .gp-brand-card li {
                color: rgba(32,20,45,.70) !important;
                font-size: 15px;
                font-weight: 850;
                line-height: 2.15;
            }

        .gp-brand-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }

            .gp-brand-grid a {
                min-height: 92px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 6px;
                border-radius: 24px;
                background: radial-gradient(circle at 15% 10%, rgba(216,245,18,.18), transparent 28%), rgba(146,10,182,.065);
                border: 1px solid rgba(75,22,132,.10);
                text-decoration: none !important;
                color: #4b1684 !important;
                font-weight: 1000;
                text-align: center;
            }

                .gp-brand-grid a small {
                    color: rgba(32,20,45,.58);
                    font-size: 12px;
                    font-weight: 900;
                }

        .gp-brand-products {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .gp-brand-product {
            border-radius: 28px;
            background: #fff;
            border: 1px solid rgba(75,22,132,.09);
            box-shadow: 0 18px 42px rgba(74,18,107,.08);
            overflow: hidden;
        }

            .gp-brand-product a {
                text-decoration: none !important;
            }

        .gp-brand-product-media {
            height: 188px;
            display: grid;
            place-items: center;
            padding: 18px;
            background: linear-gradient(135deg, #fff, #fbf7ff);
        }

            .gp-brand-product-media img {
                max-width: 100%;
                max-height: 150px;
                object-fit: contain;
            }

        .gp-brand-product-body {
            padding: 16px;
        }

            .gp-brand-product-body h2 {
                margin: 0 0 8px;
                font-size: 17px;
                font-weight: 1000;
                line-height: 1.8 !important;
            }

                .gp-brand-product-body h2 a {
                    color: #20142d !important;
                }

            .gp-brand-product-body p {
                margin: 0 0 12px;
                color: rgba(32,20,45,.66) !important;
                font-size: 13px;
                font-weight: 850;
                line-height: 2;
            }

        .gp-brand-product-btn {
            min-height: 44px;
            display: inline-flex;
            width: 100%;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: linear-gradient(135deg, #4b1684, #920ab6);
            color: #fff !important;
            font-weight: 1000;
        }

        .gp-brand-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 9px;
        }

            .gp-brand-links a {
                min-height: 44px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 13px;
                border-radius: 999px;
                background: rgba(146,10,182,.075);
                border: 1px solid rgba(75,22,132,.08);
                color: #6420a0 !important;
                font-size: 12px;
                font-weight: 1000;
                text-decoration: none !important;
                text-align: center;
                line-height: 1.8;
            }

        .gp-brand-empty {
            padding: 28px;
            border-radius: 24px;
            background: rgba(146,10,182,.06);
            color: #20142d;
            font-weight: 950;
            line-height: 2;
            text-align: center;
        }

        html.gp-dark-mode .gp-brand-card,
        html.gp-dark-mode .gp-brand-product {
            background: rgba(24,24,40,.90) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

            html.gp-dark-mode .gp-brand-card h2,
            html.gp-dark-mode .gp-brand-product-body h2 a {
                color: #fff !important;
            }

            html.gp-dark-mode .gp-brand-card p,
            html.gp-dark-mode .gp-brand-card li,
            html.gp-dark-mode .gp-brand-product-body p {
                color: rgba(246,247,251,.72) !important;
            }

        html.gp-dark-mode .gp-brand-grid a,
        html.gp-dark-mode .gp-brand-links a {
            background: rgba(255,255,255,.075) !important;
            border-color: rgba(255,255,255,.10) !important;
            color: #fff !important;
        }

        @@media(max-width: 1100px) {
            .gp-brand-products {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media(max-width: 768px) {
            .gp-brand-hero {
                border-radius: 30px;
                padding: 26px 20px;
                text-align: center;
            }

            .gp-brand-actions {
                justify-content: center;
            }

            .gp-brand-products {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section class="gp-brand-page">
    <div class="container">
        <section class="gp-brand-hero">
            <span class="gp-brand-kicker">برندهای سمعک</span>
            @if (gpIsBrandList)
            {
                <h1>بررسی برندهای سمعک در شکوه تجریش</h1>
                <p>برای انتخاب سمعک، فقط نام برند کافی نیست. نتیجه تست شنوایی، شدت کم‌شنوایی، سبک زندگی، فرم گوش و امکان تنظیم دقیق باید کنار هم بررسی شوند.</p>
            }
            else
            {
                <h1>سمعک @gpBrandFa <small style="font-size:.55em;color:rgba(255,255,255,.78);">(@gpBrandEn)</small></h1>
                <p>اگر درباره سمعک @gpBrandFa جستجو می‌کنید، این صفحه برای بررسی اولیه، مشاهده مدل‌های مرتبط و شروع مشاوره تخصصی خرید، تجویز و تنظیم سمعک در تهران و تجریش آماده شده است.</p>
            }

            <div class="gp-brand-actions">
                <a href="tel:02122735588">تماس برای مشاوره</a>
                <a href="/tehran/hearing-test">شروع با تست شنوایی</a>
            </div>
        </section>

        @if (gpIsBrandList)
        {
            <section class="gp-brand-card">
                <h2>انتخاب برند سمعک</h2>
                <p>برند مورد نظر را انتخاب کنید تا صفحه بررسی همان برند، مدل‌های مرتبط داخل سایت و مسیر مشاوره تخصصی را ببینید.</p>
                <div class="gp-brand-grid">
                    @foreach (var brandLink in gpBrandLinksList)
                    {
                        <a href="/hearing-aid-brands/@brandLink.Item1" title="سمعک @brandLink.Item2 | @brandLink.Item3">
                            <span>@brandLink.Item2</span>
                            <small>@brandLink.Item3</small>
                        </a>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="gp-brand-card">
                <h2>قبل از خرید سمعک @gpBrandFa چه چیزهایی باید بررسی شود؟</h2>
                <p>برای انتخاب سمعک @gpBrandFa، ابتدا باید تست شنوایی انجام شود و سپس مدل مناسب بر اساس نوع کم‌شنوایی، نیاز روزانه، محیط‌های شنیداری، اندازه و فرم گوش و امکان تنظیم دقیق انتخاب شود.</p>
                <ul>
                    <li>نتیجه تست شنوایی و شدت کم‌شنوایی</li>
                    <li>نیاز فرد در خانه، محیط کار، محیط شلوغ و مکالمه تلفنی</li>
                    <li>مناسب بودن مدل پشت گوشی، داخل گوشی، نامرئی یا ریک</li>
                    <li>امکان تنظیم، پیگیری و آموزش استفاده از سمعک</li>
                </ul>
            </section>

            <section class="gp-brand-card">
                <h2>مدل‌های مرتبط با @gpBrandFa در سایت</h2>
                @if (gpProducts.Count() > 0)
                {
                    <div class="gp-brand-products">
                        @foreach (var item in gpProducts)
                        {
                            <article class="gp-brand-product">
                                <a class="gp-brand-product-media" href="/Product/Details/@item.Id" title="@item.PersianName">
                                    <img src="@item.SiteFirstImage" alt="@item.PersianName" title="@item.PersianName" loading="lazy" decoding="async" />
                                </a>
                                <div class="gp-brand-product-body">
                                    <h2>
                                        <a href="/Product/Details/@item.Id" title="@item.PersianName">@item.PersianName</a>
                                    </h2>
                                    <p>برای بررسی مشخصات، مقایسه و دریافت مشاوره تخصصی انتخاب سمعک.</p>
                                    <a class="gp-brand-product-btn" href="/Product/Details/@item.Id">بررسی</a>
                                </div>
                            </article>
                        }
                    </div>

                    <div style="margin-top:20px;text-align:center;">
                        <ul class="pagination pagination-sm">
                            <li>@Html.Pager(9, Model.CurrentPage, Model.TotalItemCount)</li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="gp-brand-empty">
                        فعلاً محصولی از این برند داخل سایت نمایش داده نمی‌شود، اما برای بررسی موجودی، مدل‌های جایگزین یا مشاوره انتخاب سمعک می‌توانید با کلینیک تماس بگیرید.
                    </div>
                }
            </section>
        }

        <section class="gp-brand-card">
            <h2>مسیرهای مرتبط برای انتخاب بهتر</h2>
            <div class="gp-brand-links">
                <a href="/tehran/hearing-test">تست شنوایی در تهران</a>
                <a href="/tajrish/hearing-test">تست شنوایی در تجریش</a>
                <a href="/tehran/hearing-aid">خرید سمعک در تهران</a>
                <a href="/tajrish/hearing-aid">خرید سمعک در تجریش</a>
                <a href="/tehran/hearing-aid-adjustment">تنظیم سمعک در تهران</a>
                <a href="/tajrish/hearing-aid-adjustment">تنظیم سمعک در تجریش</a>
