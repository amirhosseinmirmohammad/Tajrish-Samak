@if (blogs.Count() > 0)
{
    <section class="gp-magazine-section" aria-label="مجله کلینیک شنوایی">
        <div class="container">
            <div class="gp-magazine-head">
                <span class="gp-section-eyebrow">مجله کلینیک</span>
                <h2>رشد آگاهی شنوایی از همین‌جا شروع می‌شود.</h2>
                <p>راهنماهای ساده و کاربردی درباره تست شنوایی، انتخاب سمعک، مراقبت، تنظیم و تجربه شنیدن بهتر.</p>
            </div>

            <div class="gp-magazine-grid">
                @foreach (var item in blogs.Take(3).ToList())
                {
                    var ig = item.Images.Where(current => current.Extension.Contains("jpeg") || current.Extension.Contains("gif") || current.Extension.Contains("png") || current.Extension.Contains("jpg") || current.Extension.Contains("webp")).FirstOrDefault();
                    var vd = item.Images.Where(current => current.Extension.Contains("mp4") || current.Extension.Contains("mpeg") || current.Extension.Contains("wmv")).FirstOrDefault();
                    <article class="gp-magazine-card">
                        <a class="gp-magazine-media" hreflang="fa-IR" title="@item.Title | کلینیک شنوایی و سمعک شکوه تجریش" href="/blog/@item.Id/@item.SefUrl">
                            @if (ig != null)
                            {
                                string img = ig.FullPath;
                                <img src="@img" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" />
                            }
                            else if (vd != null)
                            {
                                string vid = vd.FullPath;
                                <video src="@vid" muted playsinline preload="metadata"></video>
                            }
                            else
                            {
                                <span class="gp-magazine-fallback" aria-hidden="true">
                                    <b>مجله</b>
                                    <small>شنوایی و سمعک</small>
                                </span>
                            }
                            <span class="gp-magazine-floating-tag">مقاله</span>
                        </a>

                        <div class="gp-magazine-content">
                            <div class="gp-magazine-meta">
                                <span>@GladCherryShopping.Helpers.FunctionsHelper.GetPersianDateTime((DateTime)item.CreateDate, false, false)</span>
                                <span>@item.Survey بازدید</span>
                            </div>
                            <h3>
                                <a hreflang="fa-IR" title="@item.Title | کلینیک شنوایی و سمعک شکوه تجریش" href="/blog/@item.Id/@item.SefUrl">@item.Title</a>
                            </h3>
                            <p>@GladCherryShopping.Helpers.FunctionsHelper.Truncate(item.ShortDesc, 90)</p>
                            <a class="gp-magazine-read" hreflang="fa-IR" href="/blog/@item.Id/@item.SefUrl">
                                ادامه مطلب
                                <span aria-hidden="true">←</span>
                            </a>
                        </div>
                    </article>
                }
            </div>

            @if (gpPopularBlogs != null && gpPopularBlogs.Count() > 0)
            {
                <div class="gp-popular-articles" aria-label="پرطرفدارترین مقاله‌های کلینیک">
                    <div class="gp-popular-titlebar">
                        <span>پرطرفدارترین‌ها</span>
                        <p>۴ مقاله پربازدید با چیدمان جمع‌وجور و خوانا.</p>
                    </div>

                    <div class="gp-popular-grid">
                        @{ var gpPopularIndex = 0; }
                        @foreach (var item in gpPopularBlogs.ToList())
                        {
                            var gpPopularClass = gpPopularIndex == 1 ? "gp-popular-card is-featured" : "gp-popular-card";
                            <article class="@gpPopularClass">
                                @if (gpPopularIndex == 1)
                                {
                                    <span class="gp-popular-recommended">پیشنهادی</span>
                                }
                                <div class="gp-popular-card-head">
                                    <span class="gp-popular-views">@item.Survey بازدید</span>
                                    <span class="gp-popular-rank">@((gpPopularIndex + 1).ToString("00"))</span>
                                </div>
                                <h3>
                                    <a hreflang="fa-IR" title="@item.Title | کلینیک شنوایی و سمعک شکوه تجریش" href="/blog/@item.Id/@item.SefUrl">@item.Title</a>
                                </h3>
                                <p>@GladCherryShopping.Helpers.FunctionsHelper.Truncate(item.ShortDesc, 72)</p>
                                <a class="gp-popular-read" hreflang="fa-IR" href="/blog/@item.Id/@item.SefUrl">
                                    مطالعه مقاله
                                    <span aria-hidden="true">←</span>
                                </a>
                            </article>
                            gpPopularIndex++;
                        }
                    </div>
                </div>
            }

            <div class="gp-magazine-action">
                <a href="/blog/all" class="gp-magazine-all-link">
                    مشاهده همه مقالات
                    <span aria-hidden="true">←</span>
                </a>
            </div>
        </div>
    </section>
}

@section Scripts{
    <script>
        $(document).ready(function () {
            $("#myModal").modal();
        });


        (function () {
            var sliders = document.querySelectorAll("[data-gp-auto-slider]");
            if (!sliders || !sliders.length) {
                return;
            }

            function getSlides(slider) {
                return slider.querySelectorAll(".gp-auto-slide");
            }

            function getActiveIndex(slides) {
                for (var i = 0; i < slides.length; i++) {
                    if (slides[i].classList.contains("is-active")) {
                        return i;
                    }
                }
                return 0;
            }

            function goToSlide(slider, targetIndex) {
                var slides = getSlides(slider);
                if (!slides || slides.length <= 1) {
                    return;
                }

                var dots = slider.querySelectorAll(".gp-v8-slider-dots button, .gp-v10-slider-dots button");
                var activeIndex = getActiveIndex(slides);
                var nextIndex = (targetIndex + slides.length) % slides.length;

                if (activeIndex === nextIndex) {
                    return;
                }

                for (var i = 0; i < slides.length; i++) {
                    slides[i].classList.remove("is-active");
                    slides[i].classList.remove("is-leaving");
                }

                slides[activeIndex].classList.add("is-leaving");
                slides[nextIndex].classList.add("is-active");

                for (var d = 0; d < dots.length; d++) {
                    dots[d].classList.toggle("is-active", d === nextIndex);
                }

                window.setTimeout(function () {
                    if (slides[activeIndex]) {
                        slides[activeIndex].classList.remove("is-leaving");
                    }
                }, 750);
            }

            for (var s = 0; s < sliders.length; s++) {
                (function (slider) {
                    var startX = 0;
                    var startY = 0;
                    var moved = false;
                    var threshold = 38;

                    function onStart(x, y) {
                        startX = x;
                        startY = y;
                        moved = false;
                        slider.classList.add("is-dragging");
                    }

                    function onEnd(x, y) {
                        slider.classList.remove("is-dragging");

                        var dx = x - startX;
                        var dy = y - startY;
                        var distance = Math.max(Math.abs(dx), Math.abs(dy));

                        if (distance < threshold) {
                            return;
                        }

                        moved = true;
                        var slides = getSlides(slider);
                        var current = getActiveIndex(slides);

                        if (Math.abs(dy) >= Math.abs(dx)) {
                            goToSlide(slider, current + (dy < 0 ? 1 : -1));
                        } else {
                            goToSlide(slider, current + (dx < 0 ? 1 : -1));
                        }
                    }

                    slider.addEventListener("touchstart", function (event) {
                        if (event.touches && event.touches.length) {
                            onStart(event.touches[0].clientX, event.touches[0].clientY);
                        }
                    }, { passive: true });

                    slider.addEventListener("touchend", function (event) {
                        if (event.changedTouches && event.changedTouches.length) {
                            onEnd(event.changedTouches[0].clientX, event.changedTouches[0].clientY);
                        }
                    }, { passive: true });

                    slider.addEventListener("mousedown", function (event) {
                        if (event.button !== 0) {
                            return;
                        }
                        onStart(event.clientX, event.clientY);

                        function upHandler(upEvent) {
                            document.removeEventListener("mouseup", upHandler);
                            onEnd(upEvent.clientX, upEvent.clientY);
                        }

                        document.addEventListener("mouseup", upHandler);
                    });

                    slider.addEventListener("click", function (event) {
                        if (moved) {
                            event.preventDefault();
                            event.stopPropagation();
                            moved = false;
                        }
                    }, true);
                })(sliders[s]);
            }
        })();

    </script>
}
