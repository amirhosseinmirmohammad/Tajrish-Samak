@using System.Data.Entity;
@{
    GladcherryShopping.Models.ApplicationDbContext content = new GladcherryShopping.Models.ApplicationDbContext();
    var gpCacheVersion = "20260603-tajrish-v23-bottomnav-darkfix";
}
@{
    ViewBag.Title = "کلینیک شنوایی و سمعک شکوه تجریش ، آزمایشات شنوایی و تجویز سمعک";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //string twitter = "@TajrishSamak";
    //string facebook = "https://facebook.com/TajrishSamak";
}
@{
    var blogs = content.Blogs
        .AsNoTracking()
        .Include(current => current.Images)
        .Where(current => current.Images.Count() > 0 && current.IsVisible == true)
        .OrderByDescending(current => current.CreateDate)
        .Take(4)
        .ToList();

    var gpPopularBlogs = content.Blogs
        .AsNoTracking()
        .Include(current => current.Images)
        .Where(current => current.Images.Count() > 0 && current.IsVisible == true)
        .OrderByDescending(current => current.Survey)
        .ThenByDescending(current => current.CreateDate)
        .Take(4)
        .ToList();
}
@{
    var slider = content.Sliders
        .AsNoTracking()
        .OrderByDescending(current => current.LastDate)
        .ToList();
}

@{
    var gpPopularProducts = content.Products
        .AsNoTracking()
        .Include(current => current.Orders)
        .Where(current => current.SiteFirstImage != null)
        .OrderByDescending(current => current.Orders.Count())
        .Take(4)
        .ToList();
}


