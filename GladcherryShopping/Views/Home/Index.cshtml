<section class="gp-hidden-aeo" aria-label="پرسش‌های شنوایی سنجی">
    <h2>پرسش و پاسخ خدمات شنوایی و سمعک</h2>
    <h3>برای انتخاب سمعک از کجا شروع کنیم؟</h3>
    <p>انتخاب سمعک با تست شنوایی، بررسی نوع کم‌شنوایی و مشاوره تخصصی انجام می‌شود.</p>
    <h3>آیا همه سمعک‌ها برای همه افراد مناسب هستند؟</h3>
    <p>خیر، نوع سمعک باید بر اساس نتیجه شنوایی‌سنجی، سبک زندگی و نیاز شنیداری هر فرد انتخاب شود.</p>
    <h3>چرا تنظیم سمعک مهم است؟</h3>
    <p>تنظیم دقیق باعث افزایش کیفیت شنیدن، کاهش آزار صوتی و سازگاری بهتر با سمعک می‌شود.</p>
</section>

<!-- compact services + automatic slider -->
<section class="gp-v10-showcase" aria-label="خدمات، برندها و اسلایدر کلینیک">
    <div class="container">
        <div class="gp-v10-showcase-shell">
            <div class="gp-v10-showcase-info">
                <span class="gp-v10-section-label">مسیر تجویز سمعک</span>
                <h2>متناسب با میزان شنوایی شما</h2>
                <p>برندهای معتبر</p>
                <div class="gp-v10-category-row">
                    <a href="/Home/Products">سمعک</a>
                    <a href="/blog/all">مجله کلینیک</a>
                    <a href="/contactus">مشاوره</a>
                </div>
                <div class="gp-v10-brand-strip" aria-label="برندهای سمعک">
                    @foreach (var item in content.Brands.AsNoTracking().Take(8).ToList())
                    {
                        <a title="@item.PersianName" href="/Home/Brands/@item.Id">
                            <img alt="@item.PersianName" title="@item.PersianName" src="@item.SmallImage" width="96" height="56" loading="lazy" decoding="async" />
                        </a>
                    }
                </div>
            </div>

            <div class="gp-v10-slider-wrap">
                @{
                    var gpDynamicSlides = slider
                        .Where(current => !string.IsNullOrWhiteSpace(current.Image) || !string.IsNullOrWhiteSpace(current.MobImage))
                        .ToList();

                    int gpDynamicSlideIndex = 0;
                }

                <div class="gp-v10-auto-slider" data-gp-auto-slider data-gp-slide-count="@gpDynamicSlides.Count" aria-label="اسلایدر معرفی کلینیک">
                    @if (gpDynamicSlides.Count > 0)
                    {
                        foreach (var item in gpDynamicSlides)
                        {
                            var gpDesktopImage = !string.IsNullOrWhiteSpace(item.Image) ? item.Image : item.MobImage;
                            var gpMobileImage = !string.IsNullOrWhiteSpace(item.MobImage) ? item.MobImage : gpDesktopImage;
                            var gpSlideLink = !string.IsNullOrWhiteSpace(item.Link) ? item.Link : "#";
                            var gpActiveClass = gpDynamicSlideIndex == 0 ? "gp-auto-slide is-active" : "gp-auto-slide";
                            var gpLoadingMode = gpDynamicSlideIndex == 0 ? "eager" : "lazy";

                            <a class="@gpActiveClass" href="@gpSlideLink" aria-label="اسلاید معرفی کلینیک شنوایی و سمعک شکوه تجریش">
                                <picture>
                                    <source media="(max-width: 768px)" srcset="@Url.Content(gpMobileImage)" />
                                    <img src="@Url.Content(gpDesktopImage)" alt="کلینیک شنوایی و سمعک شکوه تجریش، آزمایشات شنوایی و تجویز سمعک" loading="@gpLoadingMode" decoding="async" />
                                </picture>
                            </a>

                            gpDynamicSlideIndex++;
                        }
                    }
                    else
                    {
                        <a class="gp-auto-slide is-active" href="/contactus" aria-label="مشاوره رایگان شنوایی">
                            <picture>
                                <source media="(max-width: 768px)" srcset="@Url.Content("~/images/slider/tajrish-slider-v10-01-mobile.webp")" />
                                <img src="@Url.Content("~/images/slider/tajrish-slider-v10-01-desktop.webp")" alt="شنیدن بهتر از همین امروز، تست شنوایی و مشاوره رایگان" loading="eager" decoding="async" />
                            </picture>
                        </a>
                        <a class="gp-auto-slide" href="/Home/Products" aria-label="انتخاب سمعک هوشمند">
                            <picture>
                                <source media="(max-width: 768px)" srcset="@Url.Content("~/images/slider/tajrish-slider-v10-02-mobile.webp")" />
                                <img src="@Url.Content("~/images/slider/tajrish-slider-v10-02-desktop.webp")" alt="سمعک هوشمند، انتخاب دقیق و تنظیم راحت" loading="lazy" decoding="async" />
                            </picture>
                        </a>
                    }
                    <div class="gp-v8-slider-dots gp-v10-slider-dots" aria-hidden="true"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="gp-v8-life-title" aria-label="شعار کلینیک">
    <div class="container">
        <div class="gp-v8-life-card">
            <h2 class="animate-charcter">برای شنیدن بهترین آواز زندگی‌تان</h2>
            <p>خوب شنیدن؛ آرامش، ارتباط و کیفیت زندگی است.</p>
