        /* V87: Ear-only CSS page loader - no logo, no external Lottie */
        .gp-page-loader {
            position: fixed;
            inset: 0;
            z-index: 2147483000;
            display: grid;
            place-items: center;
            background: radial-gradient(circle at 50% 42%, rgba(216, 245, 18, .10), transparent 26%), radial-gradient(circle at 48% 55%, rgba(146, 10, 182, .14), transparent 32%), rgba(255, 255, 255, .88);
            backdrop-filter: blur(16px) saturate(145%);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .24s ease, visibility .24s ease;
        }

        .gp-page-loader.is-visible {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .gp-loader-card {
            width: min(270px, 76vw);
            min-height: 270px;
            display: grid;
            place-items: center;
            gap: 8px;
            padding: 24px;
            border-radius: 38px;
            background: rgba(255, 255, 255, .76);
            border: 1px solid rgba(146, 10, 182, .12);
            box-shadow: 0 28px 75px rgba(74, 18, 107, .18);
            text-align: center;
            direction: rtl;
        }

        #gpLottieLoader {
            width: 174px;
            height: 174px;
            position: relative;
            display: grid;
            place-items: center;
            filter: drop-shadow(0 18px 30px rgba(146, 10, 182, .16));
        }

        #gpLottieLoader::before {
            content: "";
            width: 126px;
            height: 126px;
            display: block;
            border-radius: 36px;
            background:
                radial-gradient(circle at 72% 22%, rgba(216,245,18,.95) 0 7%, transparent 8%),
                linear-gradient(135deg, rgba(255,255,255,.96), rgba(255,255,255,.70));
            box-shadow: 0 22px 44px rgba(146,10,182,.20), inset 0 0 0 1px rgba(146,10,182,.10);
            animation: gpEarCardFloat 1.55s ease-in-out infinite;
        }

        #gpLottieLoader::after {
            content: "";
            position: absolute;
            width: 76px;
            height: 76px;
            border-radius: 999px;
            border: 10px solid #920ab6;
            border-left-color: transparent;
            transform: rotate(-24deg);
            animation: gpEarPulse 1.55s ease-in-out infinite;
        }

        .gp-loader-ear-core {
            position: absolute;
            width: 42px;
            height: 42px;
            border-radius: 999px;
            border: 7px solid #920ab6;
            border-left-color: transparent;
            transform: rotate(-24deg);
            z-index: 2;
            animation: gpEarInnerPulse 1.55s ease-in-out infinite;
            pointer-events: none;
        }

        .gp-loader-ear-core::after {
            content: "";
            position: absolute;
            width: 12px;
            height: 12px;
            right: -15px;
            bottom: -7px;
            border-radius: 999px;
            background: #920ab6;
            box-shadow: 0 0 0 7px rgba(146,10,182,.10);
        }

        .gp-loader-sound-wave {
            position: absolute;
            width: 112px;
            height: 112px;
            border-radius: 999px;
            border: 2px solid rgba(146,10,182,.22);
            animation: gpEarWave 1.55s ease-out infinite;
            pointer-events: none;
        }

        .gp-loader-sound-wave:nth-child(2) {
            animation-delay: .42s;
        }

        @@keyframes gpEarCardFloat {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-6px) scale(1.025); }
        }

        @@keyframes gpEarPulse {
            0%, 100% { opacity: .88; transform: rotate(-24deg) scale(.96); }
            50% { opacity: 1; transform: rotate(-24deg) scale(1.04); }
        }

        @@keyframes gpEarInnerPulse {
            0%, 100% { transform: rotate(-24deg) scale(.96); }
            50% { transform: rotate(-24deg) scale(1.05); }
        }

        @@keyframes gpEarWave {
            0% { opacity: .42; transform: scale(.70); }
            100% { opacity: 0; transform: scale(1.22); }
        }

