@using System.Data.Entity;
@{
    GladcherryShopping.Models.ApplicationDbContext content = new GladcherryShopping.Models.ApplicationDbContext();

    var gpCacheVersion = "20260603-tajrish-v53-mobile-toggles-inline";
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpLogoUrl = gpBaseUrl + Url.Content("~/images/logo_purple.webp");

    // برای سرعت بیشتر، داده‌های منو و فوتر فقط یک بار خوانده می‌شوند.
    var gpProductCategories = content.Categories
        .AsNoTracking()
        .Where(current => current.ParentId == null && current.IsBlog == false)
        .OrderByDescending(current => current.PersianName)
        .ToList();

    var gpBlogCategories = content.Categories
        .AsNoTracking()
        .Where(current => current.ParentId == null && current.IsBlog == true)
        .OrderByDescending(current => current.PersianName)
        .ToList();

    var gpBrands = content.Brands
        .AsNoTracking()
        .Where(current => current.ParentId == null)
        .OrderByDescending(current => current.PersianName)
        .ToList();

    var gpServiceCategories = content.ServiceCategories
        .AsNoTracking()
        .OrderByDescending(current => current.PersianName)
        .ToList();

    var gpFooterProductCategories = gpProductCategories.Take(6).ToList();
}
