        /* V35: Lottie page loader */
        .gp-page-loader {
            position: fixed;
            inset: 0;
            z-index: 2147483000;
            display: grid;
            place-items: center;
            background:
                radial-gradient(circle at 50% 42%, rgba(216, 245, 18, .10), transparent 26%),
                radial-gradient(circle at 48% 55%, rgba(146, 10, 182, .14), transparent 32%),
                rgba(255, 255, 255, .88);
            backdrop-filter: blur(16px) saturate(145%);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .24s ease, visibility .24s ease;
        }

        .gp-page-loader.is-visible {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .gp-loader-card {
            width: min(270px, 76vw);
            min-height: 270px;
            display: grid;
            place-items: center;
            gap: 8px;
            padding: 24px;
            border-radius: 38px;
            background: rgba(255, 255, 255, .76);
            border: 1px solid rgba(146, 10, 182, .12);
            box-shadow: 0 28px 75px rgba(74, 18, 107, .18);
            text-align: center;
            direction: rtl;
        }

        #gpLottieLoader {
            width: 174px;
            height: 174px;
            filter: drop-shadow(0 18px 30px rgba(146, 10, 182, .16));
        }

        .gp-loader-card strong {
            display: block;
            color: #4b1684 !important;
            font-size: 15px;
            font-weight: 1000;
            line-height: 1.8;
        }

        .gp-loader-card span {
            display: block;
            color: rgba(32, 20, 45, .62) !important;
            font-size: 12px;
            font-weight: 850;
            line-height: 1.9;
        }

        .gp-loader-dots {
            display: inline-flex;
            gap: 5px;
            justify-content: center;
            margin-top: 2px;
        }

        .gp-loader-dots i {
            width: 6px;
            height: 6px;
            display: block;
            border-radius: 999px;
            background: #920ab6;
            animation: gpLoaderDot 1s ease-in-out infinite;
        }

        .gp-loader-dots i:nth-child(2) {
            animation-delay: .16s;
        }

        .gp-loader-dots i:nth-child(3) {
            animation-delay: .32s;
        }

        @@keyframes gpLoaderDot {
            0%, 100% { transform: translateY(0); opacity: .45; }
            50% { transform: translateY(-5px); opacity: 1; }
        }

