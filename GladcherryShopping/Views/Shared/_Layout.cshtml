        /* V52: EN/FA global language toggle */
        .gp-language-toggle {
            position: relative;
            min-width: 96px;
            height: 42px;
            display: inline-flex !important;
            align-items: center;
            justify-content: space-between;
            gap: 0;
            padding: 4px;
            border: 1px solid rgba(146, 10, 182, .16);
            border-radius: 999px;
            background:
                linear-gradient(135deg, rgba(255,255,255,.86), rgba(255,255,255,.58)),
                radial-gradient(circle at 18% 18%, rgba(216,245,18,.20), transparent 36%);
            color: #4b1684 !important;
            box-shadow: 0 14px 34px rgba(74, 18, 107, .10);
            overflow: hidden;
            cursor: pointer;
            backdrop-filter: blur(14px);
            direction: ltr !important;
            user-select: none;
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }

        .gp-language-toggle:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 42px rgba(74, 18, 107, .15);
            border-color: rgba(146, 10, 182, .26);
        }

        .gp-language-toggle .gp-lang-option {
            position: relative;
            z-index: 2;
            width: 42px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 1000;
            line-height: 1;
            letter-spacing: .02em;
            color: rgba(75, 22, 132, .72);
            transition: color .22s ease;
        }

        .gp-language-toggle::before {
            content: "";
            position: absolute;
            top: 4px;
            left: 4px;
            width: 42px;
            height: 32px;
            border-radius: 999px;
            background: linear-gradient(135deg, #4b1684, #920ab6, #e10b79);
            box-shadow: 0 10px 24px rgba(146, 10, 182, .28);
            transition: transform .25s cubic-bezier(.2,.9,.2,1);
            z-index: 1;
        }

        html:not(.gp-lang-en) .gp-language-toggle::before {
            transform: translateX(46px);
        }

