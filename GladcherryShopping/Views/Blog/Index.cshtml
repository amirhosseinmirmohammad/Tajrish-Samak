@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Web;
@using System.Data.Entity;
@using DataLayer.Models;
@model DataLayer.Models.Blog
@{
    if (Model == null)
    {
        Response.StatusCode = 404;
        Response.TrySkipIisCustomErrors = true;
        return;
    }

    var gpCacheVersion = "20260606-tajrish-v80-blog-detail-new-geo-links";
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpCanonicalPath = Url.Action("Index", "Blog", new { id = Model.Id, sefUrl = Model.SefUrl });
    var gpCanonicalUrl = gpBaseUrl + Url.Action("Index", "Blog", new
    {
        id = Model.Id,
        sefUrl = Model.SefUrl
    });

    var gpTitle = !string.IsNullOrWhiteSpace(Model.Title)
? Model.Title.Trim()
: "مقاله مجله کلینیک";

    var gpMetaDesc = !string.IsNullOrWhiteSpace(Model.MetaDesc)
        ? Model.MetaDesc.Trim()
        : "مقاله آموزشی کلینیک شنوایی و سمعک شکوه تجریش درباره سلامت شنوایی، سمعک، تست شنوایی و مراقبت از گوش.";

    var gpMetaKey = !string.IsNullOrWhiteSpace(Model.MetaKey)
        ? Model.MetaKey.Trim()
        : "مقاله شنوایی، سلامت گوش، سمعک، تست شنوایی، کلینیک شنوایی تجریش";

    var gpBodyPlain = !string.IsNullOrWhiteSpace(Model.Body)
        ? System.Text.RegularExpressions.Regex.Replace(Model.Body, "<.*?>", " ")
        : "";

    gpBodyPlain = System.Web.HttpUtility.HtmlDecode(gpBodyPlain);
    gpBodyPlain = System.Text.RegularExpressions.Regex.Replace(gpBodyPlain, @"\s+", " ").Trim();

    var gpWordCount = !string.IsNullOrWhiteSpace(gpBodyPlain)
        ? gpBodyPlain.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Length
        : 0;

    var gpReadingMinutes = Math.Max(1, (int)Math.Ceiling(gpWordCount / 180.0));

    var gpLocalEntityText = "کلینیک شنوایی و سمعک شکوه تجریش در تهران، محدوده تجریش، خدمات تست شنوایی، آزمایش شنوایی، مشاوره خرید سمعک، تجویز و تنظیم سمعک و پیگیری کم‌شنوایی را ارائه می‌دهد.";

    var gpImageItem = Model.Images != null
        ? Model.Images
            .Where(current =>
                current.Extension != null &&
                (
                    current.Extension.ToLower().Contains("jpeg") ||
                    current.Extension.ToLower().Contains("gif") ||
                    current.Extension.ToLower().Contains("png") ||
                    current.Extension.ToLower().Contains("jpg") ||
                    current.Extension.ToLower().Contains("webp")
                ))
            .FirstOrDefault()
        : null;

    var gpVideoItem = Model.Images != null
        ? Model.Images
            .Where(current =>
                current.Extension != null &&
                (
                    current.Extension.ToLower().Contains("mp4") ||
                    current.Extension.ToLower().Contains("mpeg") ||
                    current.Extension.ToLower().Contains("wmv")
                ))
            .FirstOrDefault()
        : null;

    var gpImageUrl = gpImageItem != null && !string.IsNullOrWhiteSpace(gpImageItem.FullPath)
        ? gpBaseUrl + gpImageItem.FullPath
        : gpBaseUrl + "/images/logo_purple.webp";

    var gpApprovedComments = Model.BlogComments != null
        ? Model.BlogComments.Where(current => current.IsApprove == true).ToList()
        : new List<BlogComment>();

    var gpRelatedBlogs = new List<Blog>();

    using (var gpDb = new GladcherryShopping.Models.ApplicationDbContext())
    {
        gpRelatedBlogs = gpDb.Blogs
            .AsNoTracking()
            .Include(current => current.Images)
            .Where(current =>
                current.IsVisible == true &&
                current.CategoryId == Model.CategoryId &&
                current.Id != Model.Id &&
                current.Images.Count() > 0)
            .OrderByDescending(current => current.Survey)
            .Take(4)
            .ToList();
    }

    ViewBag.Title = gpTitle + " | کلینیک شنوایی و سمعک شکوه تجریش";
    ViewBag.CanonicalUrl = gpCanonicalUrl;
    ViewBag.MetaDescription = gpMetaDesc;
    ViewBag.MetaKeywords = gpMetaKey;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    public string GetBlogImage(DataLayer.Models.Blog blog)
    {
        if (blog == null || blog.Images == null)
        {
            return "";
        }

        var image = blog.Images
            .Where(current =>
                current.Extension != null &&
                (
                    current.Extension.Contains("jpeg") ||
                    current.Extension.Contains("gif") ||
                    current.Extension.Contains("png") ||
                    current.Extension.Contains("jpg") ||
                    current.Extension.Contains("webp")
                ))
            .FirstOrDefault();

        return image != null ? image.FullPath : "";
    }

    public string GetBlogVideo(DataLayer.Models.Blog blog)
    {
        if (blog == null || blog.Images == null)
        {
            return "";
        }

        var video = blog.Images
            .Where(current =>
                current.Extension != null &&
                (
                    current.Extension.Contains("mp4") ||
                    current.Extension.Contains("mpeg") ||
                    current.Extension.Contains("wmv")
                ))
            .FirstOrDefault();

        return video != null ? video.FullPath : "";
    }

    public string StripForJson(string value)
    {
        return HttpUtility.JavaScriptStringEncode(value ?? "");
    }

    public bool HasGeoIntent(string text, string keyword)
    {
        return !string.IsNullOrWhiteSpace(text) &&
               !string.IsNullOrWhiteSpace(keyword) &&
               text.IndexOf(keyword, StringComparison.OrdinalIgnoreCase) >= 0;
    }
}

@section Metas {
    <meta name="description" content="@gpMetaDesc" />
    <link rel="canonical" href="@gpCanonicalUrl" />
    <meta name="Keywords" content="@gpMetaKey" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="کلینیک شنوایی و سمعک شکوه تجریش" />
    <meta name="publisher" content="کلینیک شنوایی و سمعک شکوه تجریش" />

    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:image" content="@gpImageUrl" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="@gpCanonicalUrl" />
    <meta property="og:description" content="@gpMetaDesc" />
    <meta property="og:site_name" content="کلینیک شنوایی و سمعک شکوه تجریش" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewBag.Title" />
    <meta name="twitter:image" content="@gpImageUrl" />
    <meta name="twitter:description" content="@gpMetaDesc" />
    <meta name="twitter:label1" content="زمان خواندن" />
    <meta name="twitter:data1" content="@gpReadingMinutes دقیقه" />

    <meta property="article:tag" content="@gpTitle" />
    @if (Model.CreateDate != null)
    {
        <meta property="article:published_time" content="@Model.CreateDate.Value.ToString("yyyy-MM-dd")" />
        <meta property="article:modified_time" content="@Model.CreateDate.Value.ToString("yyyy-MM-dd")" />
    }
    @if (Model.Category != null)
    {
        <meta property="article:section" content="@Model.Category.PersianName" />
    }
}

