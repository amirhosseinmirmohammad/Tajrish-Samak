            .gp-comment-form input {
                height: 54px;
                padding: 0 16px !important;
            }

            .gp-comment-form textarea {
                min-height: 150px;
                padding: 16px !important;
                line-height: 2;
                resize: vertical;
            }

            .gp-comment-form button {
                min-height: 54px;
                border: 0;
                border-radius: 20px;
                background: linear-gradient(135deg, var(--gp-v41-purple), var(--gp-v41-violet), var(--gp-v41-pink));
                color: #fff !important;
                font-weight: 1000;
                box-shadow: 0 18px 42px rgba(146,10,182,.20);
