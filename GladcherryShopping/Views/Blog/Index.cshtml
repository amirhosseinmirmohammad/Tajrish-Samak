                color: var(--gp-v41-ink) !important;
                font-weight: 1000;
                line-height: 1.7;
            }

            .gp-comment-item p {
                margin: 5px 0 0;
                color: var(--gp-v41-muted) !important;
                font-weight: 850;
                line-height: 2;
