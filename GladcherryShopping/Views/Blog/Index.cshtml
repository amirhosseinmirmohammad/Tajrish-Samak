            align-items: center;
            justify-content: center;
            padding: 0 18px;
            border-radius: 999px;
            background: rgba(29,20,48,.92);
            color: #fff;
            font-weight: 950;
            box-shadow: 0 18px 42px rgba(0,0,0,.22);
            transform: translateY(24px);
            opacity: 0;
            pointer-events: none;
            transition: transform .22s ease, opacity .22s ease;
        }

            .gp-blog-toast.is-visible {
                opacity: 1;
                transform: translateY(0);
            }

        .gp-heart-icon {
            color: var(--gp-v41-heart) !important;
            font-family: Tahoma, Arial, sans-serif !important;
            font-size: 18px !important;
            line-height: 1 !important;
        }

        html.gp-dark-mode .gp-blog-detail-page {
