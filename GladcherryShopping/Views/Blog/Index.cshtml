            }

            .gp-comment-item {
                grid-template-columns: 1fr;
                text-align: center;
            }

                .gp-comment-item img {
                    margin: 0 auto;
                }

            .gp-blog-toast {
                left: 14px;
                right: 14px;
                bottom: 86px;
            }
        }


        /* V80: new grouped GEO/brand link hub */
        .gp-v80-link-hub {
            max-width: 920px !important;
            padding: clamp(16px, 2.2vw, 24px) !important;
            border-radius: 32px !important;
