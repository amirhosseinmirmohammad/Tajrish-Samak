            margin: 0 auto 16px !important;
            color: var(--gp-v41-muted) !important;
            font-size: 13px !important;
            font-weight: 850 !important;
            line-height: 2 !important;
            text-align: center !important;
        }

        .gp-v80-link-group {
            margin-top: 14px;
            padding: 14px;
            border-radius: 24px;
            background: rgba(255,255,255,.62);
            border: 1px solid rgba(75,22,132,.08);
        }

            .gp-v80-link-group h3 {
                margin: 0 0 10px !important;
                color: var(--gp-v41-ink) !important;
                font-size: 15px !important;
                font-weight: 1000 !important;
                line-height: 1.8 !important;
                text-align: right !important;
            }

        .gp-v80-link-grid {
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)) !important;
        }

            .gp-v80-link-grid a {
                min-height: 48px !important;
                border-radius: 18px !important;
                background: #fff !important;
                box-shadow: 0 10px 26px rgba(74,18,107,.06);
                transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
            }

                .gp-v80-link-grid a:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 16px 34px rgba(74,18,107,.12);
                    background: linear-gradient(135deg, rgba(255,255,255,.98), rgba(251,247,255,.98)) !important;
                }

        html.gp-dark-mode .gp-v80-link-hub-lead {
            color: rgba(246,247,251,.72) !important;
        }

        html.gp-dark-mode .gp-v80-link-group {
            background: rgba(255,255,255,.055) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

            html.gp-dark-mode .gp-v80-link-group h3 {
                color: #fff !important;
            }

        html.gp-dark-mode .gp-v80-link-grid a {
            background: rgba(255,255,255,.075) !important;
        }

        @@media(max-width: 768px) {
            .gp-v80-link-grid {
                grid-template-columns: 1fr !important;
            }

            .gp-v80-link-group h3 {
                text-align: center !important;
            }
        }
    </style>
}

@if (TempData["Error"] != null)
