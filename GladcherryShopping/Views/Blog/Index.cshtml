            border-color: rgba(255,255,255,.10) !important;
            color: rgba(246,247,251,.86) !important;
        }

        html.gp-dark-mode .gp-newsletter-form-v41 input,
        html.gp-dark-mode .gp-comment-form input,
        html.gp-dark-mode .gp-comment-form textarea {
            background: rgba(255,255,255,.07) !important;
            border-color: rgba(255,255,255,.12) !important;
            color: #fff !important;
        }

        html.gp-dark-mode .gp-blog-content table {
            background: rgba(24,24,40,.95) !important;
        }

            html.gp-dark-mode .gp-blog-content table th,
            html.gp-dark-mode .gp-blog-content table td {
                color: rgba(246,247,251,.86) !important;
                border-bottom-color: rgba(255,255,255,.10) !important;
                border-left-color: rgba(255,255,255,.08) !important;
            }

            html.gp-dark-mode .gp-blog-content table th,
            html.gp-dark-mode .gp-blog-content table thead td {
                background: rgba(255,255,255,.09) !important;
                color: #fff !important;
            }

            html.gp-dark-mode .gp-blog-content table tr:hover td {
                background: rgba(216,245,18,.09) !important;
            }

        html.gp-dark-mode .gp-blog-content blockquote {
            background: rgba(255,255,255,.07) !important;
            color: #f7f7fb !important;
            border-right-color: #ff4f7c !important;
        }

        html.gp-dark-mode .gp-blog-content a {
            color: #ff9ac0 !important;
