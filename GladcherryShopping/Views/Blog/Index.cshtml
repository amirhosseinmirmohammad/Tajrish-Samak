            box-shadow: 0 22px 56px rgba(74,18,107,.10);
        }

            .gp-v80-link-hub > strong {
                font-size: clamp(18px, 2vw, 26px) !important;
                margin-bottom: 6px !important;
            }

        .gp-v80-link-hub-lead {
