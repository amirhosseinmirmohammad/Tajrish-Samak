@using DataLayer.ViewModels.PagerViewModel
@model PagerViewModels<DataLayer.Models.Blog>
@using MvcPager
@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Web;
@using System.Data.Entity;
@{
    GladcherryShopping.Models.ApplicationDbContext content = new GladcherryShopping.Models.ApplicationDbContext();

    var gpCacheVersion = "20260603-tajrish-v40-blog-magazine-no-slider";
    var gpBaseUrl = "https://tajrish-samak.ir";
    var gpCanonicalUrl = gpBaseUrl + Request.Path;

    var gpBlogs = Model != null && Model.data != null
        ? Model.data.ToList()
        : new List<DataLayer.Models.Blog>();
    var gpPopularBlogs = content.Blogs
            .AsNoTracking()
            .Include(current => current.Images)
            .Where(current => current.IsVisible == true && current.Images.Count() > 0)
            .OrderByDescending(current => current.Survey)
            .Take(5)
            .ToList();

    var gpRecentBlogs = content.Blogs
        .AsNoTracking()
        .Include(current => current.Images)
        .Where(current => current.IsVisible == true && current.Images.Count() > 0)
        .OrderByDescending(current => current.CreateDate)
        .Take(5)
        .ToList();

    ViewBag.Title = "مجله کلینیک | کلینیک شنوایی و سمعک شکوه تجریش";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    public string GetBlogImage(DataLayer.Models.Blog blog)
    {
        if (blog == null || blog.Images == null)
        {
            return "";
        }

        var image = blog.Images
            .Where(current =>
                current.Extension != null &&
                (
                    current.Extension.Contains("jpeg") ||
                    current.Extension.Contains("gif") ||
                    current.Extension.Contains("png") ||
                    current.Extension.Contains("jpg") ||
                    current.Extension.Contains("webp")
                ))
            .FirstOrDefault();

        return image != null ? image.FullPath : "";
    }

    public string GetBlogVideo(DataLayer.Models.Blog blog)
    {
        if (blog == null || blog.Images == null)
        {
            return "";
        }

        var video = blog.Images
            .Where(current =>
                current.Extension != null &&
                (
                    current.Extension.Contains("mp4") ||
                    current.Extension.Contains("mpeg") ||
                    current.Extension.Contains("wmv")
                ))
            .FirstOrDefault();

        return video != null ? video.FullPath : "";
    }
}

