<section class="gp-blog-page" aria-label="مجله کلینیک شنوایی و سمعک شکوه تجریش">
    <div class="container">
        <section class="gp-blog-hero" aria-label="معرفی مجله کلینیک">
            <div class="gp-blog-hero-grid">
                <div>
                    <span class="gp-blog-kicker">مجله کلینیک</span>
                    <h1>رشد آگاهی شنوایی از همین‌جا شروع می‌شود.</h1>
                    <p>
                        مطالب کاربردی درباره سلامت گوش، کم‌شنوایی، تست شنوایی، انتخاب سمعک و مراقبت‌های روزمره را اینجا بخوانید.
                    </p>

                    <form class="gp-blog-search" method="get" action="/Blog/All">
                        <input type="search" name="q" placeholder="جستجو در مقالات..." />
                        <button type="submit" aria-label="جستجو">⌕</button>
                    </form>
                </div>

                <div class="gp-blog-hero-cards" aria-label="خلاصه مجله">
                    <div class="gp-blog-hero-card">
                        <strong>@gpBlogs.Count()</strong>
                        <span>مقاله در این صفحه</span>
                    </div>
                    <div class="gp-blog-hero-card">
                        <strong>۵</strong>
                        <span>پربازدیدترین مقاله</span>
                    </div>
                    <div class="gp-blog-hero-card">
                        <strong>۲۵+</strong>
                        <span>سال تجربه کلینیک</span>
                    </div>
                </div>
            </div>
        </section>


        <div class="gp-blog-shell">
            <main class="gp-blog-list-card" aria-label="آخرین مقالات">
                <div class="gp-blog-section-head">
                    <div>
                        <span>آخرین مطالب</span>
                        <h2>مقالات تازه مجله</h2>
                    </div>
                    <p>مطالب آموزشی و کاربردی برای تصمیم‌گیری بهتر درباره شنوایی و سمعک.</p>
                </div>

                @if (gpBlogs.Count() > 0)
                {
                    <div class="gp-blog-grid">
                        @foreach (var item in gpBlogs.Take(4))
                        {
                            var blogImage = GetBlogImage(item);
                            var blogVideo = GetBlogVideo(item);

                            <article class="gp-blog-card" itemscope itemtype="https://schema.org/BlogPosting">
                                <a class="gp-blog-card-media" hreflang="fa-IR" title="@item.Title | کلینیک شنوایی و سمعک شکوه تجریش" href="/blog/@item.Id/@item.SefUrl" itemprop="url">
                                    <span class="gp-blog-badge">مقاله</span>
                                    @if (!string.IsNullOrWhiteSpace(blogImage))
                                    {
                                        <img src="@blogImage" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" itemprop="image" />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(blogVideo))
                                    {
                                        <video src="@blogVideo" muted playsinline preload="metadata"></video>
                                    }
                                    else
                                    {
                                        <img src="@Url.Content("~/images/logo_purple.webp")" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" />
                                    }
                                </a>

                                <div class="gp-blog-card-body">
                                    <h2 itemprop="headline">
                                        <a hreflang="fa-IR" title="@item.Title | کلینیک شنوایی و سمعک شکوه تجریش" href="/blog/@item.Id/@item.SefUrl">@item.Title</a>
                                    </h2>

                                    <p itemprop="description">@GladCherryShopping.Helpers.FunctionsHelper.Truncate(item.ShortDesc, 115)</p>

                                    <div class="gp-blog-meta">
                                        @if (item.CreateDate != null)
                                        {
                                            <span>@GladCherryShopping.Helpers.FunctionsHelper.GetPersianDateTime((DateTime)item.CreateDate, false, false)</span>
                                        }
                                        <span>@item.Survey بازدید</span>
                                    </div>

                                    <a class="gp-blog-read-more" href="/blog/@item.Id/@item.SefUrl" title="@item.Title">مطالعه مقاله</a>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="gp-blog-pagination text-center">
                        موردی برای نمایش وجود ندارد.
                    </div>
                }

                <div class="gp-blog-pagination text-center">
                    <nav aria-label="صفحه‌بندی مقالات">
                        <div style="direction:ltr">
                            <ul class="pagination pagination-sm">
                                <li>@Html.Pager(4, Model.CurrentPage, Model.TotalItemCount)</li>
                            </ul>
                        </div>
                    </nav>
                </div>
            </main>

            <aside class="gp-blog-side" aria-label="پربازدیدترین و تازه‌ترین مقالات">
                <section class="gp-blog-side-card">
                    <h3>پربازدیدترین‌ها</h3>
                    <div class="gp-side-posts">
                        @foreach (var item in gpPopularBlogs)
                        {
                            var itemImage = GetBlogImage(item);
                            <a class="gp-side-post" href="/blog/@item.Id/@item.SefUrl" title="@item.Title">
                                @if (!string.IsNullOrWhiteSpace(itemImage))
                                {
                                    <img src="@itemImage" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/images/logo_purple.webp")" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" />
                                }
                                <span>
                                    <strong>@GladCherryShopping.Helpers.FunctionsHelper.Truncate(item.Title, 46)</strong>
                                    <span>@item.Survey بازدید</span>
                                </span>
                            </a>
                        }
                    </div>
                </section>

                <section class="gp-blog-side-card">
                    <h3>تازه‌ترین‌ها</h3>
                    <div class="gp-side-posts">
                        @foreach (var item in gpRecentBlogs)
                        {
                            var itemImage = GetBlogImage(item);
                            <a class="gp-side-post" href="/blog/@item.Id/@item.SefUrl" title="@item.Title">
                                @if (!string.IsNullOrWhiteSpace(itemImage))
                                {
                                    <img src="@itemImage" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/images/logo_purple.webp")" alt="@item.Title" title="@item.Title" loading="lazy" decoding="async" />
                                }
                                <span>
                                    <strong>@GladCherryShopping.Helpers.FunctionsHelper.Truncate(item.Title, 46)</strong>
                                    @if (item.CreateDate != null)
                                    {
                                        <span>@GladCherryShopping.Helpers.FunctionsHelper.GetPersianDateTime((DateTime)item.CreateDate, false, false)</span>
                                    }
                                </span>
                            </a>
                        }
                    </div>
                </section>
            </aside>
        </div>
    </div>
</section>
