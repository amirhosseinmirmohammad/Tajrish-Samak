@using System;
@using System.Linq;
@using System.Web;
@* V63: clean list marker style, no broken pseudo numbers. Keep this file saved as UTF-8 with signature/BOM. *@
@{
    dynamic page = ViewBag.Page;
    if (page == null)
    {
        Response.StatusCode = 404;
        return;
    }

    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";

    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseUrl = "https://tajrish-samak.ir";
    var logoUrl = baseUrl + Url.Content("~/images/logo_purple.webp");
}

@functions {
    public string J(object value)
    {
        var s = value == null ? "" : value.ToString();
        var sb = new System.Text.StringBuilder();

        foreach (var ch in s)
        {
            switch (ch)
            {
                case '\\': sb.Append("\\\\"); break;
                case '"': sb.Append("\\\""); break;
                case '\r': sb.Append("\\r"); break;
                case '\n': sb.Append("\\n"); break;
                case '\t': sb.Append("\\t"); break;
                default:
                    if (ch < 32 || ch > 126)
                    {
                        sb.Append("\\u");
                        sb.Append(((int)ch).ToString("x4"));
                    }
                    else
                    {
                        sb.Append(ch);
                    }
                    break;
            }
        }

        return sb.ToString();
    }

    public string Entity(object value)
    {
        var s = value == null ? "" : value.ToString();
        var sb = new System.Text.StringBuilder();

        foreach (var ch in s)
        {
            if (ch == '&')
            {
                sb.Append("&amp;");
            }
            else if (ch == '<')
            {
                sb.Append("&lt;");
            }
            else if (ch == '>')
            {
                sb.Append("&gt;");
            }
            else if (ch == '"')
            {
                sb.Append("&quot;");
            }
            else if (ch == '\'')
            {
                sb.Append("&#x27;");
            }
            else if (ch > 126)
            {
                sb.Append("&#x");
                sb.Append(((int)ch).ToString("X"));
                sb.Append(";");
            }
            else
            {
                sb.Append(ch);
            }
        }

        return sb.ToString();
    }

    public IHtmlString H(object value)
    {
        return new HtmlString(Entity(value));
    }

    public string T(string value)
    {
        return value;
    }
}

@section Metas{
    <meta name="description" content="@Html.Raw(Entity(page.MetaDescription))" />
    <link rel="canonical" href="@(page.Canonical)" />
    <meta name="Keywords" content="@string.Join(", ", page.Keywords)" />

    <meta property="og:title" content="@Html.Raw(Entity(page.Title))" />
    <meta property="og:description" content="@Html.Raw(Entity(page.MetaDescription))" />
    <meta property="og:url" content="@(page.Canonical)" />
    <meta property="og:image" content="@logoUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:title" content="@Html.Raw(Entity(page.Title))" />
    <meta name="twitter:description" content="@Html.Raw(Entity(page.MetaDescription))" />
    <meta name="twitter:image" content="@logoUrl" />
}

@section Styles{
