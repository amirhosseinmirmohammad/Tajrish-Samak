                },
                {
                  "@@type": "ListItem",
                  "position": 2,
                  "name": "@Html.Raw(J(page.MainService))",
                  "item": "@page.Canonical"
                }
              ]
            },
            {
              "@@type": "Service",
              "@@id": "@page.Canonical#service",
              "name": "@Html.Raw(J(page.H1))",
              "serviceType": "@Html.Raw(J(page.MainService))",
              "description": "@Html.Raw(J(page.MetaDescription))",
              "areaServed": [
