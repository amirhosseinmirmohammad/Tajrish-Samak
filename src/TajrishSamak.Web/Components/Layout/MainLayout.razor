@inject IMemoryCache Cache

@{
    const string gpGeoEntityDescription = "کلینیک شنوایی و سمعک شکوه تجریش یک مرکز تخصصی شنوایی‌شناسی در تهران، محدوده تجریش و شمال تهران است که خدمات تست شنوایی، آزمایش شنوایی، مشاوره خرید سمعک، تجویز و تنظیم سمعک، تعمیر سمعک، باتری سمعک، قالب سمعک، سمعک دولتی، سمعک رایگان بهزیستی، خدمات حمایتی، پیگیری پس از تجویز و مشاوره مرتبط با وزوز گوش را ارائه می‌دهد. این کلینیک برای مراجعان تهران، شمیرانات، تجریش، نیاوران، قیطریه، زعفرانیه، الهیه، فرمانیه و محله‌های شمال تهران قابل دسترسی است.";
}

@code {
    private List<Category> gpProductCategories = new();
    private List<Category> gpBlogCategories = new();
    private List<ServiceCategory> gpServiceCategories = new();

    protected override async Task OnInitializedAsync()
    {
        // Layout-level data: the legacy app ran these queries on EVERY request;
        // here they are cached for 10 minutes (identical results, far fewer queries).
        gpProductCategories = await Cache.GetOrCreateAsync("layout:product-categories", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await Db.Categories
                .Where(c => c.ParentId == null && c.IsBlog == false)
                .OrderByDescending(c => c.PersianName)
                .ToListAsync();
        }) ?? new List<Category>();

        gpBlogCategories = await Cache.GetOrCreateAsync("layout:blog-categories", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await Db.Categories
                .Where(c => c.ParentId == null && c.IsBlog == true)
                .OrderByDescending(c => c.PersianName)
                .ToListAsync();
        }) ?? new List<Category>();

        gpServiceCategories = await Cache.GetOrCreateAsync("layout:service-categories", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await Db.ServiceCategories
                .OrderByDescending(c => c.PersianName)
                .ToListAsync();
        }) ?? new List<ServiceCategory>();
    }
}

