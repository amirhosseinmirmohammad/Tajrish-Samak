<section class="gp-about-page" aria-label="درباره کلینیک شنوایی و سمعک شکوه تجریش">
    <div class="container">
        <section class="gp-about-hero" aria-label="معرفی کلینیک">
            <div class="gp-about-hero-grid">
                <div>
                    <span class="gp-about-kicker">درباره ما</span>
                    <h1>شنیدن بهتر، با دقت و احترام شروع می‌شود.</h1>
                    <p>
                        کلینیک شنوایی و سمعک شکوه تجریش با تکیه بر تجربه، ارزیابی دقیق و نگاه انسانی به مراجعه‌کننده، مسیر انتخاب و تنظیم سمعک را شفاف‌تر و مطمئن‌تر می‌کند.
                    </p>
                    <div class="gp-about-actions">
                        <a href="tel:02122735588" dir="ltr">
                            <span aria-hidden="true">☎</span>
                            تماس
                        </a>
                        <a href="#gp-about-story">
                            <span aria-hidden="true">⌄</span>
                            مطالعه داستان کلینیک
                        </a>
                    </div>
                </div>

                <div class="gp-about-stats" aria-label="خلاصه کلینیک">
                    <div class="gp-about-stat">
                        <strong>۱۳۸۱</strong>
                        <span>سال آغاز فعالیت</span>
                    </div>
                    <div class="gp-about-stat">
                        <strong>۲۵+</strong>
                        <span>سال تجربه تخصصی</span>
                    </div>
                    <div class="gp-about-stat">
                        <strong>۴</strong>
                        <span>اصل کاری: دقت، احترام، صداقت، پیگیری</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="gp-about-story-card" id="gp-about-story" aria-label="داستان کلینیک">
            <div class="gp-about-section-head">
                <span>روایت شکل‌گیری</span>
                <h2>یادگاری از یک نگاه دقیق و خیرخواهانه</h2>
                <p>این مرکز بر پایه دقت علمی، احترام به مراجعه‌کننده و خیرخواهی در مسیر درمان شکل گرفت.</p>
            </div>

            <div class="gp-about-story-text">
                <p>
                    کلینیک شنوایی و سمعک تجریش در سال ۱۳۸۱ به همت بانوی ادیولوژیست، شکوه روحی تأسیس شد. ایشان فارغ‌التحصیل رشته شنوایی‌شناسی از دانشگاه علوم پزشکی ایران بودند و پس از سال‌ها تلاش حرفه‌ای، متأسفانه در سال ۱۳۹۱ پس از تحمل یک دوره بیماری سخت و طولانی به رحمت ایزدی پیوستند. شخصیت، متانت، دانش و اعمال خیر ایشان هنوز زبانزد است و یاد و خاطره ایشان همواره زنده خواهد ماند.
                </p>
                <p>
                    با تغییر نام مرکز به کلینیک شنوایی و سمعک شکوه تجریش، این مجموعه پس از درگذشت ایشان همچنان بر همان اصول اولیه ادامه مسیر داد: دقت، احترام و خیرخواهی برای مراجعان. امید ما این است که با حسن انجام خدمات تخصصی، یاد آن بانوی نیکوکار را گرامی بداریم و رضایت مراجعه‌کنندگان را فراهم کنیم.
                </p>
            </div>
        </section>

        <section class="gp-about-clinic-gallery" aria-label="تصاویر کلینیک شنوایی و سمعک شکوه تجریش">
            <div class="gp-about-section-head">
                <span>فضای کلینیک</span>
                <h2>تصاویر کلینیک شکوه تجریش</h2>
                <p>گالری تصاویر کلینیک، محیط خدمات و بخش‌هایی از تجربه مراجعه در مرکز شنوایی و سمعک شکوه تجریش.</p>
            </div>

            <div class="gp-about-gallery-grid">
                @{ var aboutGalleryIndex = 0; }
                @foreach (var img in aboutClinicImages)
                {
                    aboutGalleryIndex++;
                    var caption = aboutGalleryIndex % 3 == 2 ? "خدمات شنوایی" : aboutGalleryIndex % 3 == 0 ? "ارزیابی تخصصی" : "فضای کلینیک";
                    <article class="gp-about-gallery-card">
                        <img src="@img" title="کلینیک شنوایی و سمعک شکوه تجریش" alt="تصویر @aboutGalleryIndex از کلینیک شنوایی و سمعک شکوه تجریش" loading="lazy" decoding="async" />
                        <div class="gp-about-gallery-caption">
                            <span>@aboutGalleryIndex.ToString("00")</span>
                            <h3>@caption</h3>
                            <p>نمایی از فضای کلینیک و مسیر ارائه خدمات شنوایی در شکوه تجریش.</p>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="gp-about-values-grid" aria-label="ارزش‌های کلینیک">
            <article class="gp-about-value">
                <i aria-hidden="true">✓</i>
                <h3>دقت در ارزیابی</h3>
                <p>مسیر انتخاب سمعک با تست شنوایی و بررسی دقیق نیازهای فردی شروع می‌شود.</p>
            </article>
            <article class="gp-about-value">
                <i aria-hidden="true">◌</i>
                <h3>احترام به مراجعه‌کننده</h3>
                <p>در هر مرحله، توضیح شفاف و تصمیم‌گیری آگاهانه برای ما مهم است.</p>
            </article>
            <article class="gp-about-value">
                <i aria-hidden="true">⚙</i>
                <h3>تنظیم تخصصی</h3>
                <p>سمعک فقط خرید نیست؛ انتخاب، تنظیم و پیگیری درست نتیجه را می‌سازد.</p>
            </article>
            <article class="gp-about-value">
                <i aria-hidden="true">↻</i>
                <h3>پیگیری واقعی</h3>
                <p>بعد از انتخاب، همراهی و اصلاح تنظیمات بخش مهمی از تجربه شنیدن بهتر است.</p>
            </article>
        </section>

        <section class="gp-about-video-card" aria-label="ویدیوی معرفی کلینیک">
            <div class="gp-about-section-head">
                <span>مشاهده ویدیو</span>
                <h2>نگاهی کوتاه به کلینیک</h2>
                <p>برای آشنایی بیشتر با فضای خدمات و رویکرد کلینیک، ویدیوی معرفی را ببینید.</p>
            </div>

            <div class="gp-about-video-grid">
                <div class="gp-about-video-frame gp-about-local-video-frame">
                    <video class="gp-about-local-video"
                           controls
                           playsinline
                           preload="metadata"
                           poster="/content/images/clinic-slider-piano-poster.webp">
                        <source src="/content/images/clinic-slider-piano-mobile.mp4" type="video/mp4" media="(max-width: 768px)" />
                        <source src="/content/images/clinic-slider-piano-lite.mp4" type="video/mp4" />
                        مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.
                    </video>
                </div>

                <aside class="gp-about-video-side">
                    <img src="/images/pransa_logo_web.png" title="کلینیک شنوایی و سمعک شکوه تجریش" alt="کلینیک شنوایی و سمعک شکوه تجریش" width="200" loading="lazy" decoding="async" />
                    <h3>کلینیک شنوایی و سمعک شکوه تجریش</h3>
                    <p>ارائه انواع آزمایشات شنوایی، مشاوره، تجویز و تنظیم سمعک</p>
                </aside>
            </div>
        </section>

        <section class="gp-about-final-cta" aria-label="تماس با کلینیک">
            <div>
                <h2>برای شروع مسیر شنیدن بهتر آماده‌اید؟</h2>
                <p>با کلینیک تماس بگیرید تا برای ارزیابی، مشاوره و انتخاب مسیر مناسب راهنمایی شوید.</p>
            </div>
            <a href="tel:02122735588" dir="ltr">تماس</a>
        </section>
    </div>
</section>

