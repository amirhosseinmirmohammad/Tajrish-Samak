@page "/faq"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory

<PageTitle>سوالات متداول | کلینیک شنوایی و سمعک شکوه تجریش</PageTitle>
<meta name="description" content="پاسخ کوتاه و دقیق پرسش‌های رایج درباره سمعک، تست شنوایی، قیمت، گارانتی و خدمات کلینیک شنوایی و سمعک شکوه تجریش در شمال تهران." />
<link rel="canonical" href="https://tajrish-samak.ir/faq" />

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    { "@@type": "Question", "name": "بهترین سمعک کدام است؟", "acceptedAnswer": { "@@type": "Answer", "text": "بهترین سمعک بسته به نوع و شدت کم‌شنوایی، سبک زندگی و بودجه شما متفاوت است. برندهای معتبری مانند Phonak، Oticon، Widex، Signia، ReSound و Starkey در کلینیک شکوه تجریش موجود است؛ پس از تست شنوایی، مناسب‌ترین گزینه توسط کارشناس شنوایی‌شناس تجویز می‌شود." } },
    { "@@type": "Question", "name": "قیمت سمعک چقدر است؟", "acceptedAnswer": { "@@type": "Answer", "text": "قیمت سمعک بر اساس تکنولوژی، برند و نوع آن (داخل گوشی یا پشت گوشی) متغیر است. پس از تست شنوایی رایگان، گزینه‌های متناسب با بودجه شما با گارانتی رسمی و امکان پرداخت اقساطی معرفی می‌شود." } },
    { "@@type": "Question", "name": "تست شنوایی چقدر طول می‌کشد و درد دارد؟", "acceptedAnswer": { "@@type": "Answer", "text": "تست شنوایی کامل حدود ۲۰ تا ۳۰ دقیقه طول می‌کشد، کاملاً بدون درد است و شامل بررسی شنوایی هر دو گوش در فرکانس‌های مختلف است. نتیجه به‌صورت نمودار اودیوگرام ارائه می‌شود." } },
    { "@@type": "Question", "name": "آیا سمعک صدا را خیر یا اذیت می‌کند؟", "acceptedAnswer": { "@@type": "Answer", "text": "خیر. سمعک‌های دیجیتال مدرن صدا را پردازش می‌کنند، صداهای مزاحم پس‌زمینه را کاهش می‌دهند و فقط صداهایی را که شما کم می‌شنوید تقویت می‌کنند. عادت به آن معمولاً چند روز تا چند هفته طول می‌کشد." } },
    { "@@type": "Question", "name": "سمعک برای چه کسانی لازم است؟", "acceptedAnswer": { "@@type": "Answer", "text": "هر فردی با کم‌شنوایی خفیف تا شدید - از کاهش شنوایی ناشی از سن گرفته تا کم‌شنوایی ناشی از صدا یا بیماری - می‌تواند از سمعک بهره ببرد. مراجعه زودهنگام از افت پیشروی گفتار و انزوای اجتماعی جلوگیری می‌کند." } },
    { "@@type": "Question", "name": "گارانتی سمعک چقدر است؟", "acceptedAnswer": { "@@type": "Answer", "text": "سمعک‌های ارائه‌شده در کلینیک شکوه تجریش دارای گارانتی رسمی بین‌المللی ۱ تا ۴ ساله به‌همراه گارانتی تعویض و خدمات پس از فروش، تنظیم دوره‌ای و تعمیر در نمایندگی هستند." } },
    { "@@type": "Question", "name": "آیا تست و مشاوره شنوایی رایگان است؟", "acceptedAnswer": { "@@type": "Answer", "text": "بله، تست و مشاوره اولیه شنوایی در کلینیک شکوه تجریش رایگان است. برای رزرو نوبت با شماره ۰۲۱-۲۲۷۳۵۵۸۸ تماس بگیرید یا از فرم تماس سایت استفاده کنید." } },
    { "@@type": "Question", "name": "سمعک نامرئی چیست و برای چه کسانی مناسب است؟", "acceptedAnswer": { "@@type": "Answer", "text": "سمعک نامرئی (IIC/CIC) درون کانال گوش جا می‌گیرد و تقریباً دیده نمی‌شود؛ گزینه‌ای محبوب برای کسانی است که ظاهر را مهم می‌دانند و کم‌شنوایی خفیف تا متوسط دارند." } }
  ]
}
</script>

<div class="services-breadcrumb">
    <div class="agile_inner_breadcrumb">
        <div class="container">
            <ul class="w3_short">
                <li>
                    <a href="/">صفحه اصلی</a>
                    <i>|</i>
                </li>
                <li>سوالات متداول</li>
            </ul>
        </div>
    </div>
</div>

<div class="faqs-w3l">
    <div class="container">
        <div class="text-center">
            <h1 class="tittle-w3l text-center">
                سوالات متداول
                <span class="heading-style">
                    <i></i>
                    <i></i>
                    <i></i>
                </span>
            </h1>
        </div>
        <h3 class="w3-head">پاسخ پرسش‌های شما</h3>
        <div class="faq-w3agile container">
            <ul class="faq">
                @foreach (var item in FaqItems)
                {
                    <li class="item@(FaqItems.IndexOf(item) + 1)">
                        <a href="#">@item.Q</a>
                        <ul>
                            <li class="subitem1">
                                <p>@item.A</p>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@code {
    private static readonly (string Q, string A)[] FaqItems = new[]
    {
        ("بهترین سمعک کدام است؟", "بهترین سمعک بسته به نوع و شدت کم‌شنوایی، سبک زندگی و بودجه شما متفاوت است. برندهای معتبری مانند Phonak، Oticon، Widex، Signia، ReSound و Starkey در کلینیک شکوه تجریش موجود است؛ پس از تست شنوایی، مناسب‌ترین گزینه توسط کارشناس شنوایی‌شناس تجویز می‌شود."),
        ("قیمت سمعک چقدر است؟", "قیمت سمعک بر اساس تکنولوژی، برند و نوع آن (داخل گوشی یا پشت گوشی) متغیر است. پس از تست شنوایی رایگان، گزینه‌های متناسب با بودجه شما با گارانتی رسمی و امکان پرداخت اقساطی معرفی می‌شود."),
        ("تست شنوایی چقدر طول می‌کشد و درد دارد؟", "تست شنوایی کامل حدود ۲۰ تا ۳۰ دقیقه طول می‌کشد، کاملاً بدون درد است و شامل بررسی شنوایی هر دو گوش در فرکانس‌های مختلف است. نتیجه به‌صورت نمودار اودیوگرام ارائه می‌شود."),
        ("آیا سمعک صدا را خیر یا اذیت می‌کند؟", "خیر. سمعک‌های دیجیتال مدرن صدا را پردازش می‌کنند، صداهای مزاحم پس‌زمینه را کاهش می‌دهند و فقط صداهایی را که شما کم می‌شنوید تقویت می‌کنند. عادت به آن معمولاً چند روز تا چند هفته طول می‌کشد."),
        ("سمعک برای چه کسانی لازم است؟", "هر فردی با کم‌شنوایی خفیف تا شدید - از کاهش شنوایی ناشی از سن گرفته تا کم‌شنوایی ناشی از صدا یا بیماری - می‌تواند از سمعک بهره ببرد. مراجعه زودهنگام از پیشروی افت شنوایی و انزوای اجتماعی جلوگیری می‌کند."),
        ("گارانتی سمعک چقدر است؟", "سمعک‌های ارائه‌شده در کلینیک شکوه تجریش دارای گارانتی رسمی بین‌المللی ۱ تا ۴ ساله به‌همراه گارانتی تعویض و خدمات پس از فروش، تنظیم دوره‌ای و تعمیر در نمایندگی هستند."),
        ("آیا تست و مشاوره شنوایی رایگان است؟", "بله، تست و مشاوره اولیه شنوایی در کلینیک شکوه تجریش رایگان است. برای رزرو نوبت با شماره ۰۲۱-۲۲۷۳۵۵۸۸ تماس بگیرید یا از فرم تماس سایت استفاده کنید."),
        ("سمعک نامرئی چیست و برای چه کسانی مناسب است؟", "سمعک نامرئی (IIC/CIC) درون کانال گوش جا می‌گیرد و تقریباً دیده نمی‌شود؛ گزینه‌ای محبوب برای کسانی است که ظاهر را مهم می‌دانند و کم‌شنوایی خفیف تا متوسط دارند.")
    };
}