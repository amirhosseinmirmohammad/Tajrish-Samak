<script src="js/gp-home-legacy.js"></script>

@code {
    private List<Blog> blogs = new();
    private List<Blog> gpPopularBlogs = new();
    private List<Slider> slider = new();
    private List<Slider> gpDynamicSlides = new();
    private List<Product> gpPopularProducts = new();
    private List<Brand> gpBrands = new();
    private string firstSliderImage;
    private string firstSliderMobileImage;

    protected override async Task OnInitializedAsync()
    {
        await using var db = DbFactory.CreateDbContext();

        blogs = await Cache.GetOrCreateAsync("home:blogs", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await db.Blogs
                .AsNoTracking()
                .Include(b => b.Images)
                .Where(b => b.Images.Count > 0 && b.IsVisible == true)
                .OrderByDescending(b => b.CreateDate)
                .Take(4)
                .ToListAsync();
        }) ?? new List<Blog>();

        gpPopularBlogs = await Cache.GetOrCreateAsync("home:popular-blogs", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await db.Blogs
                .AsNoTracking()
                .Include(b => b.Images)
                .Where(b => b.Images.Count > 0 && b.IsVisible == true)
                .OrderByDescending(b => b.Survey)
                .ThenByDescending(b => b.CreateDate)
                .Take(4)
                .ToListAsync();
        }) ?? new List<Blog>();

        slider = await Cache.GetOrCreateAsync("home:sliders", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await db.Sliders
                .AsNoTracking()
                .OrderByDescending(s => s.LastDate)
                .ToListAsync();
        }) ?? new List<Slider>();

        gpDynamicSlides = slider
            .Where(s => !string.IsNullOrWhiteSpace(s.Image) || !string.IsNullOrWhiteSpace(s.MobImage))
            .ToList();

        var first = gpDynamicSlides.FirstOrDefault();
        firstSliderImage = first != null && !string.IsNullOrWhiteSpace(first.Image) ? first.Image : null;
        firstSliderMobileImage = first != null && !string.IsNullOrWhiteSpace(first.MobImage) ? first.MobImage : null;

        gpPopularProducts = await Cache.GetOrCreateAsync("home:popular-products", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await db.Products
                .AsNoTracking()
                .Include(p => p.Orders)
                .Where(p => p.SiteFirstImage != null)
                .OrderByDescending(p => p.Orders.Count())
                .Take(4)
                .ToListAsync();
        }) ?? new List<Product>();

        gpBrands = await Cache.GetOrCreateAsync("home:brands", async entry =>
        {
            entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(10);
            return await db.Brands
                .AsNoTracking()
                .Take(8)
                .ToListAsync();
        }) ?? new List<Brand>();
    }

    private static string Truncate(string text, int len)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var plain = System.Text.RegularExpressions.Regex.Replace(text, "<[^>]+>", " ").Trim();
        return plain.Length <= len ? plain : plain.Substring(0, len) + "…";
    }

    private static string GetPersianDate(DateTime? date)
    {
        if (!date.HasValue) return "";
        var cal = new PersianCalendar();
        var d = date.Value;
        return $"{cal.GetYear(d):0000}/{cal.GetMonth(d):00}/{cal.GetDayOfMonth(d):00}";
    }
}
