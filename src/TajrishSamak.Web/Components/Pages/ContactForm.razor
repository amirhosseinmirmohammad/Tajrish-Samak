@using TajrishSamak.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory

<div class="gp-contact-form">
    <EditForm Model="model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="gp-contact-field">
            <InputText @bind-Value="model.FullName" placeholder="نام و نام خانوادگی" />
        </div>
        <div class="gp-contact-field">
            <InputText @bind-Value="model.Email" placeholder="ایمیل" />
        </div>
        <div class="gp-contact-field">
            <InputTextArea @bind-Value="model.Body" placeholder="پیام شما" />
        </div>
        <ValidationMessage For="() => model.FullName" />
        <ValidationMessage For="() => model.Body" />
        <button type="submit" class="gp-contact-submit" disabled="@sending">
            @(sending ? "در حال ارسال..." : "ارسال پیام")
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <h6 class="newsletter"><i class="@(success ? "text-success" : "text-danger")">@message</i></h6>
    }
</div>

@code {
    private ContactModel model = new();
    private string message = "";
    private bool success;
    private bool sending;

    private class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "لطفا نام و نام خانوادگی را وارد نمایید")]
        public string FullName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "ایمیل معتبر نیست")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "لطفا متن پیام را وارد نمایید")]
        public string Body { get; set; } = "";
    }

    private async Task Submit()
    {
        sending = true;
        message = "";

        try
        {
            await using var db = DbFactory.CreateDbContext();

            db.SiteMessages.Add(new SiteMessage
            {
                FullName = model.FullName,
                Body = model.Body + (!string.IsNullOrWhiteSpace(model.Email) ? " | ایمیل: " + model.Email : ""),
                RegisterDate = DateTime.Now
            });

            await db.SaveChangesAsync();
            success = true;
            message = "پیام شما با موفقیت ثبت شد";
            model = new ContactModel();
        }
        catch (Exception)
        {
            success = false;
            message = "ارسال پیام با مشکل مواجه شد. لطفا مجدد تلاش فرمایید.";
        }
        finally
        {
            sending = false;
        }
    }
}
