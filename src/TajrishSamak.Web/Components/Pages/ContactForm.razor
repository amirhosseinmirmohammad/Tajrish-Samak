@using TajrishSamak.Web.Data.Entities
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@* Static-SSR contact form: plain HTML POST to /contact/message (no circuits, honeypot + rate limited) *@
<div class="gp-contact-form">
    @if (done)
    {
        <h6 class="newsletter"><i class="text-success">✓ پیام شما با موفقیت ثبت شد</i></h6>
    }
    else if (failed)
    {
        <h6 class="newsletter"><i class="text-danger">✕ ارسال پیام با مشکل مواجه شد. لطفا مجدد تلاش فرمایید.</i></h6>
    }
    <form method="post" action="/contact/message">
        <input type="hidden" name="__RequestVerificationToken" value="@token" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div class="gp-contact-field">
            <input type="text" name="fullName" placeholder="نام و نام خانوادگی *" required minlength="2" maxlength="100" />
        </div>
        <div class="gp-contact-field">
            <input type="email" name="email" placeholder="ایمیل" maxlength="150" />
        </div>
        <div class="gp-contact-field">
            <textarea name="body" placeholder="پیام شما *" rows="5" required minlength="5" maxlength="3000"></textarea>
        </div>
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;overflow:hidden" />
        <button type="submit" class="gp-contact-submit">ارسال پیام</button>
    </form>
</div>

@code {
    private string token = "";
    private string returnUrl = "/";
    private bool done;
    private bool failed;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx != null)
        {
            token = Antiforgery.GetAndStoreTokens(ctx).RequestToken;
            returnUrl = ctx.Request.Path.Value ?? "/";
            var msg = ctx.Request.Query["contact"].ToString();
            done = msg == "ok";
            failed = msg == "err";
        }
    }
}
