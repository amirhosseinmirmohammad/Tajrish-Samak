@page "/Blog/All"
@page "/Home/Blogs/{id:long}"
@using TajrishSamak.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory
@inject IMemoryCache Cache

<PageTitle>@(categoryName != null ? "مقالات " + categoryName : "مجله کلینیک شنوایی و سمعک") | کلینیک شنوایی و سمعک شکوه تجریش</PageTitle>
<meta name="description" content="مقالات تخصصی شنوایی، سمعک، وزوز گوش و مراقبت شنوایی در مجله کلینیک شنوایی و سمعک شکوه تجریش" />
<link rel="canonical" href="https://tajrish-samak.ir/Blog/All" />
<meta property="og:title" content="مجله کلینیک شنوایی و سمعک شکوه تجریش" />
<meta property="og:type" content="website" />
<link rel="stylesheet" href="/css/gp-page-Blog_All.css?v=11" />

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Blog",
  "@@id": "https://tajrish-samak.ir/Blog/All#blog",
  "name": "مجله کلینیک شنوایی و سمعک شکوه تجریش",
  "url": "https://tajrish-samak.ir/Blog/All",
  "inLanguage": "fa-IR",
  "publisher": { "@@id": "https://tajrish-samak.ir/#tajrish-samak" }
}
</script>

<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    { "@@type": "ListItem", "position": 1, "name": "صفحه اصلی", "item": "https://tajrish-samak.ir/" },
    { "@@type": "ListItem", "position": 2, "name": "مجله", "item": "https://tajrish-samak.ir/Blog/All" }
  ]
}
</script>

<section class="gp-blog-page">
    <div class="container">
        <section class="gp-blog-hero">
            <div class="gp-blog-hero-copy">
                <span class="gp-blog-kicker">مجله کلینیک</span>
                <h1>@(categoryName != null ? "مقالات " + categoryName : "مطالب تخصصی شنوایی و سمعک")</h1>
                <p>
                    راهنماهای ساده و کاربردی درباره تست شنوایی، انتخاب سمعک، مراقبت، وزوز گوش و تجربه شنیدن بهتر؛ نوشته‌شده توسط تیم تخصصی شکوه تجریش.
                </p>
                <div class="gp-blog-hero-actions">
                    <a href="/contactus">مشاوره رایگان</a>
                    <a href="/Service/All">خدمات کلینیک</a>
                </div>
            </div>
            <div class="gp-blog-hero-stats" aria-label="آمار مجله">
                <div class="gp-blog-stat"><b>@FaNum(TotalCount)</b><span>مقاله در این بخش</span></div>
                <div class="gp-blog-stat"><b>@FaNum(gpPopularBlogs.Count)</b><span>مقاله پربازدید</span></div>
            </div>
        </section>

        <div class="gp-blog-shell">
            <main>
                @if (gpBlogs.Count > 0)
                {
                    <div class="gp-blog-grid">
                        @foreach (var item in gpBlogs)
                        {
                            <article class="gp-blog-card" itemscope itemtype="https://schema.org/BlogPosting">
                                <a class="gp-blog-card-media" title="@item.Title" href="/blog/@item.Id/@item.SefUrl" itemprop="url">
                                    @if (item.Images != null && item.Images.Any())
                                    {
                                        <img src="@item.Images.First().FullPath" alt="@item.Title" loading="lazy" decoding="async" itemprop="image" />
                                    }
                                    @if (item.Category != null)
                                    {
                                        <span class="gp-blog-card-cat" itemprop="articleSection">@item.Category.PersianName</span>
                                    }
                                </a>
                                <div class="gp-blog-card-body">
                                    @if (item.CreateDate.HasValue)
                                    {
                                        <time class="gp-blog-card-date" datetime="@item.CreateDate.Value.ToString("yyyy-MM-dd")" itemprop="datePublished">📅 @GetPersianDate(item.CreateDate)</time>
                                    }
                                    <h2 itemprop="headline">
                                        <a title="@item.Title" href="/blog/@item.Id/@item.SefUrl">@item.Title</a>
                                    </h2>
                                    <p itemprop="description">@(Truncate(item.ShortDesc, 110))</p>
                                    <a class="gp-blog-read-more" href="/blog/@item.Id/@item.SefUrl" title="@item.Title">ادامه مطلب <span aria-hidden="true">←</span></a>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="gp-product-pagination text-center">
                        <nav aria-label="صفحه‌بندی مقالات">
                            <ul class="pagination pagination-sm">
                                @if (CurrentPage > 1)
                                {
                                    <li><a href="@BlogPath?page=@(CurrentPage - 1)">قبلی</a></li>
                                }
                                @if (CurrentPage * 4 < TotalCount)
                                {
                                    <li><a href="@BlogPath?page=@(CurrentPage + 1)">بعدی</a></li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
                else
                {
                    <div class="gp-empty-products">هنوز مطلبی در این بخش ثبت نشده است.</div>
                }
            </main>

            <aside class="gp-blog-side">
                <div class="gp-side-card">
                    <h3>پربازدیدترین مقالات</h3>
                    <div class="gp-side-posts">
                        @{ var sideIndex = 0; }
                        @foreach (var item in gpPopularBlogs)
                        {
                            sideIndex++;
                            <a class="gp-side-post" href="/blog/@item.Id/@item.SefUrl" title="@item.Title">
                                @if (item.Images != null && item.Images.Any())
                                {
                                    <img src="@item.Images.First().FullPath" alt="@item.Title" loading="lazy" decoding="async" />
                                }
                                <span class="gp-side-post-text">
                                    <i class="gp-side-rank">@FaNum(sideIndex)</i>
                                    <strong>@Truncate(item.Title, 48)</strong>
                                    <small>👁 @FaNum(item.Survey ?? 0) بازدید</small>
                                </span>
                            </a>
                        }
                    </div>
                    <a class="gp-side-all" href="/contactus">درخواست مشاوره ←</a>
                </div>
            </aside>
        </div>
    </div>
</section>

@code {
    [Parameter] public long? id { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int PageQuery { get; set; }

    private int CurrentPage => PageQuery < 1 ? 1 : PageQuery;

    private string BlogPath => id.HasValue ? "/Home/Blogs/" + id.Value : "/Blog/All";
    private string categoryName;
    private int TotalCount;
    private List<Blog> gpBlogs = new();
    private List<Blog> gpPopularBlogs = new();

    protected override async Task OnParametersSetAsync()
    {
        await using var db = DbFactory.CreateDbContext();

        if (id.HasValue)
        {
            categoryName = await db.Categories
                .AsNoTracking()
                .Where(c => c.Id == id.Value)
                .Select(c => c.PersianName)
                .FirstOrDefaultAsync();
        }

        var query = db.Blogs
            .AsNoTracking()
            .Include(b => b.Images)
            .Include(b => b.Category)
            .Where(b => b.Images.Any() && b.IsVisible == true);

        if (id.HasValue)
        {
            query = query.Where(b => b.CategoryId == id.Value);
        }

        if (!string.IsNullOrWhiteSpace(Query))
        {
            query = query.Where(b =>
                b.Title.Contains(Query) ||
                b.ShortDesc.Contains(Query) ||
                b.MetaDesc.Contains(Query));
        }

        TotalCount = await query.CountAsync();

        gpBlogs = await query
            .OrderByDescending(b => b.CreateDate)
            .Skip((CurrentPage - 1) * 4)
            .Take(4)
            .ToListAsync();

        gpPopularBlogs = await db.Blogs
            .AsNoTracking()
            .Include(b => b.Images)
            .Where(b => b.Images.Any() && b.IsVisible == true)
            .OrderByDescending(b => b.Survey)
            .Take(5)
            .ToListAsync();
    }

    private static string Truncate(string text, int len)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var plain = System.Text.RegularExpressions.Regex.Replace(text, "<[^>]+>", " ").Trim();
        return plain.Length <= len ? plain : plain.Substring(0, len) + "…";
    }

    private static string GetPersianDate(DateTime? date)
    {
        if (!date.HasValue) return "";
        var cal = new System.Globalization.PersianCalendar();
        var d = date.Value;
        return $"{cal.GetYear(d):0000}/{cal.GetMonth(d):00}/{cal.GetDayOfMonth(d):00}";
    }

    private static string FaNum(int value)
    {
        var map = new[] { '۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹' };
        return new string(value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture).Select(c => c >= '0' && c <= '9' ? map[c - '0'] : c).ToArray());
    }
}
