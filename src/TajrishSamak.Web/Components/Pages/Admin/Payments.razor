@page "/admin/payments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@layout TajrishSamak.Web.Components.Layout.AdminLayout
@using TajrishSamak.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inherits TajrishSamak.Web.Components.Shared.AdmListBase

<PageTitle>پرداخت‌ها | پنل مدیریت</PageTitle>
<link rel="stylesheet" href="/css/gp-admin.css?v=12" />

<form method="get" class="adm-search">
    <input type="hidden" name="sort" value="@Sort" />
    <input type="hidden" name="dir" value="@DirStr" />
    <input type="search" name="q" value="@Q" placeholder="جستجو: موضوع، توضیحات..." />
    <button type="submit" class="adm-btn adm-btn-purple">جستجو</button>
    @if (!string.IsNullOrEmpty(Q))
    {
        <a class="adm-btn adm-btn-danger" href="@UrlWith(("q", (string?)null), ("page", (string?)null))">✕ پاک‌کردن</a>
    }
</form>

<div class="adm-card adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>#</th>
                <AdmTh Key="Amount" Label="مبلغ" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <AdmTh Key="Subject" Label="موضوع" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <th>توضیحات</th>
                <AdmTh Key="CreateDate" Label="تاریخ ایجاد" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pay in Rows)
            {
                <tr>
                    <td>@FaNum(pay.Id)</td>
                    <td>@FaNum((long)pay.Amount)</td>
                    <td>@(string.IsNullOrWhiteSpace(pay.Subject) ? "—" : pay.Subject)</td>
                    <td>@(string.IsNullOrWhiteSpace(pay.Description) ? "—" : Truncate(pay.Description, 60))</td>
                    <td>@FaDate(pay.CreateDate)</td>
                    <td>
                        <form method="post" action="/admin/payment/block">
                            <input type="hidden" name="id" value="@pay.Id" />
                            <input type="hidden" name="__RequestVerificationToken" value="@token" />
                            <button type="submit" class="adm-btn @(pay.IsBlocked ? "adm-btn-green" : "adm-btn-danger")">
                                @(pay.IsBlocked ? "رفع مسدودی" : "مسدودسازی")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="6">پرداختی یافت نشد.</td></tr>
            }
        </tbody>
    </table>
</div>

<AdmPager Page="Page" PageSize="PageSize" Total="Filtered.Count()" PageUrl="@PageUrl" />

@code {
    private List<Payment> payments = new();
    private string token = "";

    protected override void OnInitialized()
    {
        if (Http.HttpContext != null)
        {
            token = Antiforgery.GetAndStoreTokens(Http.HttpContext).RequestToken;
        }
    }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "q")] public string? QP { get => Qs; set => Qs = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "page")] public int? PageQP { get => PageN; set => PageN = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "sort")] public string? SortQP { get => SortS; set => SortS = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "dir")] public string? DirQP { get => DirS; set => DirS = value; }

    private IEnumerable<Payment> Filtered
    {
        get
        {
            IEnumerable<Payment> q = payments;
            var term = (Q ?? "").Trim();
            if (term.Length > 0)
            {
                q = q.Where(p =>
                    (p.Subject ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (p.Description ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            q = (Sort, Asc) switch
            {
                ("Amount", true) => q.OrderBy(p => p.Amount),
                ("Amount", false) => q.OrderByDescending(p => p.Amount),
                ("Subject", true) => q.OrderBy(p => p.Subject),
                ("Subject", false) => q.OrderByDescending(p => p.Subject),
                ("CreateDate", true) => q.OrderBy(p => p.CreateDate),
                ("CreateDate", false) => q.OrderByDescending(p => p.CreateDate),
                _ => q
            };
            return q;
        }
    }

    private List<Payment> Rows => Filtered.Skip((Page - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnParametersSetAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        payments = await db.Payments.AsNoTracking().OrderByDescending(p => p.Id).ToListAsync();
    }

    private static string Truncate(string? text, int len)
    {
        if (string.IsNullOrWhiteSpace(text)) return "—";
        return text.Length <= len ? text : text.Substring(0, len) + "…";
    }

    private static string FaNum(long v)
    {
        var map = new[] { '۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹' };
        return new string(v.ToString("N0").Select(c => c >= '0' && c <= '9' ? map[c - '0'] : c).ToArray());
    }

    private static string FaDate(DateTime? d)
    {
        if (!d.HasValue) return "—";
        var cal = new System.Globalization.PersianCalendar();
        return $"{cal.GetYear(d.Value):0000}/{cal.GetMonth(d.Value):00}/{cal.GetDayOfMonth(d.Value):00}";
    }
}
