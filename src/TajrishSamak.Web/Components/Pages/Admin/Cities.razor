@page "/admin/cities"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@layout TajrishSamak.Web.Components.Layout.AdminLayout
@using TajrishSamak.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inherits TajrishSamak.Web.Components.Shared.AdmListBase

<PageTitle>شهرها | پنل مدیریت</PageTitle>
<link rel="stylesheet" href="/css/gp-admin.css?v=12" />

<form method="get" class="adm-search">
    <input type="hidden" name="sort" value="@Sort" />
    <input type="hidden" name="dir" value="@DirStr" />
    <input type="search" name="q" value="@Q" placeholder="جستجو: نام شهر..." />
    <button type="submit" class="adm-btn adm-btn-purple">جستجو</button>
    @if (!string.IsNullOrEmpty(Q))
    {
        <a class="adm-btn adm-btn-danger" href="@UrlWith(("q", (string?)null), ("page", (string?)null))">✕ پاک‌کردن</a>
    }
</form>

<div class="adm-toolbar-row">
    <a class="adm-btn adm-btn-purple" href="/admin/edit/city">＋ شهر جدید</a>
</div>

<div class="adm-card adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>#</th>
                <AdmTh Key="Name" Label="نام شهر" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Rows)
            {
                <tr>
                    <td>@FaNum(item.Id)</td>
                    <td>@item.Name</td>
                    <td>
                        <div style="display:flex;gap:5px;align-items:center">
                            <a class="adm-btn adm-btn-purple" href="/admin/edit/city/@item.Id">ویرایش</a>
                            <form method="post" action="/admin/delete">
                                <input type="hidden" name="entity" value="City" />
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="/admin/cities" />
                                <input type="hidden" name="__RequestVerificationToken" value="@token" />
                                <button type="submit" class="adm-btn adm-btn-danger">حذف</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="3">شهری یافت نشد.</td></tr>
            }
        </tbody>
    </table>
</div>

<AdmPager Page="Page" PageSize="PageSize" Total="Filtered.Count()" PageUrl="@PageUrl" />

@code {
    private List<City> items = new();
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "q")] public string? QP { get => Qs; set => Qs = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "page")] public int? PageQP { get => PageN; set => PageN = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "sort")] public string? SortQP { get => SortS; set => SortS = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "dir")] public string? DirQP { get => DirS; set => DirS = value; }
    private string token = "";

    private IEnumerable<City> Filtered
    {
        get
        {
            IEnumerable<City> q = items;
            var term = (Q ?? "").Trim();
            if (term.Length > 0)
            {
                q = q.Where(c => (c.Name ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            q = (Sort, Asc) switch
            {
                ("Name", true) => q.OrderBy(c => c.Name),
                ("Name", false) => q.OrderByDescending(c => c.Name),
                _ => q
            };
            return q;
        }
    }

    private List<City> Rows => Filtered.Skip((Page - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        if (Http.HttpContext != null)
        {
            token = Antiforgery.GetAndStoreTokens(Http.HttpContext).RequestToken;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        items = await db.Set<City>().AsNoTracking().OrderBy(c => c.Name).ToListAsync();
    }

    private static string FaNum(long v)
    {
        var map = new[] { '۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹' };
        return new string(v.ToString("N0").Select(c => c >= '0' && c <= '9' ? map[c - '0'] : c).ToArray());
    }
}
