@page "/admin/discounts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@layout TajrishSamak.Web.Components.Layout.AdminLayout
@using TajrishSamak.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inherits TajrishSamak.Web.Components.Shared.AdmListBase

<PageTitle>تخفیف‌ها | پنل مدیریت</PageTitle>
<link rel="stylesheet" href="/css/gp-admin.css?v=12" />

<form method="get" class="adm-search">
    <input type="hidden" name="sort" value="@Sort" />
    <input type="hidden" name="dir" value="@DirStr" />
    <input type="search" name="q" value="@Q" placeholder="جستجو: کد، عنوان..." />
    <button type="submit" class="adm-btn adm-btn-purple">جستجو</button>
    @if (!string.IsNullOrEmpty(Q))
    {
        <a class="adm-btn adm-btn-danger" href="@UrlWith(("q", (string?)null), ("page", (string?)null))">✕ پاک‌کردن</a>
    }
</form>

<div class="adm-toolbar-row">
    <a class="adm-btn adm-btn-purple" href="/admin/edit/discount">＋ کد تخفیف جدید</a>
</div>

<div class="adm-card adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>#</th>
                <AdmTh Key="Code" Label="کد" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <AdmTh Key="Title" Label="عنوان" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <AdmTh Key="Percent" Label="درصد/مبلغ" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <AdmTh Key="Count" Label="تعداد" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Rows)
            {
                <tr>
                    <td>@FaNum(item.Id)</td>
                    <td dir="ltr" style="text-align:right">@item.Code</td>
                    <td>@item.Title</td>
                    <td>@(item.Percent.HasValue ? "٪" + FaNum((long)item.Percent.Value) : FaDigitsStr(item.Amount))</td>
                    <td>@FaNum((long)item.Count)</td>
                    <td>
                        <div style="display:flex;gap:5px;align-items:center">
                            <a class="adm-btn adm-btn-purple" href="/admin/edit/discount/@item.Id">ویرایش</a>
                            <form method="post" action="/admin/delete">
                                <input type="hidden" name="entity" value="Discount" />
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="/admin/discounts" />
                                <input type="hidden" name="__RequestVerificationToken" value="@token" />
                                <button type="submit" class="adm-btn adm-btn-danger">حذف</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="6">موردی یافت نشد.</td></tr>
            }
        </tbody>
    </table>
</div>

<AdmPager Page="Page" PageSize="PageSize" Total="Filtered.Count()" PageUrl="@PageUrl" />

@code {
    private List<Discount> items = new();
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "q")] public string? QP { get => Qs; set => Qs = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "page")] public int? PageQP { get => PageN; set => PageN = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "sort")] public string? SortQP { get => SortS; set => SortS = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "dir")] public string? DirQP { get => DirS; set => DirS = value; }
    private string token = "";

    private IEnumerable<Discount> Filtered
    {
        get
        {
            IEnumerable<Discount> q = items;
            var term = (Q ?? "").Trim();
            if (term.Length > 0)
            {
                q = q.Where(d =>
                    (d.Code ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (d.Title ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            q = (Sort, Asc) switch
            {
                ("Code", true) => q.OrderBy(d => d.Code),
                ("Code", false) => q.OrderByDescending(d => d.Code),
                ("Title", true) => q.OrderBy(d => d.Title),
                ("Title", false) => q.OrderByDescending(d => d.Title),
                ("Percent", true) => q.OrderBy(d => d.Percent ?? 0),
                ("Percent", false) => q.OrderByDescending(d => d.Percent ?? 0),
                ("Count", true) => q.OrderBy(d => d.Count),
                ("Count", false) => q.OrderByDescending(d => d.Count),
                _ => q
            };
            return q;
        }
    }

    private List<Discount> Rows => Filtered.Skip((Page - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        if (Http.HttpContext != null)
        {
            token = Antiforgery.GetAndStoreTokens(Http.HttpContext).RequestToken;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        items = await db.Set<Discount>().AsNoTracking().OrderByDescending(d => d.Id).ToListAsync();
    }

    private static string FaDigitsStr(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "—";
        var map = new[] { '۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹' };
        return new string(s.Trim().Select(c => c >= '0' && c <= '9' ? map[c - '0'] : c).ToArray());
    }

    private static string FaNum(long v)
    {
        var map = new[] { '۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹' };
        return new string(v.ToString("N0").Select(c => c >= '0' && c <= '9' ? map[c - '0'] : c).ToArray());
    }
}
