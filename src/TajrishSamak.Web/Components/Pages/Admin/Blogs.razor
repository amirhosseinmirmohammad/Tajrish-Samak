@page "/admin/blogs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@layout TajrishSamak.Web.Components.Layout.AdminLayout
@using TajrishSamak.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inherits TajrishSamak.Web.Components.Shared.AdmListBase

<PageTitle>مقالات | پنل مدیریت</PageTitle>
<link rel="stylesheet" href="/css/gp-admin.css?v=12" />

<div class="adm-toolbar-row" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
    <form method="get" class="adm-search" style="margin-bottom:0">
        <input type="hidden" name="sort" value="@Sort" />
        <input type="hidden" name="dir" value="@DirStr" />
        <input type="search" name="q" value="@Q" placeholder="جستجو: عنوان، دسته..." />
        <button type="submit" class="adm-btn adm-btn-purple">جستجو</button>
    </form>
    <a class="adm-btn adm-btn-purple" href="/admin/blogs/edit">＋ مقاله جدید</a>
</div>

<div class="adm-card adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>#</th>
                <AdmTh Key="Title" Label="عنوان" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <AdmTh Key="Category" Label="دسته" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <AdmTh Key="CreateDate" Label="تاریخ" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <AdmTh Key="Survey" Label="بازدید" ActiveKey="@Sort" Asc="@Asc" SortUrl="@SortUrl" />
                <th>نمایش</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Rows)
            {
                <tr>
                    <td>@FaNum(b.Id)</td>
                    <td><a href="/blog/@b.Id/@b.SefUrl" target="_blank" style="color:#6d0592;font-weight:900;text-decoration:none">@Truncate(b.Title, 50)</a></td>
                    <td>@(b.Category?.PersianName ?? "—")</td>
                    <td>@FaDate(b.CreateDate)</td>
                    <td>@FaNum(b.Survey ?? 0)</td>
                    <td>
                        <form method="post" action="/admin/toggle" style="display:inline">
                            <input type="hidden" name="entity" value="blog" />
                            <input type="hidden" name="id" value="@b.Id" />
                            <input type="hidden" name="returnUrl" value="/admin/blogs" />
                            <input type="hidden" name="__RequestVerificationToken" value="@token" />
                            <button type="submit" class="adm-btn @(b.IsVisible == true ? "adm-btn-green" : "adm-btn-danger")">
                                @(b.IsVisible == true ? "نمایان" : "مخفی")
                            </button>
                        </form>
                    </td>
                    <td>
                        <div style="display:flex;gap:6px">
                            <a class="adm-btn adm-btn-purple" href="/admin/blogs/edit/@b.Id">ویرایش</a>
                            <form method="post" action="/admin/delete" style="display:inline">
                                <input type="hidden" name="entity" value="blog" />
                                <input type="hidden" name="id" value="@b.Id" />
                                <input type="hidden" name="returnUrl" value="/admin/blogs" />
                                <input type="hidden" name="__RequestVerificationToken" value="@token" />
                                <button type="submit" class="adm-btn adm-btn-danger">حذف</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="7">مقاله‌ای یافت نشد.</td></tr>
            }
        </tbody>
    </table>
</div>

<AdmPager Page="Page" PageSize="PageSize" Total="Filtered.Count()" PageUrl="@PageUrl" />

@code {
    private List<Blog> blogs = new();
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "q")] public string? QP { get => Qs; set => Qs = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "page")] public int? PageQP { get => PageN; set => PageN = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "sort")] public string? SortQP { get => SortS; set => SortS = value; }
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "dir")] public string? DirQP { get => DirS; set => DirS = value; }
    private string token = "";

    private IEnumerable<Blog> Filtered
    {
        get
        {
            IEnumerable<Blog> q = blogs;
            var term = (Q ?? "").Trim();
            if (term.Length > 0)
            {
                q = q.Where(b =>
                    (b.Title ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (b.Category?.PersianName ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            q = (Sort, Asc) switch
            {
                ("Title", true) => q.OrderBy(b => b.Title),
                ("Title", false) => q.OrderByDescending(b => b.Title),
                ("Category", true) => q.OrderBy(b => b.Category?.PersianName),
                ("Category", false) => q.OrderByDescending(b => b.Category?.PersianName),
                ("CreateDate", true) => q.OrderBy(b => b.CreateDate ?? DateTime.MinValue),
                ("CreateDate", false) => q.OrderByDescending(b => b.CreateDate ?? DateTime.MinValue),
                ("Survey", true) => q.OrderBy(b => b.Survey ?? 0),
                ("Survey", false) => q.OrderByDescending(b => b.Survey ?? 0),
                _ => q
            };
            return q;
        }
    }

    private List<Blog> Rows => Filtered.Skip((Page - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        if (Http.HttpContext != null)
        {
            token = Antiforgery.GetAndStoreTokens(Http.HttpContext).RequestToken;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        blogs = await db.Blogs
            .AsNoTracking()
            .Include(b => b.Category)
            .OrderByDescending(b => b.Id)
            .ToListAsync();
    }

    private static string Truncate(string? text, int len)
    {
        if (string.IsNullOrWhiteSpace(text)) return "—";
        return text.Length <= len ? text : text.Substring(0, len) + "…";
    }

    private static string FaDate(DateTime? d)
    {
        if (!d.HasValue) return "—";
        var cal = new System.Globalization.PersianCalendar();
        return $"{cal.GetYear(d.Value):0000}/{cal.GetMonth(d.Value):00}/{cal.GetDayOfMonth(d.Value):00}";
    }

    private static string FaNum(long v)
    {
        var map = new[] { '۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹' };
        return new string(v.ToString("N0").Select(c => c >= '0' && c <= '9' ? map[c - '0'] : c).ToArray());
    }
}
