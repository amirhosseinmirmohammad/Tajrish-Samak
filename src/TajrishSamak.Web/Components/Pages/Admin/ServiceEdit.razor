@page "/admin/services/edit/{id:int?}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@layout TajrishSamak.Web.Components.Layout.AdminLayout
@using TajrishSamak.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TajrishSamak.Web.Data.TajrishSamakDbContext> DbFactory
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "خدمت جدید" : "ویرایش خدمت") | پنل مدیریت</PageTitle>
<link rel="stylesheet" href="/css/gp-admin.css?v=12" />

<div class="adm-editor">
    <h2>@(IsNew ? "⚙ خدمت جدید" : "✏ ویرایش خدمت")</h2>

    <form method="post" action="/admin/save/service" class="adm-form">
        <input type="hidden" name="id" value="@(id ?? 0)" />
        <input type="hidden" name="__RequestVerificationToken" value="@token" />

        <label>عنوان خدمت *</label>
        <input type="text" name="title" value="@Title" required maxlength="300" />

        <div class="adm-form-grid">
            <div>
                <label>دسته</label>
                <select name="categoryId" class="gp-searchable">
                    <option value="">— بدون دسته —</option>
                    @foreach (var c in serviceCategories)
                    {
                        <option value="@c.Id" selected="@(CategoryId == c.Id)">@c.PersianName</option>
                    }
                </select>
            </div>
            <div>
                <label>اسلاگ (SefUrl) — خالی = خودکار</label>
                <input type="text" name="sefUrl" value="@SefUrl" dir="ltr" />
            </div>
        </div>

        <label>خلاصه (ShortDesc)</label>
        <textarea name="shortDesc" rows="2">@ShortDesc</textarea>

        <label>متن خدمت (Body) — HTML</label>
        <textarea name="body" rows="12" class="mono">@Body</textarea>

        <div class="adm-form-grid">
            <div>
                <label>متا دیسکریپشن</label>
                <textarea name="metaDesc" rows="2">@MetaDesc</textarea>
            </div>
            <div>
                <label>متا کیوردز (Enter یا , = افزودن)</label>
                <div class="gp-tags-editor" data-name="metaKey" data-values="@MetaKey"></div>
            </div>
        </div>

        <label class="adm-checkbox">
            <input type="checkbox" name="isVisible" value="true" checked="@(IsVisible)" />
            نمایش داده شود
        </label>

        <div class="adm-editor-actions">
            <button type="submit" class="adm-btn adm-btn-purple">💾 ذخیره</button>
            <a href="/admin/services" class="adm-btn adm-btn-ghost">انصراف</a>
        </div>
    </form>
</div>

@code {
    [Parameter] public int? id { get; set; }

    private Service service;
    private bool IsNew => id == null || id == 0;
    private string token = "";
    private string Title = "", SefUrl = "", ShortDesc = "", Body = "", MetaKey = "", MetaDesc = "";
    private int? CategoryId;
    private bool IsVisible = true;
    private List<ServiceCategory> serviceCategories = new();

    protected override void OnInitialized()
    {
        if (Http.HttpContext != null)
        {
            token = Antiforgery.GetAndStoreTokens(Http.HttpContext).RequestToken;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        serviceCategories = await db.ServiceCategories.AsNoTracking().OrderBy(c => c.PersianName).ToListAsync();

        if (!IsNew && service == null)
        {
            service = await db.Services.AsNoTracking().Include(s => s.Category).FirstOrDefaultAsync(s => s.Id == id);
            if (service == null) { Nav.NavigateTo("/admin/services"); return; }
            Title = service.Title; SefUrl = service.SefUrl ?? ""; ShortDesc = service.ShortDesc ?? "";
            Body = service.Body ?? ""; MetaKey = service.MetaKey ?? ""; MetaDesc = service.MetaDesc ?? "";
            CategoryId = service.CategoryId; IsVisible = service.IsVisible;
        }
    }
}
