            try {
                var savedLang = localStorage.getItem("gpTajrishLang") || "fa";
                var root = document.documentElement;
                root.setAttribute("lang", savedLang === "en" ? "en" : "fa");
                root.setAttribute("dir", savedLang === "en" ? "ltr" : "rtl");
                root.classList.toggle("gp-lang-en", savedLang === "en");
                root.classList.toggle("gp-lang-fa", savedLang !== "en");
            } catch (e) { }
        })();
    </script>

