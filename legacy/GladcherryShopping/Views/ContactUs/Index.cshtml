    <style id="gp-v37-contact-modern-seo">
        :root {
            --gp-v37-purple: #4b1684;
            --gp-v37-violet: #920ab6;
            --gp-v37-pink: #e10b79;
            --gp-v37-cyan: #0ba6b8;
            --gp-v37-lime: #d8f512;
            --gp-v37-ink: #20142d;
            --gp-v37-muted: rgba(32,20,45,.68);
            --gp-v37-card: rgba(255,255,255,.92);
            --gp-v37-border: rgba(75,22,132,.10);
            --gp-v37-shadow: 0 24px 60px rgba(74,18,107,.10);
        }

        .gp-contact-page {
            direction: rtl;
            overflow: hidden;
        }

        .gp-contact-hero {
            position: relative;
            margin: 22px auto 28px;
            padding: clamp(28px, 4vw, 58px);
            border-radius: 42px;
            background: radial-gradient(circle at 14% 10%, rgba(216,245,18,.25), transparent 24%), radial-gradient(circle at 88% 24%, rgba(255,255,255,.15), transparent 22%), linear-gradient(135deg, #4b1684 0%, #920ab6 54%, #e10b79 100%);
            color: #fff;
            box-shadow: 0 32px 80px rgba(74,18,107,.20);
            isolation: isolate;
            overflow: hidden;
        }

            .gp-contact-hero::before,
            .gp-contact-hero::after {
                content: "";
                position: absolute;
                border-radius: 999px;
                pointer-events: none;
                z-index: -1;
            }

            .gp-contact-hero::before {
                width: 270px;
                height: 270px;
                left: -96px;
                top: -92px;
                background: rgba(255,255,255,.13);
                animation: gpV37Blob 10s ease-in-out infinite alternate;
            }

            .gp-contact-hero::after {
                width: 340px;
                height: 340px;
                right: -130px;
                bottom: -172px;
                background: rgba(11,166,184,.22);
                animation: gpV37Blob 12s ease-in-out infinite alternate-reverse;
            }

        @@keyframes gpV37Blob {
            to {
                transform: translate3d(24px, 18px, 0) scale(1.06);
            }
        }

        .gp-contact-hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(260px, .42fr);
            gap: clamp(20px, 4vw, 46px);
            align-items: center;
        }

        .gp-contact-kicker {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            color: #fff !important;
            font-weight: 950;
            backdrop-filter: blur(14px);
        }

        .gp-contact-hero h1 {
            margin: 16px 0 12px;
            color: #fff !important;
            font-size: clamp(32px, 5vw, 66px);
            font-weight: 1000;
            line-height: 1.34 !important;
            letter-spacing: -.02em;
        }

        .gp-contact-hero p {
            max-width: 780px;
            margin: 0;
            color: rgba(255,255,255,.90) !important;
            font-size: clamp(14px, 1.2vw, 18px);
            font-weight: 850;
            line-height: 2.1;
        }

        .gp-contact-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 24px;
        }

            .gp-contact-actions a {
                min-height: 48px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 0 18px;
                border-radius: 999px;
                text-decoration: none !important;
                font-weight: 950;
            }

                .gp-contact-actions a:first-child {
                    background: #fff;
                    color: #4b1684 !important;
                    box-shadow: 0 18px 38px rgba(0,0,0,.14);
                }

                .gp-contact-actions a:nth-child(2),
                .gp-contact-actions a:nth-child(3) {
                    background: rgba(255,255,255,.13);
                    border: 1px solid rgba(255,255,255,.24);
                    color: #fff !important;
                }

        .gp-contact-quick-cards {
            display: grid;
            gap: 12px;
        }

        .gp-contact-quick-card {
            min-height: 92px;
            padding: 18px;
            border-radius: 28px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.20);
            backdrop-filter: blur(14px);
        }

            .gp-contact-quick-card strong {
                display: block;
                color: #fff !important;
                font-size: 18px;
                font-weight: 1000;
                line-height: 1.7;
            }

            .gp-contact-quick-card span,
            .gp-contact-quick-card a {
                display: block;
                margin-top: 5px;
                color: rgba(255,255,255,.84) !important;
                font-weight: 850;
                text-decoration: none !important;
                direction: ltr;
                unicode-bidi: isolate;
            }

        .gp-contact-shell {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(300px, 410px);
            gap: 22px;
            align-items: stretch;
            margin-bottom: 28px;
        }

        .gp-contact-form-card,
        .gp-contact-info-card,
        .gp-contact-map-card,
        .gp-contact-social-card {
            border-radius: 34px;
            background: var(--gp-v37-card);
            border: 1px solid var(--gp-v37-border);
            box-shadow: var(--gp-v37-shadow);
            backdrop-filter: blur(18px);
        }

        .gp-contact-form-card {
            padding: clamp(20px, 3vw, 34px);
        }

        .gp-contact-form-head {
            margin-bottom: 18px;
        }

            .gp-contact-form-head span {
                display: inline-flex;
                min-height: 36px;
                align-items: center;
                justify-content: center;
                padding: 0 13px;
                border-radius: 999px;
                background: rgba(146,10,182,.08);
                color: #6420a0 !important;
                font-size: 13px;
                font-weight: 950;
            }

            .gp-contact-form-head h2 {
                margin: 12px 0 8px;
                color: var(--gp-v37-ink) !important;
                font-size: clamp(24px, 3.2vw, 42px);
                font-weight: 1000;
                line-height: 1.45 !important;
            }

            .gp-contact-form-head p {
                margin: 0;
                color: var(--gp-v37-muted) !important;
                font-weight: 850;
                line-height: 2;
            }

        .gp-contact-form {
            display: grid;
            gap: 12px;
        }

        .gp-contact-field {
            position: relative;
        }

            .gp-contact-field input,
            .gp-contact-field textarea {
                width: 100%;
                border: 1px solid rgba(75,22,132,.12) !important;
                border-radius: 20px !important;
                background: rgba(255,255,255,.82) !important;
                color: var(--gp-v37-ink) !important;
                font-size: 14px !important;
                font-weight: 850 !important;
                outline: 0 !important;
                box-shadow: inset 0 1px 0 rgba(255,255,255,.70) !important;
                transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
            }

            .gp-contact-field input {
                height: 54px;
                padding: 0 16px !important;
            }

            .gp-contact-field textarea {
                min-height: 160px;
                padding: 16px !important;
                resize: vertical;
                line-height: 2;
            }

                .gp-contact-field input:focus,
                .gp-contact-field textarea:focus {
                    border-color: rgba(146,10,182,.35) !important;
                    box-shadow: 0 14px 34px rgba(146,10,182,.10) !important;
                    transform: translateY(-1px);
                }

        .gp-contact-submit {
            min-height: 54px;
            border: 0;
            border-radius: 20px;
            background: radial-gradient(circle at 15% 20%, rgba(216,245,18,.24), transparent 26%), linear-gradient(135deg, var(--gp-v37-purple), var(--gp-v37-violet), var(--gp-v37-pink));
            color: #fff !important;
            font-weight: 1000;
            box-shadow: 0 18px 42px rgba(146,10,182,.20);
            transition: transform .18s ease, box-shadow .18s ease;
        }

            .gp-contact-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 26px 58px rgba(146,10,182,.28);
            }

        .gp-contact-side {
            display: grid;
            gap: 16px;
        }

        .gp-contact-info-card,
        .gp-contact-social-card {
            padding: 18px;
        }

            .gp-contact-info-card h2,
            .gp-contact-social-card h2 {
                margin: 0 0 14px;
                color: var(--gp-v37-ink) !important;
                font-size: 20px;
                font-weight: 1000;
                line-height: 1.7 !important;
            }

        .gp-contact-list {
            display: grid;
            gap: 10px;
        }

        .gp-contact-item {
            display: grid;
            grid-template-columns: 42px minmax(0, 1fr);
            gap: 10px;
            align-items: center;
            padding: 11px;
            border-radius: 22px;
            background: rgba(255,255,255,.64);
            border: 1px solid rgba(75,22,132,.08);
            text-decoration: none !important;
            transition: transform .18s ease, background .18s ease;
        }

            .gp-contact-item:hover {
                transform: translateY(-2px);
                background: #fff;
            }

        .gp-contact-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--gp-v37-purple), var(--gp-v37-violet));
            color: #fff !important;
            font-size: 18px;
            font-style: normal;
        }

        .gp-contact-item strong {
            display: block;
            color: var(--gp-v37-ink) !important;
            font-size: 13px;
            font-weight: 1000;
            line-height: 1.8;
        }

        .gp-contact-item span {
            display: block;
            margin-top: 2px;
            color: var(--gp-v37-muted) !important;
            font-size: 13px;
            font-weight: 850;
            line-height: 1.8;
        }

        .gp-contact-item.gp-ltr span {
            direction: ltr;
            text-align: right;
            unicode-bidi: isolate;
        }

        .gp-direction-buttons {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 9px;
            margin-top: 12px;
        }

            .gp-direction-buttons a {
                min-height: 48px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                border-radius: 18px;
                text-decoration: none !important;
                font-weight: 1000;
            }

                .gp-direction-buttons a:first-child {
                    background: #fff;
                    color: var(--gp-v37-purple) !important;
                    border: 1px solid rgba(75,22,132,.12);
                }

                .gp-direction-buttons a:nth-child(2) {
                    background: linear-gradient(135deg, var(--gp-v37-cyan), var(--gp-v37-violet));
                    color: #fff !important;
                }

        .gp-contact-socials {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
        }

            .gp-contact-socials a {
                min-height: 46px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 17px;
                text-decoration: none !important;
                color: #fff !important;
                font-weight: 1000;
                font-size: 17px;
                transition: transform .18s ease;
            }

                .gp-contact-socials a:hover {
                    transform: translateY(-2px);
                }

                .gp-contact-socials a:nth-child(1) {
                    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
                }

                .gp-contact-socials a:nth-child(2) {
                    background: #229ED9;
                }

                .gp-contact-socials a:nth-child(3) {
                    background: #25D366;
                }

                .gp-contact-socials a:nth-child(4) {
                    background: #4b1684;
                }

        .gp-contact-map-card {
            padding: 14px;
            margin-bottom: 42px;
            overflow: hidden;
        }

        .gp-map-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            padding: 8px 8px 14px;
        }

            .gp-map-head h2 {
                margin: 0;
                color: var(--gp-v37-ink) !important;
                font-size: 22px;
                font-weight: 1000;
                line-height: 1.6 !important;
            }

            .gp-map-head p {
                margin: 0;
                color: var(--gp-v37-muted) !important;
                font-size: 13px;
                font-weight: 850;
                line-height: 1.9;
            }

        #map {
            width: 100%;
            height: 430px;
            border-radius: 28px;
            overflow: hidden;
            border: 1px solid rgba(75,22,132,.10);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.60);
            z-index: 1;
        }

        .leaflet-popup-content-wrapper {
            border-radius: 20px !important;
            direction: rtl;
            text-align: center;
            font-family: inherit;
        }

        .leaflet-popup-content {
            margin: 14px !important;
            min-width: 190px;
        }

        .gp-map-popup img {
            width: 110px;
            height: auto;
            margin-bottom: 8px;
        }

        .gp-map-popup strong {
            display: block;
            color: #4b1684;
            font-weight: 1000;
            margin-bottom: 6px;
        }

        .gp-map-popup span {
            display: block;
            color: #5f5268;
            font-weight: 800;
            line-height: 1.8;
        }

        html.gp-dark-mode .gp-contact-page {
            --gp-v37-ink: #f7f7fb;
            --gp-v37-muted: rgba(246,247,251,.72);
            --gp-v37-card: rgba(24,24,40,.88);
            --gp-v37-border: rgba(255,255,255,.10);
            --gp-v37-shadow: 0 24px 60px rgba(0,0,0,.20);
        }

        html.gp-dark-mode .gp-contact-form-card,
        html.gp-dark-mode .gp-contact-info-card,
        html.gp-dark-mode .gp-contact-map-card,
        html.gp-dark-mode .gp-contact-social-card {
            background: rgba(24,24,40,.90) !important;
            border-color: rgba(255,255,255,.10) !important;
        }

        html.gp-dark-mode .gp-contact-form-head span {
            background: rgba(255,255,255,.09) !important;
            color: rgba(246,247,251,.88) !important;
        }

        html.gp-dark-mode .gp-contact-field input,
        html.gp-dark-mode .gp-contact-field textarea,
        html.gp-dark-mode .gp-contact-item {
            background: rgba(255,255,255,.07) !important;
            border-color: rgba(255,255,255,.10) !important;
            color: #fff !important;
        }

            html.gp-dark-mode .gp-contact-field input::placeholder,
            html.gp-dark-mode .gp-contact-field textarea::placeholder {
                color: rgba(255,255,255,.52) !important;
            }

            html.gp-dark-mode .gp-contact-item:hover {
                background: rgba(255,255,255,.10) !important;
            }

        html.gp-dark-mode .gp-direction-buttons a:first-child {
            background: rgba(255,255,255,.08) !important;
            color: #fff !important;
            border-color: rgba(255,255,255,.12);
        }

        html.gp-dark-mode .leaflet-tile {
            filter: brightness(.72) contrast(1.08) saturate(.75);
        }

        @@media(max-width: 1100px) {
            .gp-contact-hero-grid,
            .gp-contact-shell {
                grid-template-columns: 1fr;
            }

            .gp-contact-quick-cards {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media(max-width: 768px) {
            .gp-contact-hero {
                border-radius: 30px;
                padding: 26px 20px;
                text-align: center;
            }

            .gp-contact-actions {
                justify-content: center;
            }

            .gp-contact-quick-cards,
            .gp-direction-buttons,
            .gp-contact-socials {
                grid-template-columns: 1fr;
            }

            .gp-contact-form-card,
            .gp-contact-info-card,
            .gp-contact-map-card,
            .gp-contact-social-card {
                border-radius: 28px;
            }

            .gp-map-head {
                text-align: center;
                justify-content: center;
            }

            #map {
                height: 330px;
                border-radius: 24px;
            }
        }
    </style>
}

<section class="gp-contact-page" aria-label="تماس با کلینیک شنوایی و سمعک شکوه تجریش">
    <div class="container">
        <section class="gp-contact-hero" aria-label="معرفی راه‌های ارتباطی">
